---
import ThemeToggle from "./ThemeToggle.astro";
interface Props { current?: string; }
const { current = "/" } = Astro.props;
const links = [
  { href: "/#work", label: "Work" },
  { href: "/blog", label: "Writing" },
  { href: "/tools", label: "Tools" },
  { href: "/about", label: "About" },
  { href: "/#contact", label: "Contact" },
];
---
<header class="public-header">
  <div class="public-container public-header-inner">
    <a href="/" class="public-wordmark" aria-label="xhverse home">xhverse<span aria-hidden="true">.</span></a>
    <nav class="public-desktop-nav" aria-label="Primary navigation">
      {links.map((link) => <a href={link.href} aria-current={current === link.href ? "page" : undefined}>{link.label}</a>)}
    </nav>
    <div class="public-header-controls">
      <ThemeToggle />
      <details class="public-mobile-menu" id="public-menu">
        <summary>Menu <span aria-hidden="true">+</span></summary>
        <nav aria-label="Mobile navigation">
          {links.map((link) => <a href={link.href} aria-current={current === link.href ? "page" : undefined}>{link.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
  import { createUiMotion } from "../lib/ui-motion";
  function initPublicNavigation() {
    const menu = document.querySelector<HTMLDetailsElement>("#public-menu");
    if (!menu || menu.dataset.bound) return;
    menu.dataset.bound = "true";
    if (document.documentElement.hasAttribute("data-ui-motion")) {
      const motion = createUiMotion(true, window.matchMedia("(prefers-reduced-motion: reduce)"));
      const summary = menu.querySelector("summary");
      const nav = menu.querySelector("nav");
      summary?.addEventListener("click", (event) => {
        if (!nav) return;
        motion.cancel(nav);
        // Native summary activation will open the disclosure after this listener.
        if (!menu.open) motion.animate(nav, [
          { opacity: 0, transform: "translateY(-4px) scale(0.97)" },
          { opacity: 1, transform: "translateY(0) scale(1)" },
        ], 200, motion.eligible(event));
      });
      menu.addEventListener("toggle", () => { if (!menu.open && nav) motion.cancel(nav); });
      document.addEventListener("astro:before-swap", () => motion.dispose(), { once: true });
    }
    menu.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      link.addEventListener("click", () => { menu.open = false; });
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  }
  initPublicNavigation();
  document.addEventListener("astro:page-load", initPublicNavigation);
</script>
