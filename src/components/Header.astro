---
type NavLink = { href: string; label: string };

interface Props {
  current?: string;
  links?: NavLink[];
}

const defaultLinks: NavLink[] = [
  { href: "/", label: "Profile" },
  { href: "/about", label: "About" },
  { href: "/blog", label: "Writing" },
  { href: "/cv", label: "CV" },
  { href: "/gallery", label: "Gallery" },
  { href: "#contact", label: "Contact" },
];

const { current, links = defaultLinks } = Astro.props;
---

<header class="border-b border-white/10">
  <div class="mx-auto flex max-w-7xl items-start justify-between gap-5 px-5 pb-5 pt-6 sm:items-center sm:px-8 lg:px-10">
    <a href="/" class="group">
      <p class="text-[11px] uppercase tracking-[0.35em] text-zinc-500">xhverse.co</p>
      <span class="mt-1 block text-[1.35rem] font-semibold tracking-tight text-white sm:text-[1.55rem]">
        XHVERSE
      </span>
    </a>
    <nav class="hidden items-center gap-6 text-sm text-zinc-400 md:flex" aria-label="Primary navigation">
      {links.map((link) => (
        <a
          href={link.href}
          class={`transition hover:text-white ${current === link.href ? "text-white" : ""}`}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <a
      href="#contact"
      class="border border-white/15 px-3 py-1.5 text-xs uppercase tracking-[0.18em] text-zinc-300 transition hover:border-emerald-300/70 hover:text-white md:hidden"
    >
      Contact
    </a>
  </div>
</header>
