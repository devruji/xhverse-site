---
import type { PublicationSnapshot } from "../data/publication";
import "../styles/publication-home.css";
interface Props { snapshot: PublicationSnapshot; review?: boolean; }
const { snapshot: s, review = false } = Astro.props;
const [featuredArticle, ...moreArticles] = s.articles;
const discoveryTools = s.discoveryTools.filter((tool) => !s.tools.some((example) => example.slug === tool.slug));
const dateLabel = (date: string) => new Date(date).toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" });
---
<main id="main-content" class="publication-home">
  <section id="profile" class="identity" aria-labelledby="identity-heading">
    <div class="identity-copy">
      <p class="eyebrow">{s.alias} <span aria-hidden="true">/</span> Data platforms</p>
      <h1 id="identity-heading">{s.name}</h1>
      <p class="professional-title">{s.title}</p>
    </div>
    <div class="identity-band">
      <figure class="portrait"><img src={s.portrait} alt="Rujikorn Ngoensaard" width="512" height="512" loading="eager" fetchpriority="high" decoding="async" /><figcaption>{s.alias}</figcaption></figure>
      <div class="introduction">
        <p class="intro-text">{s.intro}</p>
        <div class="identity-actions"><a class="button-primary cta-primary" href="#experience">View experience <span aria-hidden="true">↘</span></a><a class="button-secondary cta-secondary" href="#tools">Explore tools <span aria-hidden="true">↘</span></a></div>
        <a class="text-link about-link" href="/about">More about me <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <div class="professional-record">
    <section id="experience" class="experience section" aria-labelledby="experience-heading">
      <div class="section-heading"><h2 id="experience-heading">Experience</h2></div>
      <div class="experience-record"><div class="experience-topline"><h3>{s.experience.company}</h3><p class="period">{s.experience.period}</p></div><p class="experience-role">{s.experience.role}</p><p class="experience-description">{s.experience.description}</p><ul class="platforms" aria-label="Platforms and technologies">{s.experience.platforms.map((platform) => <li>{platform}</li>)}</ul><a class="text-link" href="/cv">View my CV <span aria-hidden="true">↗</span></a></div>
    </section>
    <section id="tools" class="tools section" aria-labelledby="tools-heading">
      {!review && <><span id="work" class="publication-alias" aria-hidden="true"></span><span id="work-architecture" class="publication-alias" aria-hidden="true"></span><span id="work-governance" class="publication-alias" aria-hidden="true"></span></>}
      <div class="section-heading"><div><p class="eyebrow">Public tools</p><h2 id="tools-heading">Tools I’ve built.</h2></div><a class="text-link" href="/tools">All tools <span aria-hidden="true">↗</span></a></div>
      <div class="tool-list">{s.tools.map((tool, index) => <article class="tool-entry" id={!review ? index === 0 ? "work-modeling" : "work-operations" : undefined}>
        <div class="tool-copy"><p class="tool-category">{index === 0 ? "Dimension modeling" : "Pipeline operations"}</p><h3><a href={`/tools/${tool.slug}`}>{tool.title} <span aria-hidden="true">↗</span></a></h3><p>{tool.purpose}</p><a class="text-link" href={`/tools/${tool.slug}`}>Open tool <span aria-hidden="true">↗</span></a></div>
        <div class="tool-example"><p class="example-label">{tool.example.label}</p><ul>{tool.example.lines.map((line, lineIndex) => <li class:list={{ "example-result": index === 0 ? lineIndex === 1 || lineIndex === 2 : lineIndex === 0 }}>{(index === 0 ? lineIndex === 1 || lineIndex === 2 : lineIndex === 0) ? <strong>{line}</strong> : line}</li>)}</ul></div>
      </article>)}</div>
      <div class="additional-tools"><p>Explore more tools</p><ul id={review ? "review-tool-discovery" : "tool-discovery"} data-tool-discovery data-discovery-key={review ? "xhverse:review:tool-discovery" : "xhverse:tool-discovery"} data-discovery-tools={JSON.stringify(discoveryTools.map(({ slug, title }) => ({ slug, title })))}>{discoveryTools.slice(0, 2).map((tool) => <li><a href={`/tools/${tool.slug}`}>{tool.title} <span aria-hidden="true">↗</span></a></li>)}</ul></div>
    </section>
    <section id="writing" class="writing section" aria-labelledby="writing-heading">
      {!review && <span id="proof" class="publication-alias" aria-hidden="true"></span>}
      <div class="section-heading"><h2 id="writing-heading">Writing</h2><a class="text-link" href="/blog">All writing <span aria-hidden="true">↗</span></a></div>
      {featuredArticle ? <div class="writing-grid"><article class="featured-article">
        {featuredArticle.coverImageUrl && <a class="article-cover" href={`/blog/${featuredArticle.slug}`} tabindex="-1" aria-hidden="true"><img src={featuredArticle.coverImageUrl} alt="" width="1200" height="675" loading="lazy" decoding="async" /></a>}
        <div class="article-copy"><p class="article-meta"><time datetime={featuredArticle.date}>{dateLabel(featuredArticle.date)}</time><span>{featuredArticle.readingTime}</span></p><h3><a href={`/blog/${featuredArticle.slug}`} aria-label={`Read article: ${featuredArticle.title}`}>{featuredArticle.title} <span aria-hidden="true">↗</span></a></h3><p>{featuredArticle.excerpt}</p><a class="text-link" href={`/blog/${featuredArticle.slug}`}>Read article <span aria-hidden="true">↗</span></a></div>
      </article>{moreArticles.length > 0 && <div class="more-writing">{moreArticles.slice(0, 2).map((post) => <article><p class="article-meta"><time datetime={post.date}>{dateLabel(post.date)}</time><span>{post.readingTime}</span></p><h3><a href={`/blog/${post.slug}`} aria-label={`Read article: ${post.title}`}>{post.title} <span aria-hidden="true">↗</span></a></h3></article>)}</div>}</div> : <p class="empty-writing">No published articles are available.</p>}
    </section>
  </div>
  <section id="contact" class="contact" aria-labelledby="contact-heading"><div class="contact-copy"><p class="eyebrow">Get in touch</p><h2 id="contact-heading">Let’s talk data platforms.</h2><p>{s.contactContext}</p></div><div class="contact-actions"><a class="email-link" href={`mailto:${s.email}`}><span>Email me <span aria-hidden="true">↗</span></span><strong>{s.email}</strong></a><div class="contact-secondary"><a class="text-link" href={s.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><p>For a focused engagement, <a href="/services">explore advisory</a>.</p></div></div></section>
  {review && <footer class="publication-footer"><p>{s.name} <span aria-hidden="true">/</span> xhverse</p><nav aria-label="More about Rujikorn"><a href="/about">About</a><a href="/cv">CV</a><a href="/gallery">Gallery</a><a href="#main-content">Back to top ↑</a></nav></footer>}
</main>
<script>
  function initPublicationDiscovery() {
    document.querySelectorAll<HTMLElement>("[data-tool-discovery]").forEach((list) => {
      if (list.dataset.discoveryReady) return;
      list.dataset.discoveryReady = "true";
      const tools = JSON.parse(list.dataset.discoveryTools!) as Array<{ slug: string; title: string }>;
      const key = list.dataset.discoveryKey!;
      let previous: string[] = [];
      try {
        const saved: unknown = JSON.parse(localStorage.getItem(key) || "[]");
        if (Array.isArray(saved)) previous = saved.slice(0, 2).filter((slug): slug is string => typeof slug === "string");
      } catch (error) {
        console.warn("Tool discovery history is unavailable; selecting without it.", error instanceof Error ? error.name : "Unknown error");
      }
      const fresh = tools.filter((tool) => !previous.includes(tool.slug));
      const pool = fresh.length >= 2 ? fresh : [...tools];
      const selected: typeof tools = [];
      while (selected.length < 2 && pool.length > 0) selected.push(pool.splice(Math.floor(Math.random() * pool.length), 1)[0]);
      const fragment = document.createDocumentFragment();
      for (const tool of selected) {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = `/tools/${tool.slug}`;
        link.append(document.createTextNode(`${tool.title} `));
        const arrow = document.createElement("span");
        arrow.setAttribute("aria-hidden", "true");
        arrow.textContent = "↗";
        link.append(arrow);
        item.append(link);
        fragment.append(item);
      }
      list.replaceChildren(fragment);
      try { localStorage.setItem(key, JSON.stringify(selected.map((tool) => tool.slug))); }
      catch (error) { console.warn("Tool discovery history could not be saved.", error instanceof Error ? error.name : "Unknown error"); }
    });
  }
  initPublicationDiscovery();
  document.addEventListener("astro:page-load", initPublicationDiscovery);
</script>
