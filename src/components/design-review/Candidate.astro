---
import type { ReviewSnapshot } from "./snapshot";
import "./candidates.css";
import PublicationHome from "../PublicationHome.astro";

interface Props {
  direction: "dossier" | "publication" | "studio";
  snapshot: ReviewSnapshot;
  refined?: boolean;
}
const { direction, snapshot: s, refined = false } = Astro.props;
const leadTool = s.tools[0];
const [featuredArticle, ...moreArticles] = s.articles;
const dateLabel = (date: string) => new Date(date).toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" });
---

{refined ? <PublicationHome snapshot={s} review /> : <main id="main-content" class:list={["review-candidate", `candidate-${direction}`]}>
  <section class="identity" aria-labelledby="identity-heading">
    <div class="identity-copy">
      <p class="eyebrow">{s.alias} <span aria-hidden="true">/</span> Data platforms</p>
      <h1 id="identity-heading">{s.name}</h1>
      <p class="professional-title">{s.title}</p>
    </div>
    <div class="identity-band">
      <figure class="portrait">
        <img src={s.portrait} alt="Rujikorn Ngoensaard" width="512" height="512" loading="eager" fetchpriority="high" decoding="async" />
        <figcaption>{s.alias}</figcaption>
      </figure>
      <div class="introduction">
        <p class="intro-text">{s.intro}</p>
        <div class="identity-actions">
          <a class="button-primary" href="#experience">View experience <span aria-hidden="true">↘</span></a>
          <a class="button-secondary" href="#tools">Explore tools <span aria-hidden="true">↘</span></a>
        </div>
        <a class="text-link about-link" href="/about">More about me <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    {direction === "studio" && leadTool && (
      <div class="hero-artifact">
        <div class="artifact-heading"><span class="eyebrow">A tool I’ve built</span><span class="artifact-category">Dimension modeling</span></div>
        <h2><a href={`/tools/${leadTool.slug}`}>{leadTool.title} <span aria-hidden="true">↗</span></a></h2>
        <p>{leadTool.purpose}</p>
        <div class="tool-example">
          <p class="example-label">{leadTool.example.label}</p>
          <ul>{leadTool.example.lines.map((line) => <li>{line}</li>)}</ul>
        </div>
        <a class="text-link" href={`/tools/${leadTool.slug}`}>Try the lab <span aria-hidden="true">↗</span></a>
      </div>
    )}
  </section>

  <div class="professional-record">
    <section id="experience" class="experience section" aria-labelledby="experience-heading">
      <div class="section-heading"><p class="eyebrow">Experience</p><h2 id="experience-heading">Enterprise platforms. Everyday practice.</h2></div>
      <div class="experience-record">
        <div class="experience-topline"><h3>{s.experience.company}</h3><p class="period">{s.experience.period}</p></div>
        <p class="experience-role">{s.experience.role}</p>
        <p class="experience-description">{s.experience.description}</p>
        <ul class="platforms" aria-label="Platforms and technologies">{s.experience.platforms.map((platform) => <li>{platform}</li>)}</ul>
        <a class="text-link" href="/cv">View my CV <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section id="tools" class="tools section" aria-labelledby="tools-heading">
      <div class="section-heading"><div><p class="eyebrow">Public tools</p><h2 id="tools-heading">Tools I’ve built.</h2></div><a class="text-link" href="/tools">All tools <span aria-hidden="true">↗</span></a></div>
      <div class="tool-list">
        {s.tools.map((tool, index) => (
          <article class="tool-entry">
            <div class="tool-copy"><p class="tool-category">{index === 0 ? "Dimension modeling" : "Pipeline operations"}</p><h3><a href={`/tools/${tool.slug}`}>{tool.title} <span aria-hidden="true">↗</span></a></h3><p>{tool.purpose}</p><a class="text-link" href={`/tools/${tool.slug}`}>Open tool <span aria-hidden="true">↗</span></a></div>
            {(direction !== "studio" || index !== 0) && <div class="tool-example"><p class="example-label">{tool.example.label}</p><ul>{tool.example.lines.map((line) => <li>{line}</li>)}</ul></div>}
          </article>
        ))}
      </div>
      <div class="additional-tools"><p>Also in the collection</p><ul>{s.additionalTools.map((tool) => <li><a href={`/tools/${tool.slug}`}>{tool.title} <span aria-hidden="true">↗</span></a></li>)}</ul></div>
    </section>

    <section id="writing" class="writing section" aria-labelledby="writing-heading">
      <div class="section-heading"><div><p class="eyebrow">Writing</p><h2 id="writing-heading">Thinking in public.</h2></div><a class="text-link" href="/blog">All writing <span aria-hidden="true">↗</span></a></div>
      {featuredArticle ? <div class="writing-grid">
        <article class="featured-article">
          {featuredArticle.coverImageUrl && <a class="article-cover" href={`/blog/${featuredArticle.slug}`} tabindex="-1" aria-hidden="true"><img src={featuredArticle.coverImageUrl} alt="" width="1200" height="675" loading="lazy" decoding="async" /></a>}
          <div class="article-copy"><p class="article-meta"><time datetime={featuredArticle.date}>{dateLabel(featuredArticle.date)}</time><span>{featuredArticle.readingTime}</span></p><h3><a href={`/blog/${featuredArticle.slug}`}>{featuredArticle.title} <span aria-hidden="true">↗</span></a></h3><p>{featuredArticle.excerpt}</p><a class="text-link" href={`/blog/${featuredArticle.slug}`}>Read article <span aria-hidden="true">↗</span></a></div>
        </article>
        {moreArticles.length > 0 && <div class="more-writing">{moreArticles.slice(0, 2).map((post) => <article><p class="article-meta"><time datetime={post.date}>{dateLabel(post.date)}</time><span>{post.readingTime}</span></p><h3><a href={`/blog/${post.slug}`}>{post.title} <span aria-hidden="true">↗</span></a></h3></article>)}</div>}
      </div> : <p class="empty-writing">No published articles are available in this preview.</p>}
    </section>
  </div>

  <section id="contact" class="contact" aria-labelledby="contact-heading">
    <div class="contact-copy"><p class="eyebrow">Get in touch</p><h2 id="contact-heading">Let’s talk data platforms.</h2><p>{s.contactContext}</p></div>
    <div class="contact-actions"><a class="email-link" href={`mailto:${s.email}`}><span>Email me <span aria-hidden="true">↗</span></span><strong>{s.email}</strong></a><div class="contact-secondary"><a class="text-link" href={s.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><p>For a focused engagement, <a href="/services">explore advisory</a>.</p></div></div>
  </section>
  <footer class="candidate-footer"><p>{s.name} <span aria-hidden="true">/</span> xhverse</p><nav aria-label="More about Rujikorn"><a href="/about">About</a><a href="/cv">CV</a><a href="/gallery">Gallery</a><a href="#main-content">Back to top ↑</a></nav></footer>
</main>}
