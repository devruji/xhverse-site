---
import { contextLabels, cvRequestContexts } from "../lib/cv-requests/types";
---

<div
  id="cv-request-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm"
  aria-modal="true"
  role="dialog"
  aria-labelledby="cv-modal-title"
  aria-describedby="cv-modal-description"
>
  <div
    id="cv-modal-panel"
    class="relative mx-4 rounded-xl max-h-[90vh] w-full max-w-md overflow-y-auto border border-[var(--border-subtle)] bg-[var(--bg-page)] p-6 shadow-2xl sm:p-8"
  >
    <button
      id="cv-modal-close"
      type="button"
      class="absolute right-3 top-3 inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg text-[var(--muted)] transition hover:text-white"
      aria-label="Close modal"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round"/>
      </svg>
    </button>

    <div id="cv-modal-form-view">
      <p class="text-[11px] uppercase tracking-[0.32em] text-[var(--muted)]">CV Delivery</p>
      <h2 id="cv-modal-title" class="mt-3 text-xl font-semibold tracking-tight text-white">
        Request CV
      </h2>
      <p id="cv-modal-description" class="mt-2 text-sm leading-6 text-zinc-400">
        Submit your details. I review requests before emailing the PDF.
      </p>

      <form id="cv-request-form" class="mt-6 space-y-4" novalidate>
        <div>
          <label for="cv-email" class="block text-[11px] uppercase tracking-[0.22em] text-[var(--muted)]">
            Email <span class="text-emerald-300">*</span>
          </label>
          <input
            id="cv-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="mt-2 block w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-3 py-2.5 text-sm text-white placeholder:text-[var(--muted)] focus:border-emerald-300/50 focus:outline-none"
            placeholder="you@company.com"
          />
        </div>

        <div>
          <label for="cv-name" class="block text-[11px] uppercase tracking-[0.22em] text-[var(--muted)]">
            Name <span class="text-[var(--muted)]">(optional)</span>
          </label>
          <input
            id="cv-name"
            name="name"
            type="text"
            autocomplete="name"
            class="mt-2 block w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-3 py-2.5 text-sm text-white placeholder:text-[var(--muted)] focus:border-emerald-300/50 focus:outline-none"
            placeholder="Your name"
          />
        </div>

        <div>
          <label for="cv-context" class="block text-[11px] uppercase tracking-[0.22em] text-[var(--muted)]">
            Context <span class="text-[var(--muted)]">(optional)</span>
          </label>
          <select
            id="cv-context"
            name="context"
            class="mt-2 block w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-3 py-2.5 text-sm text-white focus:border-emerald-300/50 focus:outline-none"
          >
            <option value="">Select a reason...</option>
            {cvRequestContexts.map((ctx) => (
              <option value={ctx}>{contextLabels[ctx]}</option>
            ))}
          </select>
        </div>

        <div id="cv-context-other-wrap" class="hidden">
          <label for="cv-context-other" class="block text-[11px] uppercase tracking-[0.22em] text-[var(--muted)]">
            Reason <span class="text-emerald-300">*</span>
          </label>
          <textarea
            id="cv-context-other"
            name="context_other"
            rows="2"
            maxlength="200"
            class="mt-2 block w-full resize-none rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-3 py-2.5 text-sm text-white placeholder:text-[var(--muted)] focus:border-emerald-300/50 focus:outline-none"
            placeholder="Tell me why you'd like a copy..."
          ></textarea>
        </div>

        <div class="absolute -left-[9999px] opacity-0" aria-hidden="true">
          <label for="cv-website">Website</label>
          <input id="cv-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div id="cv-form-error" class="hidden text-sm text-red-400" role="alert"></div>

        <div id="cv-turnstile" class="mt-4 flex items-center justify-center overflow-hidden rounded"></div>

        <button
          id="cv-submit-btn"
          type="submit"
          class="cta-primary mt-4 w-full disabled:cursor-not-allowed disabled:opacity-50"
        >
          <span id="cv-submit-text">Request CV</span>
          <span id="cv-submit-loading" class="hidden">Submitting...</span>
        </button>
        <p class="mt-3 text-center text-[11px] leading-5 text-[var(--muted)]">
          Your email is used only to deliver the CV. No marketing, no mailing list.
        </p>
      </form>
    </div>

    <div id="cv-modal-success-view" class="hidden text-center">
      <div class="mx-auto flex size-14 items-center justify-center rounded-full border border-emerald-300/25 bg-emerald-300/10">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-300">
          <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h2 id="cv-success-title" class="mt-4 text-xl font-semibold tracking-tight text-white">Request received</h2>
      <p id="cv-success-message" class="mt-2 text-sm leading-6 text-zinc-400">
        Your request is awaiting review. The PDF will be emailed after approval.
      </p>
      <button
        id="cv-success-close"
        type="button"
        class="cta-secondary mt-6 w-full"
      >
        Close
      </button>
    </div>
  </div>
</div>
