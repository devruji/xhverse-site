---
const navLinks = [
  {
    href: "/about",
    label: "About",
    icon: `<svg width="16" height="16" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="7" r="3.5" stroke="currentColor" stroke-width="1.5"/><path d="M4 17.5c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  },
  {
    href: "/blog",
    label: "Writing",
    icon: `<svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M3 4h10M3 8h14M3 12h8M3 16h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="16" cy="4" r="1.5" fill="currentColor" opacity="0.5"/></svg>`,
  },
  {
    href: "/tools",
    label: "Tools",
    icon: `<svg width="16" height="16" viewBox="0 0 20 20" fill="none"><rect x="3" y="3" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="11" y="3" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="3" y="11" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M14 12v4M12 14h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/></svg>`,
  },
  {
    href: "/services",
    label: "Advisory",
    icon: `<svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M6.5 6V4.5A1.5 1.5 0 018 3h4a1.5 1.5 0 011.5 1.5V6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="3" y="6" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M7 10h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/></svg>`,
  },
  {
    href: "/cv",
    label: "CV",
    icon: `<svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M5 2h7l4 4v12a1.5 1.5 0 01-1.5 1.5h-9A1.5 1.5 0 014 18V3.5A1.5 1.5 0 015.5 2H5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 2v4h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 10h6M7 13h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/></svg>`,
  },
  {
    href: "/gallery",
    label: "Gallery",
    icon: `<svg width="16" height="16" viewBox="0 0 20 20" fill="none"><rect x="2" y="4" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="7" cy="9" r="2" stroke="currentColor" stroke-width="1.2"/><path d="M2 14l4-3 3 2 5-4 4 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" opacity="0.6"/></svg>`,
  },
];
---

<footer class="border-t border-[var(--border-subtle)]">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-5 px-5 py-8 sm:flex-row sm:px-8 lg:px-10">
    <nav class="flex gap-5" aria-label="Footer navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="group flex items-center gap-1.5 text-sm text-[var(--muted)] transition hover:text-[var(--text-heading)]"
          title={link.label}
        >
          <span class="opacity-60 transition group-hover:opacity-100" set:html={link.icon} />
          <span class="hidden sm:inline">{link.label}</span>
        </a>
      ))}
    </nav>
    <p class="text-xs text-[var(--muted)]">&copy; 2026 Rujikorn Ngoensaard. All rights reserved.</p>
  </div>
</footer>
