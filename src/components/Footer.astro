---
import { site } from "../data/site";
const secondaryLinks = [
  { href: "/cv", label: "CV" },
  { href: "/services", label: "Advisory" },
  { href: "/gallery", label: "Gallery" },
];
const profiles = [
  { href: site.github, label: "GitHub" },
  { href: site.linkedin, label: "LinkedIn" },
  { href: site.medium, label: "Medium" },
];
---
<footer class="public-footer">
  <div class="public-container public-footer-inner">
    <div class="public-footer-identity">
      <a href="/" class="public-wordmark">xhverse<span aria-hidden="true">.</span></a>
      <p>Work, thinking, and tools by Rujikorn Ngoensaard.</p>
    </div>
    <nav class="public-footer-links" aria-label="Footer navigation">
      {secondaryLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      {profiles.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<span class="sr-only"> (opens in a new tab)</span><span aria-hidden="true"> ↗</span></a>)}
    </nav>
    <p class="public-copyright">&copy; {new Date().getFullYear()} Rujikorn Ngoensaard</p>
  </div>
</footer>
