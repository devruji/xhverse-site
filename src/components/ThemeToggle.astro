---
const btnBase =
  'fixed bottom-6 right-6 z-[9999] flex h-12 w-12 cursor-pointer items-center justify-center rounded-full border shadow-xl transition hover:scale-110 hover:border-emerald-400 active:scale-95';
const btnDark = 'border-zinc-700 bg-zinc-900 text-zinc-200';
const btnLight = 'border-zinc-300 bg-white text-zinc-700';
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle theme"
  data-astro-transition-persist="theme-toggle"
  class={`${btnBase} ${btnDark}`}
>
  <svg id="theme-icon-sun" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="5"></circle>
    <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
  </svg>
  <svg id="theme-icon-moon" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script is:inline data-cfasync="false" define:vars={{ btnBase, btnDark, btnLight }}>
(function(){
  var toggle = document.getElementById('theme-toggle');
  if (!toggle || toggle._init) return;
  toggle._init = true;

  var sun = document.getElementById('theme-icon-sun');
  var moon = document.getElementById('theme-icon-moon');

  function apply() {
    var isLight = document.documentElement.classList.contains('light');
    if (sun) sun.classList.toggle('hidden', isLight);
    if (moon) moon.classList.toggle('hidden', !isLight);
    toggle.className = btnBase + ' ' + (isLight ? btnLight : btnDark);
  }

  apply();

  toggle.addEventListener('click', function() {
    var isLight = document.documentElement.classList.contains('light');
    if (isLight) {
      document.documentElement.classList.remove('light');
      localStorage.setItem('theme', 'dark');
    } else {
      document.documentElement.classList.add('light');
      localStorage.setItem('theme', 'light');
    }
    apply();
  });
})();
</script>
