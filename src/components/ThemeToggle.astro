---
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle theme"
  data-astro-transition-persist="theme-toggle"
  class="fixed bottom-6 right-6 z-[9999] flex h-12 w-12 cursor-pointer items-center justify-center rounded-full border border-zinc-700 bg-zinc-900 text-zinc-200 shadow-xl transition hover:scale-110 hover:border-emerald-400 active:scale-95"
  onclick="(function(btn){var d=document.documentElement;var isLight=d.classList.contains('light');if(isLight){d.classList.remove('light');localStorage.setItem('theme','dark');btn.querySelector('#theme-icon-sun').classList.remove('hidden');btn.querySelector('#theme-icon-moon').classList.add('hidden');btn.classList.remove('border-zinc-300','bg-white','text-zinc-700');btn.classList.add('border-zinc-700','bg-zinc-900','text-zinc-200');}else{d.classList.add('light');localStorage.setItem('theme','light');btn.querySelector('#theme-icon-sun').classList.add('hidden');btn.querySelector('#theme-icon-moon').classList.remove('hidden');btn.classList.remove('border-zinc-700','bg-zinc-900','text-zinc-200');btn.classList.add('border-zinc-300','bg-white','text-zinc-700');}})(this)"
>
  <svg id="theme-icon-sun" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="5"></circle>
    <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
  </svg>
  <svg id="theme-icon-moon" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script is:inline>
(function(){
  var toggle = document.getElementById('theme-toggle');
  if (!toggle) return;
  var isLight = document.documentElement.classList.contains('light');
  var sun = document.getElementById('theme-icon-sun');
  var moon = document.getElementById('theme-icon-moon');
  if (sun && moon) {
    sun.classList.toggle('hidden', isLight);
    moon.classList.toggle('hidden', !isLight);
  }
  if (isLight) {
    toggle.classList.remove('border-zinc-700','bg-zinc-900','text-zinc-200');
    toggle.classList.add('border-zinc-300','bg-white','text-zinc-700');
  }
})();
</script>
