---
import { profile } from "../data/profile";
---

<section class="section hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-entrance">Welcome to xhverse</p>
      <h1 class="hero-entrance-delayed">{profile.name}</h1>
      <p class="hero-title hero-entrance-delayed-2">{profile.title}</p>
      <p class="hero-bio hero-entrance-delayed-2">{profile.bio}</p>
    </div>
    <div class="hero-media hero-media-entrance">
      <img
        src={profile.avatar}
        alt={profile.name}
        class="hero-avatar"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

