---
import { buildCanonicalUrl, site } from "../data/site";
import { shouldNoIndexDeployment } from "../data/seo.js";
import { ClientRouter } from "astro:transitions";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";

const deploymentSite = (Astro.site ?? site.siteUrl).toString();
const defaultNoindex = shouldNoIndexDeployment(
  deploymentSite,
  site.siteUrl,
  import.meta.env,
);
const isDev = import.meta.env.DEV;
const publicSupabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseConnectOrigin = (() => {
  if (!publicSupabaseUrl) return "";
  try {
    return new URL(publicSupabaseUrl).origin;
  } catch {
    return "";
  }
})();
const connectSrc = ["'self'", supabaseConnectOrigin].filter(Boolean).join(" ");

// Optional same-origin LCP image path (e.g. home hero); adds `<link rel="preload" as="image">` when set.
const {
  title = site.title,
  description = site.description,
  image = site.ogImage,
  type = "website",
  noindex = defaultNoindex,
  structuredData,
  bodyClass = "",
  lcpImage = "",
} = Astro.props;

const titleIncludesSiteName = title
  .toLocaleLowerCase()
  .includes(site.title.toLocaleLowerCase());
const pageTitle =
  title === site.title || titleIncludesSiteName
    ? title
    : `${title} | ${site.title}`;
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname, deploymentSite);
const socialImage = new URL(image, deploymentSite).toString();
---

<html lang="en">
  <head>
    <script is:inline>
      (function(){var t=localStorage.getItem('theme');var l=(t==='light')||((!t)&&window.matchMedia('(prefers-color-scheme: light)').matches);if(l)document.documentElement.classList.add('light');})();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:site" content={site.xHandle} />
    {!isDev && (
      <>
        <meta
          http-equiv="Content-Security-Policy"
          content={`default-src 'self'; img-src 'self' data: https:; style-src 'self'; font-src 'self' data:; connect-src ${connectSrc}; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests`}
        />
        <meta http-equiv="X-Content-Type-Options" content="nosniff" />
        <meta http-equiv="X-Frame-Options" content="DENY" />
      </>
    )}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#000000" />
    <meta name="author" content="Rujikorn Ngoensaard" />
    <meta name="application-name" content="XHVERSE" />
    <meta name="apple-mobile-web-app-title" content="XHVERSE" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href={site.manifest} />
    {lcpImage ? (
      <link rel="preload" as="image" href={lcpImage} fetchpriority="high" />
    ) : null}
    <title>{pageTitle}</title>
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )}
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <div class="page">
      <slot />
    </div>
    <ThemeToggle />
    <script is:inline>
      (function() {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Scroll-reveal + stagger observer
        if (!reduced) {
          var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
          document.querySelectorAll('.animate-on-scroll').forEach(function(el) { observer.observe(el); });
        }

        // Cursor spotlight
        var spotlight = document.querySelector('.hero-spotlight');
        if (spotlight && !reduced) {
          spotlight.addEventListener('mousemove', function(e) {
            var rect = spotlight.getBoundingClientRect();
            spotlight.style.setProperty('--spotlight-x', (e.clientX - rect.left) + 'px');
            spotlight.style.setProperty('--spotlight-y', (e.clientY - rect.top) + 'px');
            spotlight.classList.add('spotlight-active');
          });
          spotlight.addEventListener('mouseleave', function() {
            spotlight.classList.remove('spotlight-active');
          });
        }

        // Parallax on hero avatar
        var parallax = document.querySelector('.hero-parallax');
        if (parallax && !reduced) {
          window.addEventListener('scroll', function() {
            var scroll = window.scrollY;
            if (scroll < 800) {
              parallax.style.transform = 'translateY(' + (scroll * 0.08) + 'px)';
            }
          }, { passive: true });
        }

        // Reading progress bar
        var progressBar = document.querySelector('.reading-progress');
        if (progressBar) {
          window.addEventListener('scroll', function() {
            var scrollTop = window.scrollY;
            var docHeight = document.documentElement.scrollHeight - window.innerHeight;
            var progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
            progressBar.style.width = progress + '%';
          }, { passive: true });
        }
      })();
    </script>
  </body>
</html>
