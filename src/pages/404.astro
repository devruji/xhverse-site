---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<BaseLayout title="Page not found | xhverse" noindex={true}>
  <Header />
  <main id="main-content" class="public-container public-section missing-page">
    <p class="public-kicker">404</p>
    <h1 class="public-heading">Page not found</h1>
    <p class="public-intro">This page may have moved, or the address may be incorrect.</p>
    <nav aria-label="Find another page" class="recovery-links"><a href="/" class="cta-primary">Home</a><a href="/blog" class="text-link">Writing</a><a href="/tools" class="text-link">Tools</a></nav>
  </main>
  <Footer />
</BaseLayout>
<style>
  .missing-page { min-height: 60vh; }
  h1 { margin-top: 24px; }
  .public-intro { margin-top: 24px; }
  .recovery-links { display: flex; flex-wrap: wrap; align-items: center; gap: 28px; margin-top: 36px; }
</style>
