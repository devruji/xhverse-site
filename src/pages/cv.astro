---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import CvRequestModal from "../components/CvRequestModal.astro";
import {
  cvHighlights,
  resolveCvPdfUrl,
} from "../data/cv";
import { profile } from "../data/profile";
import { site } from "../data/site";

const deploymentSite = (Astro.site ?? site.siteUrl).toString();
const cvUrl = new URL("/cv", deploymentSite).toString();
const pdfUrl = resolveCvPdfUrl();

const cvStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${cvUrl}#cv-page`,
  name: `${profile.fullName} CV`,
  alternateName: ["Rujikorn Ngoensaard resume", "bossruji CV", "XH CV"],
  url: cvUrl,
  description:
    "Public CV and professional background for Rujikorn Ngoensaard, also known as XH and bossruji.",
  about: {
    "@type": "Person",
    "@id": `${deploymentSite}#person`,
    name: profile.fullName,
    alternateName: profile.alternateNames,
    additionalName: ["XH", "bossruji"],
    url: deploymentSite,
    jobTitle: profile.title,
    email: profile.email,
    sameAs: [site.github, site.medium, site.linkedin],
  },
};
---

<BaseLayout
  title={`${profile.fullName} CV`}
  description="View and download the public CV for Rujikorn Ngoensaard, also known as XH and bossruji, focused on data platform architecture, governance, and analytics engineering."
  image={profile.avatar}
  structuredData={cvStructuredData}
>
  <div class="min-h-screen bg-[var(--bg-page)] font-sans text-[var(--text)]">
    <main class="mx-auto max-w-6xl px-5 py-6 sm:px-8 sm:py-8 lg:px-10">
      <header class="flex items-start justify-between gap-5 border-b border-white/10 pb-5 sm:items-center">
        <a href="/" class="group">
          <p class="text-[11px] uppercase tracking-[0.35em] text-zinc-500">xhverse.co</p>
          <span class="mt-1 block text-[1.35rem] font-semibold tracking-tight text-white sm:text-[1.55rem]">
            XHVERSE
          </span>
        </a>
        <nav class="hidden items-center gap-6 text-sm text-zinc-400 md:flex" aria-label="Primary navigation">
          <a href="/" class="transition hover:text-white">Home</a>
          <a href="/about" class="transition hover:text-white">About</a>
          <a href="/blog" class="transition hover:text-white">Writing</a>
          <a href="/cv" aria-current="page" class="text-white">CV</a>
          <a href="/#contact" class="transition hover:text-white">Contact</a>
        </nav>
        <a
          href={pdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-white/15 px-3 py-1.5 text-xs uppercase tracking-[0.18em] text-zinc-300 transition hover:border-emerald-300/70 hover:text-white md:hidden"
        >
          Open PDF
        </a>
      </header>

      <section class="grid gap-10 py-12 sm:py-16 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
        <div>
          <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Public CV</p>
          <h1 class="mt-4 max-w-4xl text-[2.6rem] font-semibold leading-[0.98] tracking-tight text-white sm:text-[4.2rem]">
            Rujikorn Ngoensaard
          </h1>
          <p class="mt-4 text-sm font-medium uppercase tracking-[0.22em] text-emerald-200">
            XH / bossruji · Data Engineer / Data Architect
          </p>
          <p class="mt-6 max-w-2xl text-base leading-8 text-zinc-300 sm:text-lg">
            Public CV for data platform architecture, governance, analytics engineering, and practical enterprise data work.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href={pdfUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center bg-white px-5 py-3 text-sm font-semibold text-black transition hover:bg-emerald-100"
            >
              Open PDF
            </a>
            <button
              type="button"
              class="cv-request-open inline-flex items-center justify-center border border-white/15 px-5 py-3 text-sm font-medium text-white transition hover:border-emerald-300/70"
            >
              Send me a copy
            </button>
          </div>
        </div>

        <aside class="border border-white/10 bg-white/[0.03] p-5 sm:p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-[11px] uppercase tracking-[0.24em] text-zinc-500">Document status</p>
              <h2 class="mt-3 text-2xl font-semibold tracking-tight text-white">
                Public CV available
              </h2>
            </div>
            <span class="border border-emerald-300/25 bg-emerald-300/8 px-3 py-1 text-[11px] uppercase tracking-[0.18em] text-emerald-200">
              PDF
            </span>
          </div>
          <p class="mt-5 text-sm leading-7 text-zinc-400">
            Open the PDF in a new tab or download a copy for later reference.
          </p>
          <dl class="mt-6 grid gap-4 border-t border-white/10 pt-5 text-sm sm:grid-cols-2">
            <div>
              <dt class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Format</dt>
              <dd class="mt-2 text-zinc-300">PDF</dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Size</dt>
              <dd class="mt-2 text-zinc-300">201 KB</dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Availability</dt>
              <dd class="mt-2 inline-flex items-center gap-2 text-zinc-300">
                <span class="relative flex size-2.5" aria-hidden="true">
                  <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-300 opacity-60"></span>
                  <span class="relative inline-flex size-2.5 rounded-full bg-emerald-300"></span>
                </span>
                Online
              </dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Access</dt>
              <dd class="mt-2 text-zinc-300">Public</dd>
            </div>
          </dl>
        </aside>
      </section>

      <section class="border-t border-white/10 py-12 sm:py-16">
        <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Snapshot</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Data platform work with an operator mindset.
            </h2>
          </div>
          <div class="grid gap-3">
            {cvHighlights.map((item) => (
              <article class="border border-white/10 bg-white/[0.03] p-5">
                <p class="text-sm leading-7 text-zinc-300">{item}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

    </main>
    <Footer />
    <CvRequestModal />
  </div>

  <script>
    import {
      createCvRequestsPublicClient,
      submitCvRequest,
    } from "../lib/cv-requests/supabase";
    import { validateEmail } from "../lib/cv-requests/validation";
    import { cvRequestContexts, type CvRequestContext } from "../lib/cv-requests/types";

    function initCvModal() {
      const modal = document.getElementById("cv-request-modal");
      const panel = document.getElementById("cv-modal-panel");
      const form = document.getElementById("cv-request-form") as HTMLFormElement | null;
      const formView = document.getElementById("cv-modal-form-view");
      const successView = document.getElementById("cv-modal-success-view");
      const errorEl = document.getElementById("cv-form-error");
      const submitBtn = document.getElementById("cv-submit-btn") as HTMLButtonElement | null;
      const submitText = document.getElementById("cv-submit-text");
      const submitLoading = document.getElementById("cv-submit-loading");
      const closeBtn = document.getElementById("cv-modal-close");
      const successCloseBtn = document.getElementById("cv-success-close");

      if (!modal || !panel || !form || !formView || !successView || !errorEl || !submitBtn || !submitText || !submitLoading || !closeBtn || !successCloseBtn) return;

      const contextSelect = document.getElementById("cv-context") as HTMLSelectElement | null;
      const contextOtherWrap = document.getElementById("cv-context-other-wrap");
      const contextOtherInput = document.getElementById("cv-context-other") as HTMLTextAreaElement | null;

      contextSelect?.addEventListener("change", () => {
        if (contextOtherWrap) {
          contextOtherWrap.classList.toggle("hidden", contextSelect.value !== "other");
        }
      });

      const openButtons = document.querySelectorAll(".cv-request-open");

      function openModal() {
        modal!.classList.remove("hidden");
        modal!.classList.add("flex");
        formView!.classList.remove("hidden");
        successView!.classList.add("hidden");
        errorEl!.classList.add("hidden");
        errorEl!.textContent = "";
        form!.reset();
        if (contextOtherWrap) contextOtherWrap.classList.add("hidden");
      }

      function closeModal() {
        modal!.classList.add("hidden");
        modal!.classList.remove("flex");
      }

      function showError(message: string) {
        errorEl!.textContent = message;
        errorEl!.classList.remove("hidden");
      }

      function setLoading(loading: boolean) {
        submitBtn!.disabled = loading;
        submitText!.classList.toggle("hidden", loading);
        submitLoading!.classList.toggle("hidden", !loading);
      }

      openButtons.forEach((btn) => {
        btn.addEventListener("click", openModal);
      });

      closeBtn.addEventListener("click", closeModal);
      successCloseBtn.addEventListener("click", closeModal);

      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal.classList.contains("hidden")) {
          closeModal();
        }
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorEl.classList.add("hidden");

        const emailInput = (document.getElementById("cv-email") as HTMLInputElement).value;
        const nameInput = (document.getElementById("cv-name") as HTMLInputElement).value;
        const contextInput = (document.getElementById("cv-context") as HTMLSelectElement).value;
        const honeypotInput = (document.getElementById("cv-website") as HTMLInputElement).value;

        const emailCheck = validateEmail(emailInput);
        if (!emailCheck.valid) {
          showError(emailCheck.error);
          return;
        }

        const context: CvRequestContext | null =
          contextInput && cvRequestContexts.includes(contextInput as CvRequestContext)
            ? (contextInput as CvRequestContext)
            : null;

        setLoading(true);

        try {
          const client = createCvRequestsPublicClient({
            PUBLIC_SUPABASE_URL: import.meta.env.PUBLIC_SUPABASE_URL,
            PUBLIC_SUPABASE_PUBLISHABLE_KEY: import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY,
            PUBLIC_SUPABASE_ANON_KEY: import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
          });

          const result = await submitCvRequest(client, {
            email: emailInput,
            name: nameInput || null,
            context,
            contextOther: context === "other" ? (contextOtherInput?.value || null) : null,
            honeypot: honeypotInput,
          });

          switch (result.kind) {
            case "saved":
              formView!.classList.add("hidden");
              successView!.classList.remove("hidden");
              break;
            case "duplicate_pending":
              formView!.classList.add("hidden");
              successView!.classList.remove("hidden");
              break;
            case "validation_error":
              showError(result.message);
              break;
            case "skipped":
              formView!.classList.add("hidden");
              successView!.classList.remove("hidden");
              break;
            case "failed":
              showError("Something went wrong. Please try again later.");
              break;
          }
        } catch {
          showError("Something went wrong. Please try again later.");
        } finally {
          setLoading(false);
        }
      });
    }

    initCvModal();
    document.addEventListener("astro:page-load", initCvModal);
  </script>
</BaseLayout>
