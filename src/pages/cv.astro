---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CvRequestModal from "../components/CvRequestModal.astro";
import { cvHighlights } from "../data/cv";
import { profile } from "../data/profile";
import { site } from "../data/site";
import { buildCvProfilePageJsonLd } from "../lib/seo/structured-data";

const deploymentSite = (Astro.site ?? site.siteUrl).toString();
const cvStructuredData = buildCvProfilePageJsonLd(deploymentSite);
---

<BaseLayout
  title={`${profile.fullName} CV`}
  description="Request the CV for Rujikorn Ngoensaard, also known as XH and bossruji, focused on data platform architecture, governance, and analytics engineering."
  image={profile.avatar}
  structuredData={cvStructuredData}
>
  <div class="min-h-screen bg-[var(--bg-page)] font-sans text-[var(--text)]">
    <Header current="/cv" />
    <main id="main-content" class="public-container">

      <section class="public-section grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
        <div>
          <p class="public-kicker">Rujikorn Ngoensaard</p>
          <h1 class="public-heading mt-4">Request CV</h1>
          <p class="mt-4 text-sm font-medium uppercase tracking-[0.22em] text-[var(--muted)]">
            XH / bossruji · Senior Data Engineer | Platform Architecture
          </p>
          <p class="public-intro mt-5 max-w-2xl">
            My experience in data platform delivery, governance, and analytics engineering.
          </p>
          <div class="mt-8">
            <button
              type="button"
              class="cta-primary cv-request-open"
            >
              Request CV
            </button>
            <p class="mt-3 text-xs text-[var(--muted)]">PDF delivered to your inbox once reviewed. No spam, no mailing list.</p>
          </div>
        </div>

        <aside class="static-card p-5 sm:p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-[11px] uppercase tracking-[0.24em] text-[var(--muted)]">Document</p>
              <h2 class="mt-3 text-2xl font-semibold tracking-tight text-white">
                CV available on request
              </h2>
            </div>
            <span class="border border-[var(--border-subtle)] bg-[var(--bg-page)] px-3 py-1 text-[11px] uppercase tracking-[0.18em] text-[var(--muted)]">
              PDF
            </span>
          </div>
          <p class="mt-5 text-sm leading-7 text-zinc-400">
            Submit your email and receive the full PDF once reviewed.
          </p>
          <dl class="mt-6 grid gap-4 border-t border-[var(--border-subtle)] pt-5 text-sm sm:grid-cols-2">
            <div>
              <dt class="text-[11px] uppercase tracking-[0.22em] text-[var(--muted)]">Format</dt>
              <dd class="mt-2 text-zinc-300">PDF</dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.22em] text-[var(--muted)]">Size</dt>
              <dd class="mt-2 text-zinc-300">201 KB</dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.22em] text-[var(--muted)]">Delivery</dt>
              <dd class="mt-2 inline-flex items-center gap-2 text-zinc-300">
                Via email
              </dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.22em] text-[var(--muted)]">Access</dt>
              <dd class="mt-2 text-zinc-300">On request</dd>
            </div>
          </dl>
        </aside>
      </section>

      <section class="public-section border-t border-[var(--border-subtle)]">
        <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-[var(--muted)]">What's included</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              A focused, technical CV.
            </h2>
            <p class="mt-4 text-sm leading-7 text-zinc-400">
              Experience, projects, and qualifications for technical hiring managers and platform leads.
            </p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <article class="static-card p-5">
              <p class="text-sm font-medium text-white">Platform experience</p>
              <p class="mt-2 text-sm leading-7 text-zinc-400">Azure, Databricks, Fabric, Spark, Power BI — with specific project context.</p>
            </article>
            <article class="static-card p-5">
              <p class="text-sm font-medium text-white">Architecture depth</p>
              <p class="mt-2 text-sm leading-7 text-zinc-400">Lakehouse design, governance models, data product delivery patterns.</p>
            </article>
            <article class="static-card p-5">
              <p class="text-sm font-medium text-white">Industry context</p>
              <p class="mt-2 text-sm leading-7 text-zinc-400">Retail, Real Estate, E-Commerce, Manufacturing, and Loyalty — enterprise-scale work.</p>
            </article>
            <article class="static-card p-5">
              <p class="text-sm font-medium text-white">Certifications and education</p>
              <p class="mt-2 text-sm leading-7 text-zinc-400">Relevant credentials and continuous learning background.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="public-section border-t border-[var(--border-subtle)]">
        <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-[var(--muted)]">Snapshot</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Experience highlights.
            </h2>
          </div>
          <div class="grid gap-3">
            {cvHighlights.map((item) => (
              <article class="static-card p-5">
                <p class="text-sm leading-7 text-zinc-300">{item}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

    </main>
    <Footer />
    <CvRequestModal />
  </div>

  <script>
    import { createUiMotion } from "../lib/ui-motion";
    import { validateEmail } from "../lib/cv-requests/validation";
    import { cvRequestContexts, type CvRequestContext } from "../lib/cv-requests/types";

    declare global {
      interface Window {
        turnstile?: {
          render: (container: HTMLElement, options: Record<string, string>) => string;
          reset: (widgetId: string) => void;
          remove: (widgetId: string) => void;
        };
      }
    }

    function initCvModal() {
      const modal = document.getElementById("cv-request-modal");
      const panel = document.getElementById("cv-modal-panel");
      const form = document.getElementById("cv-request-form") as HTMLFormElement | null;
      const formView = document.getElementById("cv-modal-form-view");
      const successView = document.getElementById("cv-modal-success-view");
      const errorEl = document.getElementById("cv-form-error");
      const submitBtn = document.getElementById("cv-submit-btn") as HTMLButtonElement | null;
      const submitText = document.getElementById("cv-submit-text");
      const submitLoading = document.getElementById("cv-submit-loading");
      const closeBtn = document.getElementById("cv-modal-close");
      const successCloseBtn = document.getElementById("cv-success-close");

      if (!modal || !panel || !form || !formView || !successView || !errorEl || !submitBtn || !submitText || !submitLoading || !closeBtn || !successCloseBtn) return;

      if (modal.dataset.cvBound) return;
      modal.dataset.cvBound = "true";
      const motionEnabled = document.documentElement.hasAttribute("data-ui-motion");
      const motion = motionEnabled ? createUiMotion(true, window.matchMedia("(prefers-reduced-motion: reduce)")) : null;
      let open = false;
      let revision = 0;
      const listeners = new AbortController();
      document.addEventListener("astro:before-swap", () => { listeners.abort(); motion?.dispose(); }, { once: true });

      const contextSelect = document.getElementById("cv-context") as HTMLSelectElement | null;
      const contextOtherWrap = document.getElementById("cv-context-other-wrap");
      const contextOtherInput = document.getElementById("cv-context-other") as HTMLTextAreaElement | null;

      contextSelect?.addEventListener("change", () => {
        if (contextOtherWrap) {
          contextOtherWrap.classList.toggle("hidden", contextSelect.value !== "other");
        }
      });

      const openButtons = document.querySelectorAll(".cv-request-open");

      let turnstileWidgetId: string | null = null;
      let turnstileScriptLoaded = false;
      let returnFocus: HTMLElement | null = null;

      function loadTurnstileScript() {
        if (turnstileScriptLoaded) return;
        if (document.querySelector('script[src*="challenges.cloudflare.com/turnstile"]')) {
          turnstileScriptLoaded = true;
          return;
        }
        const script = document.createElement("script");
        script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
        script.async = true;
        document.head.appendChild(script);
        turnstileScriptLoaded = true;
      }

      function renderTurnstile() {
        const container = document.getElementById("cv-turnstile");
        if (!container) return;
        loadTurnstileScript();
        if (!window.turnstile) {
          setTimeout(renderTurnstile, 300);
          return;
        }
        if (container.childElementCount > 0) return;
        const theme = document.documentElement.classList.contains("light") ? "light" : "dark";
        turnstileWidgetId = window.turnstile.render(container, {
          sitekey: "0x4AAAAAADMcLyUUQWUEWNgW",
          theme,
          size: "flexible",
        });
      }

      function openModal(event?: Event) {
        open = true;
        revision += 1;
        modal!.inert = false;
        modal!.removeAttribute("aria-hidden");
        modal!.style.removeProperty("pointer-events");
        returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        modal!.setAttribute("aria-labelledby", "cv-modal-title");
        modal!.setAttribute("aria-describedby", "cv-modal-description");
        modal!.classList.remove("hidden");
        modal!.classList.add("flex");
        formView!.classList.remove("hidden");
        successView!.classList.add("hidden");
        errorEl!.classList.add("hidden");
        errorEl!.textContent = "";
        form!.reset();
        if (contextOtherWrap) contextOtherWrap.classList.add("hidden");
        renderTurnstile();
        document.getElementById("cv-email")?.focus();
        const pointer = motion?.eligible(event) ?? false;
        motion?.animate(modal!, [{ opacity: 0 }, { opacity: 1 }], 220, pointer);
        motion?.animate(panel!, [{ transform: "scale(0.97)" }, { transform: "scale(1)" }], 220, pointer);
      }

      function closeModal(event?: Event) {
        open = false;
        const closingRevision = ++revision;
        // Focus and access state change now; only the visual surface waits.
        modal!.inert = true;
        modal!.setAttribute("aria-hidden", "true");
        modal!.style.pointerEvents = "none";
        returnFocus?.focus();
        returnFocus = null;
        const hide = () => {
          if (revision !== closingRevision || open) return;
          modal!.classList.add("hidden");
          modal!.classList.remove("flex");
          motion?.cancel(panel!);
        };
        const pointer = motion?.eligible(event) ?? false;
        if (!motion) { hide(); return; }
        motion.animate(panel!, [{ transform: "scale(1)" }, { transform: "scale(0.97)" }], 140, pointer);
        motion.animate(modal!, [{ opacity: 1 }, { opacity: 0 }], 140, pointer, hide);
      }

      function showSuccess() {
        formView!.classList.add("hidden");
        successView!.classList.remove("hidden");
        modal!.setAttribute("aria-labelledby", "cv-success-title");
        modal!.setAttribute("aria-describedby", "cv-success-message");
        successCloseBtn!.focus();
      }

      function showError(message: string) {
        errorEl!.textContent = message;
        errorEl!.classList.remove("hidden");
      }

      function setLoading(loading: boolean) {
        submitBtn!.disabled = loading;
        submitText!.classList.toggle("hidden", loading);
        submitLoading!.classList.toggle("hidden", !loading);
      }

      openButtons.forEach((btn) => {
        btn.addEventListener("click", openModal);
      });

      closeBtn.addEventListener("click", closeModal);
      successCloseBtn.addEventListener("click", closeModal);

      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal(e);
      });

      document.addEventListener("keydown", (e) => {
        if (!open) return;
        if (e.key === "Escape" && !modal.classList.contains("hidden")) {
          closeModal();
        }
        if (e.key === "Tab") {
          const controls = Array.from(panel.querySelectorAll<HTMLElement>('button:not(:disabled), input:not([type="hidden"]):not([tabindex="-1"]), select, textarea, a[href]'))
            .filter((element) => element.getClientRects().length > 0);
          const first = controls[0];
          const last = controls[controls.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last?.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first?.focus();
          }
        }
      }, { signal: listeners.signal });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorEl.classList.add("hidden");

        const emailInput = (document.getElementById("cv-email") as HTMLInputElement).value;
        const nameInput = (document.getElementById("cv-name") as HTMLInputElement).value;
        const contextInput = (document.getElementById("cv-context") as HTMLSelectElement).value;
        const honeypotInput = (document.getElementById("cv-website") as HTMLInputElement).value;

        if (honeypotInput) return;

        const emailCheck = validateEmail(emailInput);
        if (!emailCheck.valid) {
          showError(emailCheck.error);
          return;
        }

        const turnstileResponse = (document.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement)?.value;
        if (!turnstileResponse) {
          showError("Please complete the verification challenge.");
          return;
        }

        const context: CvRequestContext | null =
          contextInput && cvRequestContexts.includes(contextInput as CvRequestContext)
            ? (contextInput as CvRequestContext)
            : null;

        if (context === "other" && !contextOtherInput?.value.trim()) {
          showError("Please provide a reason when selecting 'Other'.");
          return;
        }

        setLoading(true);

        try {
          const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
          if (!supabaseUrl) {
            showError("CV requests are unavailable in this local preview. Email contact@xhverse.co to request a copy.");
            return;
          }

          const res = await fetch(`${supabaseUrl}/functions/v1/submit-cv-request`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email: emailInput,
              name: nameInput || null,
              context,
              contextOther: context === "other" ? (contextOtherInput?.value || null) : null,
              turnstileToken: turnstileResponse,
            }),
          });

          const result = await res.json();
          const successTitle = document.getElementById("cv-success-title");
          const successMessage = document.getElementById("cv-success-message");

          switch (result.kind) {
            case "saved":
              if (successTitle) successTitle.textContent = "Request Received";
              if (successMessage) successMessage.textContent = "Thank you. Your request is awaiting review. The PDF will be emailed after approval.";
              showSuccess();
              break;
            case "duplicate_pending":
              if (successTitle) successTitle.textContent = "Already Requested";
              if (successMessage) successMessage.textContent = "Your existing request is awaiting review. The PDF will be emailed after approval.";
              showSuccess();
              break;
            case "turnstile_failed":
              showError("Verification failed. Please try again.");
              if (turnstileWidgetId !== null && window.turnstile) {
                window.turnstile.reset(turnstileWidgetId);
              }
              break;
            case "validation_error":
              showError(result.message);
              break;
            default:
              showError("Something went wrong. Please try again later.");
              break;
          }
        } catch {
          showError("Something went wrong. Please try again later.");
        } finally {
          setLoading(false);
        }
      });
    }

    document.addEventListener("astro:page-load", initCvModal);
  </script>
</BaseLayout>
