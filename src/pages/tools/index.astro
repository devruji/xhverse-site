---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { profile } from "../../data/profile";
import { site } from "../../data/site";
import { liveToolCount, toolCatalog } from "../../data/tools";

const deploymentSite = (Astro.site ?? site.siteUrl).toString();
---

<BaseLayout
  title={`Data Platform Tools by ${profile.fullName}`}
  description="Free data platform tools by Rujikorn Ngoensaard, also known as XH and bossruji, for architecture decisions, governance checks, SQL practice, and lakehouse planning."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `XHVERSE tools by ${profile.fullName}`,
    alternateName: ["xhverse tools", "bossruji data tools", "XH data platform tools"],
    url: new URL("/tools", deploymentSite).toString(),
    description:
      "Free data platform tools by Rujikorn Ngoensaard, also known as XH and bossruji, for architecture decisions, governance checks, SQL practice, and lakehouse planning.",
    creator: { "@type": "Person", "@id": `${deploymentSite}#person`, name: profile.fullName },
    publisher: { "@type": "Person", "@id": `${deploymentSite}#person`, name: profile.fullName },
    isPartOf: { "@type": "WebSite", "@id": `${deploymentSite}#website`, name: site.title },
  }}
>
  <div class="min-h-screen bg-[var(--bg-page)] font-sans text-[var(--text)]">
  <Header current="/tools" />
  <main>
    <div class="mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-20 lg:px-10">
      <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Toolbox</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl lg:text-5xl">
        Data platform tools by Rujikorn Ngoensaard
      </h1>
      <p class="mt-4 max-w-xl text-sm leading-7 text-zinc-400">
        {liveToolCount} free tools from XH / bossruji for data platform teams —
        assessments, challenges, calculators, visualizers, and practical
        learning labs. Fast, anonymous, and useful without context.
      </p>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {toolCatalog.map((tool) => (
          <a
            href={`/tools/${tool.slug}`}
            class="interactive-card group relative flex flex-col rounded-2xl p-6"
          >
            <div class="mb-3 flex items-center justify-between">
              <span class="rounded-full border border-emerald-300/25 bg-emerald-300/8 px-2.5 py-0.5 text-[10px] uppercase tracking-wider text-emerald-200">
                {tool.status}
              </span>
              <span class="text-[10px] uppercase tracking-wider text-zinc-500">{tool.category}</span>
            </div>
            <h2 class="text-lg font-semibold leading-snug text-white">
              {tool.title}
            </h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-400">{tool.description}</p>
            <div class="mt-5">
              <span class="link-cue text-sm font-medium">
                Open tool →
              </span>
            </div>
          </a>
        ))}

      </div>
    </div>
  </main>
  <Footer />
  </div>
</BaseLayout>
