---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { site } from "../../data/site";

const deploymentSite = (Astro.site ?? site.siteUrl).toString();

const tools = [
  {
    slug: "data-platform-maturity-checker",
    title: "Data Platform Maturity Checker",
    description:
      "A lightweight, anonymous maturity signal for platform architecture, governance, analytics delivery, operations, and documentation. Get a directional benchmark in under 3 minutes.",
    category: "Assessment",
    status: "Live",
  },
];
---

<BaseLayout
  title="Tools"
  description="Interactive tools for data platform architecture, governance assessment, and analytics maturity by Rujikorn Ngoensaard."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "XHVERSE Tools",
    url: new URL("/tools", deploymentSite).toString(),
    description: "Interactive tools for data platform architecture and governance assessment.",
  }}
>
  <div class="min-h-screen bg-[var(--bg-page)] font-sans text-[var(--text)]">
  <Header current="/tools" />
  <main>
    <div class="mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-20 lg:px-10">
      <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Toolbox</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl lg:text-5xl">
        Interactive tools
      </h1>
      <p class="mt-4 max-w-xl text-sm leading-7 text-zinc-400">
        Practical, focused instruments for data platform teams. Each tool is designed to surface a specific signal — fast, anonymous, and useful without context.
      </p>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((tool) => (
          <a
            href={`/tools/${tool.slug}`}
            class="group relative flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition hover:border-emerald-300/50 hover:bg-white/[0.05]"
          >
            <div class="mb-3 flex items-center justify-between">
              <span class="rounded-full border border-emerald-300/25 bg-emerald-300/8 px-2.5 py-0.5 text-[10px] uppercase tracking-wider text-emerald-200">
                {tool.status}
              </span>
              <span class="text-[10px] uppercase tracking-wider text-zinc-500">{tool.category}</span>
            </div>
            <h2 class="text-lg font-semibold leading-snug text-white">
              {tool.title}
            </h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-400">{tool.description}</p>
            <div class="mt-5">
              <span class="text-sm font-medium text-emerald-300 transition group-hover:text-emerald-200">
                Open tool →
              </span>
            </div>
          </a>
        ))}

        <!-- Coming soon placeholder -->
        <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-white/10 p-6 text-center">
          <svg width="32" height="32" viewBox="0 0 20 20" fill="none" class="text-zinc-600">
            <rect x="3" y="3" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
            <rect x="11" y="3" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
            <rect x="3" y="11" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M14 12v4M12 14h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/>
          </svg>
          <p class="mt-3 text-sm text-zinc-600">More tools coming</p>
        </div>
      </div>
    </div>
  </main>
  <Footer />
  </div>
</BaseLayout>
