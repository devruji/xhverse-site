---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import {
  practitionerToolDefinitions,
} from "../../lib/practitioner-tools/definitions";
import type { PractitionerToolDefinition } from "../../lib/practitioner-tools/types";

export function getStaticPaths() {
  return practitionerToolDefinitions.map((definition) => ({
    params: { slug: definition.slug },
    props: { definition },
  }));
}

const definition = Astro.props.definition as PractitionerToolDefinition;
const journeyIdentityByTheme = {
  contract: {
    boardLabel: "Contract clauses",
    boardHeading: "Assemble the contract clauses",
    boardLead: "Use each hint to choose the strongest operating evidence before publishing the product contract.",
    guideLabel: "Clause guide",
    currentLabel: "Current clause",
    targetLabel: "Operated clause",
    moveLabel: "Clause consequence",
  },
  access: {
    boardLabel: "Policy gates",
    boardHeading: "Pass the access gates",
    boardLead: "Use each hint to test whether the policy holds across real access paths.",
    guideLabel: "Policy guide",
    currentLabel: "Current gate",
    targetLabel: "Operated gate",
    moveLabel: "Policy consequence",
  },
  layout: {
    boardLabel: "Signal map",
    boardHeading: "Map the layout signals",
    boardLead: "Use each hint to decide whether the platform layout can guide teams without guesswork.",
    guideLabel: "Map guide",
    currentLabel: "Current signal",
    targetLabel: "Operated signal",
    moveLabel: "Layout consequence",
  },
  semantic: {
    boardLabel: "Metric diagnosis",
    boardHeading: "Diagnose the metric layers",
    boardLead: "Use each hint to spot where definitions, ownership, and trust can drift.",
    guideLabel: "Diagnosis guide",
    currentLabel: "Current symptom",
    targetLabel: "Healthy evidence",
    moveLabel: "Metric consequence",
  },
  recovery: {
    boardLabel: "Recovery drill",
    boardHeading: "Run the recovery drill",
    boardLead: "Use each hint to test whether the platform can recover under real pressure.",
    guideLabel: "Runbook guide",
    currentLabel: "Current drill step",
    targetLabel: "Operated runbook",
    moveLabel: "Recovery consequence",
  },
} as const;
const journeyIdentity = journeyIdentityByTheme[definition.experience.theme];
---

<BaseLayout
  title={`${definition.title} | XHVERSE`}
  description={definition.description}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: definition.title,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    description: definition.description,
  }}
>
  <div class="min-h-screen bg-[var(--bg-page)] font-sans text-[var(--text)]">
    <Header current="/tools" />
    <main
      class="practitioner-tool-root mx-auto max-w-7xl px-5 py-6 sm:px-8 sm:py-8 lg:px-10"
      data-practitioner-tool-root
      data-tool-slug={definition.slug}
      data-tool-theme={definition.experience.theme}
    >
      <section class="grid gap-10 py-10 sm:py-14 lg:grid-cols-[0.95fr_1.05fr]">
        <div>
          <p class="text-[12px] uppercase tracking-[0.32em] text-[var(--tool-accent-text)]">
            {definition.kicker}
          </p>
          <h1 class="mt-4 max-w-4xl text-[2.45rem] font-semibold leading-[0.98] tracking-tight text-white sm:text-[4.1rem]">
            {definition.title}
          </h1>
          <p class="mt-6 max-w-2xl text-base leading-8 text-zinc-300 sm:text-lg">
            {definition.description}
          </p>
          <div class="mt-7 border border-[color:var(--tool-accent-muted)] bg-[var(--tool-accent-soft)] p-4 text-sm leading-7 text-zinc-300">
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[var(--tool-accent-text)]">
              {definition.experience.modeLabel}
            </p>
            <p class="mt-2">{definition.experience.openingSignal}</p>
            <p class="mt-3 text-xs leading-6 text-zinc-500">
              Directional planning only. Do not paste confidential platform, customer, credential, or incident details.
            </p>
          </div>
        </div>

        <aside class="border border-white/10 bg-white/[0.03] p-5 sm:p-6">
          <p class="text-[11px] uppercase tracking-[0.24em] text-zinc-500">What this produces</p>
          <div class="mt-5 grid gap-3">
            {definition.experience.outputCards.map((card) => (
              <div class="border border-white/10 bg-black/20 p-4">
                <h2 class="text-base font-semibold tracking-tight text-white">{card.title}</h2>
                <p class="mt-2 text-sm leading-6 text-zinc-400">{card.description}</p>
              </div>
            ))}
          </div>
        </aside>
      </section>

      <section class="grid min-w-0 gap-8 border-t border-white/10 py-10 lg:grid-cols-[minmax(0,1fr)_22rem]">
        <div class="min-w-0 space-y-6">
          <div class="border border-white/10 bg-white/[0.03] p-5 sm:p-6">
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Assessment</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white">
              {definition.experience.assessmentHeading}
            </h2>
            <p class="mt-4 text-sm leading-7 text-zinc-400">
              {definition.experience.assessmentLead}
            </p>
          </div>

          <nav
            class="journey-board min-w-0 overflow-hidden border border-white/10 bg-white/[0.03] p-4 sm:p-5"
            aria-label={`${definition.title} decision path`}
            data-testid="journey-board"
          >
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="text-[11px] uppercase tracking-[0.24em] text-zinc-500">{journeyIdentity.boardLabel}</p>
                <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">{journeyIdentity.boardHeading}</h2>
              </div>
              <p class="text-xs leading-5 text-zinc-500">
                {journeyIdentity.boardLead}
              </p>
            </div>
            <ol class="mt-5 grid gap-2 sm:grid-cols-2 xl:grid-cols-3">
              {definition.questions.map((question, index) => (
                <li>
                  <button
                    type="button"
                    class="journey-step block min-h-24 w-full border border-white/10 bg-black/20 p-3 text-left transition hover:border-[color:var(--tool-accent-muted)] hover:bg-[var(--tool-accent-soft)] focus:outline-none focus-visible:border-[color:var(--tool-accent)] focus-visible:ring-2 focus-visible:ring-[var(--tool-accent-muted)]"
                    data-journey-step
                    data-step-index={index}
                    aria-controls={`question-${question.id}`}
                    aria-label={`Checkpoint ${index + 1}, ${question.dimension}, open`}
                  >
                    <span class="flex items-center justify-between gap-3 text-[11px] uppercase tracking-[0.2em] text-zinc-500">
                      <span>{String(index + 1).padStart(2, "0")}</span>
                      <span data-step-status>Open</span>
                    </span>
                    <span class="mt-3 block text-sm font-semibold leading-5 text-white">
                      {question.dimension}
                    </span>
                  </button>
                </li>
              ))}
            </ol>
          </nav>

          <form id="practitioner-tool-form" class="min-w-0 space-y-5" data-testid="practitioner-tool-form" novalidate>
            {definition.questions.map((question, index) => (
              <fieldset
                id={`question-${question.id}`}
                class="practitioner-question min-w-0 border border-white/10 bg-white/[0.03] p-5 sm:p-6"
                data-question-id={question.id}
                data-step-index={index}
                tabindex="-1"
              >
                <legend class="text-sm font-semibold text-[var(--tool-accent-text)]">
                  {String(index + 1).padStart(2, "0")} · {question.dimension}
                </legend>
                <h3 class="mt-3 text-xl font-semibold tracking-tight text-white">{question.prompt}</h3>
                <p id={`question-${question.id}-help`} class="mt-2 text-sm leading-6 text-zinc-400">
                  {question.helpText}
                </p>
                <div class="mt-4 grid gap-3 border border-[color:var(--tool-accent-muted)] bg-[var(--tool-accent-soft)] p-4 text-sm leading-6 sm:grid-cols-[0.78fr_1.22fr]">
                  <div>
                    <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[var(--tool-accent-text)]">
                      Hint
                    </p>
                    <p class="mt-2 text-zinc-300">{question.helpText}</p>
                  </div>
                  <div>
                    <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[var(--tool-accent-text)]">
                      Best-result move
                    </p>
                    <p class="mt-2 text-zinc-300">{question.actions[4]}</p>
                  </div>
                </div>
                <div class="mt-5 grid gap-2 sm:grid-cols-4">
                  {question.options.map((option) => (
                    <label class="block min-h-24 cursor-pointer break-words border border-white/10 bg-black/20 p-3 transition has-[:checked]:border-[color:var(--tool-accent)] has-[:checked]:bg-[var(--tool-accent-soft)]">
                      <input
                        class="peer sr-only"
                        type="radio"
                        name={question.id}
                        value={option.value}
                        required
                        aria-describedby={`question-${question.id}-help question-${question.id}-error`}
                        data-testid={`answer-${question.id}-${option.value}`}
                      />
                      <span class="block text-sm font-semibold text-white">{option.value}. {option.label}</span>
                      <span class="mt-1 block text-xs leading-5 text-zinc-500 peer-checked:text-zinc-300">
                        {option.description}
                      </span>
                    </label>
                  ))}
                </div>
                <p
                  id={`question-${question.id}-error`}
                  class="mt-3 hidden text-sm leading-6 text-rose-200"
                  data-question-error
                >
                  Choose one option for {question.dimension}.
                </p>
                <div
                  class="mt-4 border border-white/10 bg-black/20 p-4"
                  aria-live="polite"
                  data-selected-consequence
                >
                  <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-zinc-500">
                    {journeyIdentity.moveLabel}
                  </p>
                  <p class="mt-2 text-sm leading-6 text-zinc-400" data-selected-consequence-text>
                    Choose a level to see what this decision means for the brief.
                  </p>
                </div>
              </fieldset>
            ))}

            <div class="journey-controls gap-3 border border-white/10 bg-white/[0.03] p-3 sm:grid-cols-[auto_1fr_auto] sm:items-center sm:justify-between">
              <button type="button" class="cta-secondary w-full sm:w-auto" data-journey-prev>
                Previous
              </button>
              <p class="text-center text-xs font-medium uppercase tracking-[0.22em] text-zinc-500" data-journey-step-label>
                Checkpoint 1 of {definition.questions.length}
              </p>
              <button type="button" class="cta-primary w-full sm:w-auto" data-journey-next>
                Next checkpoint
              </button>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row">
              <button type="submit" class="cta-primary">Generate brief</button>
              <button id="reset-button" type="button" class="cta-secondary">Reset</button>
            </div>
            <p
              id="form-status"
              class="hidden border border-rose-300/30 bg-rose-300/10 p-3 text-sm leading-6 text-rose-100"
              data-testid="form-status"
              role="alert"
            ></p>
          </form>
        </div>

        <aside class="h-fit min-w-0 space-y-5 lg:sticky lg:top-6">
          <div class="journey-guide border border-white/10 bg-white/[0.03] p-5 text-sm leading-7 text-zinc-400" data-testid="journey-guide">
            <p class="text-[11px] uppercase tracking-[0.24em] text-zinc-500">{journeyIdentity.guideLabel}</p>
            <div class="mt-4 flex items-center justify-between gap-3">
              <p id="journey-progress" class="font-medium text-white" data-testid="journey-progress">
                0/{definition.questions.length} checkpoints locked
              </p>
              <p id="journey-current-score" class="text-xs uppercase tracking-[0.18em] text-[var(--tool-accent-text)]">
                Current: 0/100
              </p>
            </div>
            <div class="mt-3 h-2 overflow-hidden bg-white/10" aria-hidden="true">
              <div id="journey-progress-bar" class="h-full w-0 bg-[var(--tool-accent)] transition-all"></div>
            </div>
            <div class="mt-5 border border-[color:var(--tool-accent-muted)] bg-[var(--tool-accent-soft)] p-4">
              <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[var(--tool-accent-text)]">
                {journeyIdentity.currentLabel}
              </p>
              <h2 id="journey-active-dimension" class="mt-2 text-lg font-semibold tracking-tight text-white">
                {definition.questions[0]?.dimension}
              </h2>
              <p id="journey-active-hint" class="mt-3 text-sm leading-6 text-zinc-300">
                {definition.questions[0]?.helpText}
              </p>
            </div>
            <div class="mt-4">
              <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-zinc-500">
                {journeyIdentity.targetLabel}
              </p>
              <p id="journey-best-move" class="mt-2 text-sm leading-6 text-zinc-300">
                {definition.questions[0]?.actions[4]}
              </p>
            </div>
            <div class="mt-4 border-t border-white/10 pt-4">
              <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-zinc-500">
                Your move
              </p>
              <p id="journey-selected-move" class="mt-2 text-sm leading-6 text-zinc-400">
                Pick an operating level to lock this checkpoint.
              </p>
            </div>
          </div>

          <div class="border border-white/10 bg-white/[0.03] p-5 text-sm leading-7 text-zinc-400">
            <p class="text-[11px] uppercase tracking-[0.24em] text-zinc-500">Blog sync</p>
            <p class="mt-4">
              This tool extends the thinking in
              <a href={definition.blogSync.href} class="text-link font-medium">{definition.blogSync.title}</a>.
            </p>
            <a href={definition.serviceCta.href} class="text-link mt-5 inline-flex text-sm font-medium">
              {definition.serviceCta.label} →
            </a>
          </div>
        </aside>
      </section>

      <section id="result-panel" class="hidden border-t border-white/10 py-10" data-testid="result-panel" aria-live="polite">
        <div class="grid gap-6 lg:grid-cols-[1fr_0.9fr]">
          <div class="space-y-6">
            <div class="border border-white/10 bg-white/[0.03] p-5 sm:p-6">
              <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">
                {definition.experience.resultLabel}
              </p>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <div class="border border-white/10 bg-black/20 p-5">
                  <p class="text-sm text-zinc-500">Overall score</p>
                  <p id="tool-score" class="mt-2 text-5xl font-semibold tracking-tight text-white">0/100</p>
                </div>
                <div class="border border-white/10 bg-black/20 p-5">
                  <p class="text-sm text-zinc-500">Tier</p>
                  <p id="tool-tier" class="mt-2 text-2xl font-semibold tracking-tight text-[var(--tool-accent-text)]"></p>
                </div>
              </div>
              <p id="tool-summary" class="mt-5 text-sm leading-7 text-zinc-400"></p>
            </div>

            <div class="border border-white/10 bg-white/[0.03] p-5 sm:p-6">
              <h2 class="text-xl font-semibold tracking-tight text-white">Dimension breakdown</h2>
              <div id="dimension-breakdown" class="mt-4 grid gap-3"></div>
            </div>

            <div class="grid gap-6 lg:grid-cols-2">
              <div class="border border-white/10 bg-white/[0.03] p-5 sm:p-6">
                <h2 class="text-xl font-semibold tracking-tight text-white">Gaps</h2>
                <div id="gap-list" class="mt-4 space-y-3"></div>
              </div>
              <div class="border border-white/10 bg-white/[0.03] p-5 sm:p-6">
                <h2 class="text-xl font-semibold tracking-tight text-white">Strengths</h2>
                <div id="strength-list" class="mt-4 space-y-3"></div>
              </div>
            </div>
          </div>

          <div class="space-y-6">
            <div class="border border-white/10 bg-white/[0.03] p-5 sm:p-6">
              <h2 class="text-xl font-semibold tracking-tight text-white">Recommended actions</h2>
              <ol id="action-list" class="mt-4 space-y-3"></ol>
            </div>

            <div class="border border-white/10 bg-white/[0.03] p-5 sm:p-6">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Brief</p>
                  <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">{definition.artifactLabel}</h2>
                </div>
                <button id="copy-brief" type="button" class="cta-secondary px-4 py-2">Copy brief</button>
              </div>
              <textarea
                id="tool-brief"
                readonly
                data-testid="tool-brief"
                class="mt-4 min-h-[24rem] w-full resize-y border border-white/10 bg-black/30 p-4 font-mono text-xs leading-6 text-zinc-300 outline-none"
              ></textarea>
              <p id="copy-status" class="mt-3 text-xs text-zinc-500"></p>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>

  <style>
    .practitioner-tool-root {
      --tool-accent: #34d399;
      --tool-accent-text: #a7f3d0;
      --tool-accent-muted: rgba(52, 211, 153, 0.38);
      --tool-accent-soft: rgba(52, 211, 153, 0.08);
    }

    .practitioner-tool-root[data-tool-theme="access"] {
      --tool-accent: #38bdf8;
      --tool-accent-text: #bae6fd;
      --tool-accent-muted: rgba(56, 189, 248, 0.38);
      --tool-accent-soft: rgba(56, 189, 248, 0.08);
    }

    .practitioner-tool-root[data-tool-theme="layout"] {
      --tool-accent: #fbbf24;
      --tool-accent-text: #fde68a;
      --tool-accent-muted: rgba(251, 191, 36, 0.38);
      --tool-accent-soft: rgba(251, 191, 36, 0.08);
    }

    .practitioner-tool-root[data-tool-theme="semantic"] {
      --tool-accent: #c4b5fd;
      --tool-accent-text: #ddd6fe;
      --tool-accent-muted: rgba(196, 181, 253, 0.4);
      --tool-accent-soft: rgba(196, 181, 253, 0.08);
    }

    .practitioner-tool-root[data-tool-theme="recovery"] {
      --tool-accent: #fb7185;
      --tool-accent-text: #fecdd3;
      --tool-accent-muted: rgba(251, 113, 133, 0.4);
      --tool-accent-soft: rgba(251, 113, 133, 0.08);
    }

    html.light .practitioner-tool-root {
      --tool-accent: #059669;
      --tool-accent-text: #047857;
      --tool-accent-muted: rgba(5, 150, 105, 0.34);
      --tool-accent-soft: rgba(5, 150, 105, 0.08);
    }

    html.light .practitioner-tool-root[data-tool-theme="access"] {
      --tool-accent: #0284c7;
      --tool-accent-text: #0369a1;
      --tool-accent-muted: rgba(2, 132, 199, 0.32);
      --tool-accent-soft: rgba(2, 132, 199, 0.07);
    }

    html.light .practitioner-tool-root[data-tool-theme="layout"] {
      --tool-accent: #d97706;
      --tool-accent-text: #b45309;
      --tool-accent-muted: rgba(217, 119, 6, 0.34);
      --tool-accent-soft: rgba(217, 119, 6, 0.08);
    }

    html.light .practitioner-tool-root[data-tool-theme="semantic"] {
      --tool-accent: #7c3aed;
      --tool-accent-text: #6d28d9;
      --tool-accent-muted: rgba(124, 58, 237, 0.32);
      --tool-accent-soft: rgba(124, 58, 237, 0.07);
    }

    html.light .practitioner-tool-root[data-tool-theme="recovery"] {
      --tool-accent: #e11d48;
      --tool-accent-text: #be123c;
      --tool-accent-muted: rgba(225, 29, 72, 0.32);
      --tool-accent-soft: rgba(225, 29, 72, 0.07);
    }

    .practitioner-question {
      scroll-margin-top: 5rem;
    }

    .practitioner-tool-root[data-journey-enhanced="true"] .journey-board ol {
      scroll-padding-inline: 0.75rem;
    }

    .journey-controls {
      display: none;
    }

    .practitioner-tool-root[data-journey-enhanced="true"] .journey-controls {
      display: grid;
    }

    .journey-step[data-current="true"] {
      border-color: var(--tool-accent);
      background-color: var(--tool-accent-soft);
    }

    .journey-step[data-status="risk"] [data-step-status] {
      color: #fecdd3;
    }

    .journey-step[data-status="watch"] [data-step-status] {
      color: #fde68a;
    }

    .journey-step[data-status="ready"] [data-step-status] {
      color: var(--tool-accent-text);
    }

    .journey-step[data-current="true"] [data-step-status],
    .journey-step[data-status="ready"] {
      border-color: var(--tool-accent-muted);
    }

    @media (max-width: 639px) {
      .practitioner-tool-root[data-journey-enhanced="true"] .journey-board ol {
        display: flex;
        overflow-x: auto;
        padding-bottom: 0.5rem;
        scroll-snap-type: x proximity;
      }

      .practitioner-tool-root[data-journey-enhanced="true"] .journey-board li {
        min-width: min(15rem, 78vw);
        scroll-snap-align: start;
      }
    }

    .practitioner-question:focus {
      outline: 2px solid var(--tool-accent-muted);
      outline-offset: 3px;
    }

    .practitioner-question[data-invalid="true"] {
      border-color: rgba(251, 113, 133, 0.65);
      background-color: rgba(251, 113, 133, 0.06);
    }

    .practitioner-question label:has(input:focus-visible) {
      border-color: var(--tool-accent);
      outline: 2px solid var(--tool-accent-muted);
      outline-offset: 3px;
    }

    html.light .practitioner-question[data-invalid="true"] {
      border-color: rgba(225, 29, 72, 0.38);
      background-color: rgba(225, 29, 72, 0.06);
    }

    .practitioner-text-block {
      border-left: 2px solid var(--tool-accent-muted);
      padding-left: 0.75rem;
    }

    html.light .practitioner-tool-root .text-rose-100,
    html.light .practitioner-tool-root .text-rose-200 {
      color: #be123c;
    }
  </style>

  <script>
    import {
      getPractitionerToolDefinition,
    } from "../../lib/practitioner-tools/definitions";
    import {
      buildPractitionerToolBrief,
      calculatePractitionerToolResult,
      isAnswerValue,
    } from "../../lib/practitioner-tools/engine";
    import type {
      AnswerValue,
      ToolAnswers,
      ToolQuestion,
      ToolQuestionResult,
    } from "../../lib/practitioner-tools/types";

    function toAnswerValue(value: FormDataEntryValue | null): AnswerValue | null {
      const parsed = Number(value);
      return Number.isInteger(parsed) && isAnswerValue(parsed) ? parsed : null;
    }

    function makeTextBlock(title: string, body: string): HTMLElement {
      const wrapper = document.createElement("div");
      wrapper.className = "practitioner-text-block";

      const heading = document.createElement("p");
      heading.className = "text-sm font-semibold text-white";
      heading.textContent = title;

      const paragraph = document.createElement("p");
      paragraph.className = "mt-1 text-sm leading-6 text-zinc-400";
      paragraph.textContent = body;

      wrapper.append(heading, paragraph);
      return wrapper;
    }

    function makeEmptyBlock(text: string): HTMLElement {
      const paragraph = document.createElement("p");
      paragraph.className = "text-sm leading-6 text-zinc-400";
      paragraph.textContent = text;
      return paragraph;
    }

    function isRadioInput(target: EventTarget | null): target is HTMLInputElement {
      return target instanceof HTMLInputElement && target.type === "radio";
    }

    function initPractitionerToolPage(): void {
      const root = document.querySelector<HTMLElement>("[data-practitioner-tool-root]");
      if (!root || root.dataset.practitionerToolReady === "true") return;

      const definition = root.dataset.toolSlug
        ? getPractitionerToolDefinition(root.dataset.toolSlug)
        : undefined;
      const form = root.querySelector<HTMLFormElement>("#practitioner-tool-form");
      const resultPanel = root.querySelector<HTMLElement>("#result-panel");
      const resetButton = root.querySelector<HTMLButtonElement>("#reset-button");
      const copyButton = root.querySelector<HTMLButtonElement>("#copy-brief");
      const briefTextarea = root.querySelector<HTMLTextAreaElement>("#tool-brief");
      const copyStatus = root.querySelector<HTMLElement>("#copy-status");
      const formStatus = root.querySelector<HTMLElement>("#form-status");
      const journeySteps = [...root.querySelectorAll<HTMLButtonElement>("[data-journey-step]")];
      const questionFieldsets = [...root.querySelectorAll<HTMLElement>("[data-question-id]")];
      const previousButton = root.querySelector<HTMLButtonElement>("[data-journey-prev]");
      const nextButton = root.querySelector<HTMLButtonElement>("[data-journey-next]");
      const stepLabel = root.querySelector<HTMLElement>("[data-journey-step-label]");
      const progressText = root.querySelector<HTMLElement>("#journey-progress");
      const progressBar = root.querySelector<HTMLElement>("#journey-progress-bar");
      const currentScore = root.querySelector<HTMLElement>("#journey-current-score");
      const activeDimension = root.querySelector<HTMLElement>("#journey-active-dimension");
      const activeHint = root.querySelector<HTMLElement>("#journey-active-hint");
      const bestMove = root.querySelector<HTMLElement>("#journey-best-move");
      const selectedMove = root.querySelector<HTMLElement>("#journey-selected-move");

      if (!definition || !form) return;
      const toolRoot = root;
      const toolDefinition = definition;
      const toolForm = form;
      const totalQuestions = toolDefinition.questions.length;
      let activeQuestionIndex = 0;

      toolRoot.dataset.practitionerToolReady = "true";
      toolRoot.dataset.journeyEnhanced = "true";

      function setText(selector: string, value: string): void {
        const element = toolRoot.querySelector<HTMLElement>(selector);
        if (element) element.textContent = value;
      }

      function getScrollBehavior(): ScrollBehavior {
        return "auto";
      }

      function getQuestionFieldset(questionId: string): HTMLElement | null {
        return questionFieldsets.find((fieldset) => fieldset.dataset.questionId === questionId) ?? null;
      }

      function getQuestionRadios(questionId: string): HTMLInputElement[] {
        const fieldset = getQuestionFieldset(questionId);
        return fieldset ? [...fieldset.querySelectorAll<HTMLInputElement>('input[type="radio"]')] : [];
      }

      function readAnswers(): ToolAnswers {
        const formData = new FormData(toolForm);
        const answers: ToolAnswers = {};

        for (const question of toolDefinition.questions) {
          const answerValue = toAnswerValue(formData.get(question.id));
          if (answerValue !== null) answers[question.id] = answerValue;
        }

        return answers;
      }

      function getMissingQuestions(answers: ToolAnswers): ToolQuestion[] {
        return toolDefinition.questions.filter((question) => answers[question.id] === undefined);
      }

      function getQuestionIndex(questionId: string): number {
        return toolDefinition.questions.findIndex((question) => question.id === questionId);
      }

      function getQuestionMoveText(question: ToolQuestion, answers: ToolAnswers): string {
        const answerValue = answers[question.id];
        if (answerValue === undefined) {
          return "Pick an operating level to lock this checkpoint.";
        }

        const option = question.options.find((candidate) => candidate.value === answerValue);
        const label = option ? `${answerValue}. ${option.label}` : `${answerValue}`;
        return `${label}: ${question.actions[answerValue]}`;
      }

      function updateQuestionConsequences(answers: ToolAnswers): void {
        for (const question of toolDefinition.questions) {
          const fieldset = getQuestionFieldset(question.id);
          const consequence = fieldset?.querySelector<HTMLElement>("[data-selected-consequence-text]");
          if (consequence) consequence.textContent = getQuestionMoveText(question, answers);
        }
      }

      function getStepStatus(answerValue: AnswerValue | undefined, isCurrent: boolean): string {
        if (answerValue === undefined) return isCurrent ? "Here" : "Open";
        if (answerValue <= 2) return "Risk";
        if (answerValue === 3) return "Watch";
        return "Ready";
      }

      function getStepStatusKey(answerValue: AnswerValue | undefined): string {
        if (answerValue === undefined) return "open";
        if (answerValue <= 2) return "risk";
        if (answerValue === 3) return "watch";
        return "ready";
      }

      function updateJourneyState(): void {
        const answers = readAnswers();
        const answeredCount = toolDefinition.questions.filter(
          (question) => answers[question.id] !== undefined,
        ).length;
        const activeQuestion = toolDefinition.questions[activeQuestionIndex];
        const partialResult = calculatePractitionerToolResult(toolDefinition, answers);

        if (progressText) {
          progressText.textContent = `${answeredCount}/${totalQuestions} checkpoints locked`;
        }
        if (progressBar) {
          progressBar.style.width = `${(answeredCount / totalQuestions) * 100}%`;
        }
        if (currentScore) {
          currentScore.textContent = `Current: ${partialResult.score}/100`;
        }
        if (previousButton) {
          previousButton.disabled = activeQuestionIndex === 0;
        }
        if (nextButton) {
          nextButton.textContent =
            activeQuestionIndex === totalQuestions - 1 ? "Finish journey" : "Next checkpoint";
        }
        if (stepLabel) {
          stepLabel.textContent = `Checkpoint ${activeQuestionIndex + 1} of ${totalQuestions}`;
        }

        if (activeQuestion) {
          if (activeDimension) activeDimension.textContent = activeQuestion.dimension;
          if (activeHint) activeHint.textContent = activeQuestion.helpText;
          if (bestMove) bestMove.textContent = activeQuestion.actions[4];
          if (selectedMove) selectedMove.textContent = getQuestionMoveText(activeQuestion, answers);
        }

        updateQuestionConsequences(answers);

        journeySteps.forEach((step, index) => {
          const question = toolDefinition.questions[index];
          const isCurrent = index === activeQuestionIndex;
          const answerValue = question ? answers[question.id] : undefined;
          const status = getStepStatus(answerValue, isCurrent);
          const statusElement = step.querySelector<HTMLElement>("[data-step-status]");

          step.dataset.current = isCurrent ? "true" : "false";
          step.dataset.status = getStepStatusKey(answerValue);
          if (isCurrent) {
            step.setAttribute("aria-current", "step");
          } else {
            step.removeAttribute("aria-current");
          }
          if (question) {
            step.setAttribute(
              "aria-label",
              `Checkpoint ${index + 1}, ${question.dimension}, ${status}`,
            );
          }
          if (statusElement) statusElement.textContent = status;
        });
      }

      function setActiveQuestion(index: number, shouldFocus: boolean): void {
        const nextIndex = Math.min(Math.max(index, 0), totalQuestions - 1);
        activeQuestionIndex = nextIndex;

        questionFieldsets.forEach((fieldset, fieldsetIndex) => {
          const isActive = fieldsetIndex === activeQuestionIndex;
          fieldset.hidden = !isActive;
          if (isActive) {
            fieldset.removeAttribute("aria-hidden");
          } else {
            fieldset.setAttribute("aria-hidden", "true");
          }
        });

        updateJourneyState();

        if (!shouldFocus) return;
        const fieldset = questionFieldsets[activeQuestionIndex];
        fieldset?.focus({ preventScroll: true });
        fieldset?.scrollIntoView({ block: "start", behavior: getScrollBehavior() });
      }

      function clearQuestionValidation(questionId: string): void {
        const fieldset = getQuestionFieldset(questionId);
        if (!fieldset) return;

        delete fieldset.dataset.invalid;
        const error = fieldset.querySelector<HTMLElement>("[data-question-error]");
        error?.classList.add("hidden");

        for (const input of getQuestionRadios(questionId)) {
          input.removeAttribute("aria-invalid");
        }
      }

      function clearValidation(): void {
        formStatus?.classList.add("hidden");
        if (formStatus) formStatus.textContent = "";

        for (const question of toolDefinition.questions) {
          clearQuestionValidation(question.id);
        }
      }

      function showValidation(missingQuestions: ToolQuestion[]): void {
        const remainingLabel = missingQuestions.length === 1 ? "dimension still needs" : "dimensions still need";

        if (formStatus) {
          formStatus.textContent = `${missingQuestions.length} ${remainingLabel} an answer before the brief can be generated. Your current selections are still preserved.`;
          formStatus.classList.remove("hidden");
        }

        for (const question of missingQuestions) {
          const fieldset = getQuestionFieldset(question.id);
          if (!fieldset) continue;

          fieldset.dataset.invalid = "true";
          const error = fieldset.querySelector<HTMLElement>("[data-question-error]");
          error?.classList.remove("hidden");

          for (const input of getQuestionRadios(question.id)) {
            input.setAttribute("aria-invalid", "true");
          }
        }

        const firstMissing = getQuestionFieldset(missingQuestions[0]?.id ?? "");
        const firstMissingIndex = getQuestionIndex(missingQuestions[0]?.id ?? "");
        if (firstMissingIndex >= 0) setActiveQuestion(firstMissingIndex, false);
        firstMissing?.focus({ preventScroll: true });
        firstMissing?.scrollIntoView({ block: "center", behavior: getScrollBehavior() });
      }

      function renderBreakdown(items: ToolQuestionResult[]): void {
        const breakdown = toolRoot.querySelector<HTMLElement>("#dimension-breakdown");
        if (!breakdown) return;

        const blocks = items.map((item) => {
          const wrapper = document.createElement("div");
          wrapper.className = "border border-white/10 bg-black/20 p-3";

          const header = document.createElement("div");
          header.className = "flex items-center justify-between gap-3 text-sm";

          const label = document.createElement("span");
          label.className = "font-medium text-zinc-200";
          label.textContent = item.dimension;

          const score = document.createElement("span");
          score.className = "text-zinc-500";
          score.textContent = `${item.score}/100`;

          const answer = document.createElement("p");
          answer.className = "mt-2 text-xs leading-5 text-zinc-500";
          answer.textContent = item.answerLabel ?? "Not answered";

          header.append(label, score);
          wrapper.append(header, answer);
          return wrapper;
        });

        breakdown.replaceChildren(...blocks);
      }

      function renderTextList(selector: string, items: ToolQuestionResult[], emptyText: string): void {
        const container = toolRoot.querySelector<HTMLElement>(selector);
        if (!container) return;

        if (items.length === 0) {
          container.replaceChildren(makeEmptyBlock(emptyText));
          return;
        }

        container.replaceChildren(
          ...items.map((item) => makeTextBlock(item.dimension, item.action)),
        );
      }

      function renderActions(actions: string[]): void {
        const actionList = toolRoot.querySelector<HTMLOListElement>("#action-list");
        if (!actionList) return;

        const items = actions.map((action) => {
          const item = document.createElement("li");
          item.className = "border border-white/10 bg-black/20 p-3 text-sm leading-7 text-zinc-300";
          item.textContent = action;
          return item;
        });

        actionList.replaceChildren(...items);
      }

      toolForm.addEventListener("change", (event) => {
        if (!isRadioInput(event.target)) return;
        clearQuestionValidation(event.target.name);
        if (getMissingQuestions(readAnswers()).length === 0) {
          formStatus?.classList.add("hidden");
        }
        updateJourneyState();
      });

      toolForm.addEventListener("submit", (event) => {
        event.preventDefault();

        const answers = readAnswers();
        const missingQuestions = getMissingQuestions(answers);

        clearValidation();
        if (missingQuestions.length > 0) {
          resultPanel?.classList.add("hidden");
          showValidation(missingQuestions);
          return;
        }

        const result = calculatePractitionerToolResult(toolDefinition, answers);
        setText("#tool-score", `${result.score}/100`);
        setText("#tool-tier", result.tier.label);
        setText("#tool-summary", result.tier.summary);
        renderBreakdown(result.questionResults);
        renderTextList("#gap-list", result.gaps, "No critical gaps identified.");
        renderTextList("#strength-list", result.strengths, "No operated strengths selected yet.");
        renderActions(result.priorityActions);

        if (briefTextarea) {
          briefTextarea.value = buildPractitionerToolBrief(toolDefinition, result);
        }

        resultPanel?.classList.remove("hidden");
        resultPanel?.scrollIntoView({ block: "start", behavior: getScrollBehavior() });
      });

      journeySteps.forEach((step) => {
        step.addEventListener("click", () => {
          const stepIndex = Number(step.dataset.stepIndex);
          if (!Number.isInteger(stepIndex)) return;
          setActiveQuestion(stepIndex, true);
        });
      });

      previousButton?.addEventListener("click", () => {
        setActiveQuestion(activeQuestionIndex - 1, true);
      });

      nextButton?.addEventListener("click", () => {
        const currentQuestion = toolDefinition.questions[activeQuestionIndex];
        if (!currentQuestion) return;
        const answers = readAnswers();

        clearQuestionValidation(currentQuestion.id);
        if (answers[currentQuestion.id] === undefined) {
          resultPanel?.classList.add("hidden");
          showValidation([currentQuestion]);
          return;
        }

        if (activeQuestionIndex < totalQuestions - 1) {
          setActiveQuestion(activeQuestionIndex + 1, true);
          return;
        }

        toolForm.requestSubmit();
      });

      resetButton?.addEventListener("click", () => {
        toolForm.reset();
        clearValidation();
        resultPanel?.classList.add("hidden");
        if (briefTextarea) briefTextarea.value = "";
        if (copyStatus) copyStatus.textContent = "";
        setActiveQuestion(0, false);
        window.scrollTo({ top: 0, behavior: getScrollBehavior() });
      });

      copyButton?.addEventListener("click", async () => {
        if (!briefTextarea) return;
        briefTextarea.select();
        try {
          await navigator.clipboard.writeText(briefTextarea.value);
          if (copyStatus) copyStatus.textContent = "Brief copied.";
        } catch {
          if (copyStatus) copyStatus.textContent = "Select the brief text and copy it from your browser.";
        }
      });

      setActiveQuestion(0, false);
    }

    initPractitionerToolPage();
    document.addEventListener("astro:page-load", initPractitionerToolPage);
  </script>
</BaseLayout>
