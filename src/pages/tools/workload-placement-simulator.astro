---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import {
  dataShapeOptions,
  freshnessOptions,
  governanceOptions,
  platformEstateOptions,
  pressureOptions,
  scaleOptions,
  workloadIntentOptions,
} from "../../lib/workload-placement-simulator/placement";

const toolDescription =
  "Compare Databricks, Fabric, and Power BI placement paths for a workload. Get a directional recommendation, runners-up, and review warnings.";
---

<BaseLayout
  title="Workload Placement Simulator | XHVERSE"
  description={toolDescription}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Workload Placement Simulator",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    description: toolDescription,
  }}
>
  <div class="min-h-screen bg-[var(--bg-page)] font-sans text-[var(--text)]" data-placement-simulator>
    <Header current="/tools" />
    <main class="mx-auto max-w-7xl px-5 py-6 sm:px-8 sm:py-8 lg:px-10">
      <section class="grid gap-10 py-10 sm:py-14 lg:grid-cols-[0.92fr_1.08fr]">
        <div>
          <p class="text-[12px] uppercase tracking-[0.32em] text-emerald-200">
            Architecture tool
          </p>
          <h1 class="mt-4 max-w-4xl text-[2.45rem] font-semibold leading-[0.98] tracking-tight text-white sm:text-[4.1rem]">
            Workload Placement Simulator
          </h1>
          <p class="mt-6 max-w-2xl text-base leading-8 text-zinc-300 sm:text-lg">
            Decide where a workload should run before tuning compute, table
            layout, semantic models, access, or recovery.
          </p>
          <div class="mt-7 border border-emerald-300/20 bg-emerald-300/8 p-4 text-sm leading-7 text-zinc-300">
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-emerald-200">
              Directional placement review
            </p>
            <p class="mt-2">
              Use this when Databricks, Fabric, and Power BI are all plausible
              homes for part of the same workload. The output is a review brief,
              not a vendor sizing guarantee.
            </p>
            <p class="mt-3 text-xs leading-6 text-zinc-500">
              Do not paste confidential platform, customer, credential, or incident details.
            </p>
          </div>
        </div>

        <aside class="border border-white/10 bg-white/[0.03] p-5 sm:p-6">
          <p class="text-[11px] uppercase tracking-[0.24em] text-zinc-500">
            What this produces
          </p>
          <div class="mt-5 grid gap-3">
            <div class="border border-white/10 bg-black/20 p-4">
              <h2 class="text-base font-semibold tracking-tight text-white">
                Recommended home
              </h2>
              <p class="mt-2 text-sm leading-6 text-zinc-400">
                A top placement path with a placement signal and the evidence that drove it.
              </p>
            </div>
            <div class="border border-white/10 bg-black/20 p-4">
              <h2 class="text-base font-semibold tracking-tight text-white">
                Runners-up
              </h2>
              <p class="mt-2 text-sm leading-6 text-zinc-400">
                Three alternatives so the decision is framed as trade-off, not default tooling.
              </p>
            </div>
            <div class="border border-white/10 bg-black/20 p-4">
              <h2 class="text-base font-semibold tracking-tight text-white">
                Review brief
              </h2>
              <p class="mt-2 text-sm leading-6 text-zinc-400">
                A copyable summary for platform review, architecture notes, or advisory follow-up.
              </p>
            </div>
          </div>
        </aside>
      </section>

      <section class="grid min-w-0 gap-8 border-t border-white/10 py-10 lg:grid-cols-[minmax(0,1fr)_24rem]">
        <form id="placement-form" class="min-w-0 space-y-5" data-testid="placement-form">
          <div class="border border-white/10 bg-white/[0.03] p-5 sm:p-6">
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">
              Scenario
            </p>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-3xl">
              Describe the workload shape.
            </h2>
            <p class="mt-4 text-sm leading-7 text-zinc-400">
              Pick the strongest signal for each dimension. The simulator ranks
              placement paths by fit and flags review risks before a team commits
              to a runtime.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block min-w-0 border border-white/10 bg-white/[0.03] p-4">
              <span class="block text-sm font-semibold text-white">Workload intent</span>
              <select
                id="intent"
                name="intent"
                data-description-target="intent-description"
                class="mt-3 w-full border border-white/10 bg-black/30 px-3 py-2.5 text-sm text-zinc-300 outline-none transition focus:border-emerald-300/50"
              >
                {workloadIntentOptions.map((option) => (
                  <option value={option.value} data-description={option.description}>{option.label}</option>
                ))}
              </select>
              <span id="intent-description" class="mt-2 block text-xs leading-5 text-zinc-500">
                {workloadIntentOptions[0].description}
              </span>
            </label>

            <label class="block min-w-0 border border-white/10 bg-white/[0.03] p-4">
              <span class="block text-sm font-semibold text-white">Platform estate</span>
              <select
                id="estate"
                name="estate"
                data-description-target="estate-description"
                class="mt-3 w-full border border-white/10 bg-black/30 px-3 py-2.5 text-sm text-zinc-300 outline-none transition focus:border-emerald-300/50"
              >
                {platformEstateOptions.map((option) => (
                  <option value={option.value} data-description={option.description}>{option.label}</option>
                ))}
              </select>
              <span id="estate-description" class="mt-2 block text-xs leading-5 text-zinc-500">
                {platformEstateOptions[0].description}
              </span>
            </label>

            <label class="block min-w-0 border border-white/10 bg-white/[0.03] p-4">
              <span class="block text-sm font-semibold text-white">Data shape</span>
              <select
                id="data-shape"
                name="dataShape"
                data-description-target="data-shape-description"
                class="mt-3 w-full border border-white/10 bg-black/30 px-3 py-2.5 text-sm text-zinc-300 outline-none transition focus:border-emerald-300/50"
              >
                {dataShapeOptions.map((option) => (
                  <option value={option.value} data-description={option.description}>{option.label}</option>
                ))}
              </select>
              <span id="data-shape-description" class="mt-2 block text-xs leading-5 text-zinc-500">
                {dataShapeOptions[0].description}
              </span>
            </label>

            <label class="block min-w-0 border border-white/10 bg-white/[0.03] p-4">
              <span class="block text-sm font-semibold text-white">Freshness</span>
              <select
                id="freshness"
                name="freshness"
                data-description-target="freshness-description"
                class="mt-3 w-full border border-white/10 bg-black/30 px-3 py-2.5 text-sm text-zinc-300 outline-none transition focus:border-emerald-300/50"
              >
                {freshnessOptions.map((option) => (
                  <option value={option.value} data-description={option.description}>{option.label}</option>
                ))}
              </select>
              <span id="freshness-description" class="mt-2 block text-xs leading-5 text-zinc-500">
                {freshnessOptions[0].description}
              </span>
            </label>

            <label class="block min-w-0 border border-white/10 bg-white/[0.03] p-4">
              <span class="block text-sm font-semibold text-white">Scale</span>
              <select
                id="scale"
                name="scale"
                data-description-target="scale-description"
                class="mt-3 w-full border border-white/10 bg-black/30 px-3 py-2.5 text-sm text-zinc-300 outline-none transition focus:border-emerald-300/50"
              >
                {scaleOptions.map((option) => (
                  <option value={option.value} data-description={option.description}>{option.label}</option>
                ))}
              </select>
              <span id="scale-description" class="mt-2 block text-xs leading-5 text-zinc-500">
                {scaleOptions[0].description}
              </span>
            </label>

            <label class="block min-w-0 border border-white/10 bg-white/[0.03] p-4">
              <span class="block text-sm font-semibold text-white">Governance</span>
              <select
                id="governance"
                name="governance"
                data-description-target="governance-description"
                class="mt-3 w-full border border-white/10 bg-black/30 px-3 py-2.5 text-sm text-zinc-300 outline-none transition focus:border-emerald-300/50"
              >
                {governanceOptions.map((option) => (
                  <option value={option.value} data-description={option.description}>{option.label}</option>
                ))}
              </select>
              <span id="governance-description" class="mt-2 block text-xs leading-5 text-zinc-500">
                {governanceOptions[0].description}
              </span>
            </label>

            <label class="block min-w-0 border border-white/10 bg-white/[0.03] p-4 sm:col-span-2">
              <span class="block text-sm font-semibold text-white">Dominant pressure</span>
              <select
                id="pressure"
                name="pressure"
                data-description-target="pressure-description"
                class="mt-3 w-full border border-white/10 bg-black/30 px-3 py-2.5 text-sm text-zinc-300 outline-none transition focus:border-emerald-300/50"
              >
                {pressureOptions.map((option) => (
                  <option value={option.value} data-description={option.description}>{option.label}</option>
                ))}
              </select>
              <span id="pressure-description" class="mt-2 block text-xs leading-5 text-zinc-500">
                {pressureOptions[0].description}
              </span>
            </label>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row">
            <button type="submit" class="cta-primary">Simulate placement</button>
            <button id="reset-button" type="button" class="cta-secondary">Reset</button>
          </div>
        </form>

        <aside class="h-fit min-w-0 space-y-5 lg:sticky lg:top-6">
          <div class="border border-white/10 bg-white/[0.03] p-5 text-sm leading-7 text-zinc-400">
            <p class="text-[11px] uppercase tracking-[0.24em] text-zinc-500">
              Reference boundaries
            </p>
            <ul class="mt-4 space-y-3">
              <li>
                <a class="text-link external-link" href="https://learn.microsoft.com/en-us/fabric/enterprise/licenses" target="_blank" rel="noreferrer">
                  Fabric capacity and license model
                </a>
              </li>
              <li>
                <a class="text-link external-link" href="https://learn.microsoft.com/en-us/fabric/fundamentals/direct-lake-overview" target="_blank" rel="noreferrer">
                  Direct Lake behavior
                </a>
              </li>
              <li>
                <a class="text-link external-link" href="https://learn.microsoft.com/en-us/azure/databricks/compute/serverless/" target="_blank" rel="noreferrer">
                  Azure Databricks serverless compute
                </a>
              </li>
              <li>
                <a class="text-link external-link" href="https://learn.microsoft.com/en-us/azure/databricks/admin/usage/budget-policies" target="_blank" rel="noreferrer">
                  Serverless usage policies
                </a>
              </li>
              <li>
                <a class="text-link external-link" href="https://learn.microsoft.com/en-us/power-bi/connect-data/desktop-directquery-about" target="_blank" rel="noreferrer">
                  Power BI DirectQuery behavior
                </a>
              </li>
            </ul>
          </div>
          <div class="border border-white/10 bg-white/[0.03] p-5 text-sm leading-7 text-zinc-400">
            <p class="text-[11px] uppercase tracking-[0.24em] text-zinc-500">
              Related tools
            </p>
            <div class="mt-4 space-y-3">
              <a class="block text-link" href="/tools/lakehouse-cost-calculator">
                Lakehouse Cost Calculator
              </a>
              <a class="block text-link" href="/tools/access-model-simulator">
                Access Model Simulator
              </a>
              <a class="block text-link" href="/tools/power-bi-semantic-model-doctor">
                Power BI Semantic Model Doctor
              </a>
            </div>
          </div>
        </aside>
      </section>

      <section
        id="result-panel"
        class="hidden border-t border-white/10 py-10"
        aria-live="polite"
        tabindex="-1"
        data-testid="placement-result"
      >
        <div class="grid min-w-0 gap-6 lg:grid-cols-[1fr_0.95fr]">
          <div class="min-w-0 space-y-6">
            <div class="border border-emerald-300/25 bg-emerald-300/8 p-5 sm:p-6">
              <p class="text-[12px] uppercase tracking-[0.32em] text-emerald-200">
                Top recommendation
              </p>
              <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div class="min-w-0">
                  <h2 id="top-label" class="text-2xl font-semibold tracking-tight text-white"></h2>
                  <p id="top-summary" class="mt-3 text-sm leading-7 text-zinc-300"></p>
                  <p id="top-source-note" class="mt-3 border-l border-emerald-300/30 pl-3 text-xs leading-6 text-zinc-400"></p>
                </div>
                <div class="shrink-0 border border-white/10 bg-black/25 p-4 text-center">
                  <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Placement signal</p>
                  <p id="top-score" class="mt-2 text-3xl font-semibold text-emerald-200"></p>
                  <p id="top-fit" class="mt-1 text-xs text-zinc-500"></p>
                </div>
              </div>
              <div class="mt-5 grid gap-4 md:grid-cols-2">
                <div class="min-w-0 border border-white/10 bg-black/20 p-4">
                  <h3 class="text-sm font-semibold text-white">Why this surfaced</h3>
                  <ul id="reason-list" class="mt-3 space-y-2 text-sm leading-6 text-zinc-400"></ul>
                </div>
                <div class="min-w-0 border border-white/10 bg-black/20 p-4">
                  <h3 class="text-sm font-semibold text-white">Watchouts</h3>
                  <ul id="warning-list" class="mt-3 space-y-2 text-sm leading-6 text-zinc-400"></ul>
                </div>
              </div>
            </div>

            <div class="border border-white/10 bg-white/[0.03] p-5 sm:p-6">
              <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">
                Runners-up
              </p>
              <div id="runner-list" class="mt-4 grid gap-3"></div>
            </div>
          </div>

          <div class="min-w-0 border border-white/10 bg-white/[0.03] p-5 sm:p-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">
                  Review brief
                </p>
                <h2 class="mt-2 text-xl font-semibold tracking-tight text-white">
                  Copyable summary
                </h2>
              </div>
              <button id="copy-brief" type="button" class="cta-secondary px-4 py-2">
                Copy brief
              </button>
            </div>
            <textarea
              id="brief-textarea"
              readonly
              class="mt-4 min-h-[28rem] w-full resize-y border border-white/10 bg-black/30 p-4 font-mono text-xs leading-6 text-zinc-300 outline-none"
              data-testid="placement-brief"
            ></textarea>
            <p id="copy-status" class="mt-3 text-xs text-zinc-500"></p>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>

  <script>
    import {
      buildWorkloadPlacementBrief,
      evaluateWorkloadPlacement,
      type DataShape,
      type FreshnessNeed,
      type GovernanceLevel,
      type PlacementScore,
      type PlatformEstate,
      type PlacementPressure,
      type WorkloadIntent,
      type WorkloadPlacementInput,
      type WorkloadScale,
    } from "../../lib/workload-placement-simulator/placement";

    function initWorkloadPlacementSimulator(): void {
      const page = document.querySelector<HTMLElement>("[data-placement-simulator]");
      if (!page || page.dataset.placementReady === "true") return;
      const root = page;

      const form = root.querySelector<HTMLFormElement>("#placement-form");
      if (!form) return;

      root.dataset.placementReady = "true";

      const resetButton = root.querySelector<HTMLButtonElement>("#reset-button");
      const copyButton = root.querySelector<HTMLButtonElement>("#copy-brief");
      const resultPanel = root.querySelector<HTMLElement>("#result-panel");
      const briefTextarea = root.querySelector<HTMLTextAreaElement>("#brief-textarea");
      const copyStatus = root.querySelector<HTMLElement>("#copy-status");
      const runnerList = root.querySelector<HTMLElement>("#runner-list");
      const reasonList = root.querySelector<HTMLElement>("#reason-list");
      const warningList = root.querySelector<HTMLElement>("#warning-list");
      const descriptionSelects = Array.from(
        form.querySelectorAll<HTMLSelectElement>("select[data-description-target]"),
      );
      const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

      function scrollBehavior(): ScrollBehavior {
        return reducedMotionQuery.matches ? "auto" : "smooth";
      }

      function getFormValue<T extends string>(formData: FormData, name: string): T {
        const value = formData.get(name);
        return (typeof value === "string" ? value : "") as T;
      }

      function setText(selector: string, value: string): void {
        const element = root.querySelector<HTMLElement>(selector);
        if (element) element.textContent = value;
      }

      function renderItems(container: HTMLElement | null, items: string[]): void {
        if (!container) return;
        const elements = items.map((item) => {
          const li = document.createElement("li");
          li.textContent = item;
          return li;
        });
        container.replaceChildren(...elements);
      }

      function syncSelectDescription(select: HTMLSelectElement): void {
        const targetId = select.dataset.descriptionTarget;
        if (!targetId) return;

        const target = root.querySelector<HTMLElement>(`#${targetId}`);
        const selectedOption = select.selectedOptions.item(0);
        const description = selectedOption?.dataset.description;
        if (target && description) target.textContent = description;
      }

      function syncAllSelectDescriptions(): void {
        for (const select of descriptionSelects) syncSelectDescription(select);
      }

      function createRunnerCard(placement: PlacementScore): HTMLElement {
        const card = document.createElement("div");
        card.className = "min-w-0 border border-white/10 bg-black/20 p-4";

        const header = document.createElement("div");
        header.className = "flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between";

        const titleWrap = document.createElement("div");
        titleWrap.className = "min-w-0";

        const title = document.createElement("h3");
        title.className = "text-base font-semibold tracking-tight text-white";
        title.textContent = placement.candidate.label;

        const platform = document.createElement("p");
        platform.className = "mt-1 text-xs uppercase tracking-[0.2em] text-zinc-500";
        platform.textContent = placement.candidate.platform;

        const score = document.createElement("p");
        score.className = "shrink-0 text-sm font-semibold text-emerald-200";
        score.textContent = `${placement.score}/100 signal`;

        const summary = document.createElement("p");
        summary.className = "mt-3 text-sm leading-6 text-zinc-400";
        summary.textContent = placement.candidate.summary;

        titleWrap.append(title, platform);
        header.append(titleWrap, score);
        card.append(header, summary);
        return card;
      }

      function inputFromForm(formData: FormData): WorkloadPlacementInput {
        return {
          intent: getFormValue<WorkloadIntent>(formData, "intent"),
          estate: getFormValue<PlatformEstate>(formData, "estate"),
          dataShape: getFormValue<DataShape>(formData, "dataShape"),
          freshness: getFormValue<FreshnessNeed>(formData, "freshness"),
          scale: getFormValue<WorkloadScale>(formData, "scale"),
          governance: getFormValue<GovernanceLevel>(formData, "governance"),
          pressure: getFormValue<PlacementPressure>(formData, "pressure"),
        };
      }

      for (const select of descriptionSelects) {
        select.addEventListener("change", () => syncSelectDescription(select));
      }
      syncAllSelectDescriptions();

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const result = evaluateWorkloadPlacement(inputFromForm(new FormData(form)));
        const top = result.topRecommendation;

        setText("#top-label", top.candidate.label);
        setText("#top-summary", top.candidate.summary);
        setText("#top-source-note", `Platform boundary: ${top.candidate.sourceNote}`);
        setText("#top-score", `${top.score}/100`);
        setText("#top-fit", top.fit);
        renderItems(reasonList, top.reasons);
        renderItems(
          warningList,
          result.reviewWarnings.length > 0
            ? result.reviewWarnings
            : ["No critical placement warnings from this directional pass."],
        );

        const runnerCards = result.runnersUp.map(createRunnerCard);
        runnerList?.replaceChildren(...runnerCards);

        if (briefTextarea) briefTextarea.value = buildWorkloadPlacementBrief(result);
        if (copyStatus) copyStatus.textContent = "";
        resultPanel?.classList.remove("hidden");
        resultPanel?.focus();
        resultPanel?.scrollIntoView({ block: "start", behavior: scrollBehavior() });
      });

      resetButton?.addEventListener("click", () => {
        form.reset();
        syncAllSelectDescriptions();
        resultPanel?.classList.add("hidden");
        if (briefTextarea) briefTextarea.value = "";
        if (copyStatus) copyStatus.textContent = "";
        window.scrollTo({ top: 0, behavior: scrollBehavior() });
      });

      copyButton?.addEventListener("click", async () => {
        if (!briefTextarea) return;
        briefTextarea.select();
        try {
          await navigator.clipboard.writeText(briefTextarea.value);
          if (copyStatus) copyStatus.textContent = "Brief copied.";
        } catch {
          if (copyStatus) {
            copyStatus.textContent = "Select the brief text and copy it from your browser.";
          }
        }
      });
    }

    initWorkloadPlacementSimulator();
    document.addEventListener("astro:page-load", initWorkloadPlacementSimulator);
  </script>
</BaseLayout>
