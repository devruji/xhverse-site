---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../data/profile";
import { site } from "../data/site";

const deploymentSite = (Astro.site ?? site.siteUrl).toString();
const aboutUrl = new URL("/about", deploymentSite).toString();
---

<BaseLayout
  title={`About ${profile.fullName}`}
  description={profile.longBio}
  image={profile.avatar}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": `${aboutUrl}#about-page`,
    name: `About ${profile.fullName} (XH / bossruji)`,
    alternateName: ["About XH", "About bossruji", "About xhverse"],
    url: aboutUrl,
    mainEntity: {
      "@type": "Person",
      "@id": `${deploymentSite}#person`,
      name: profile.fullName,
      alternateName: profile.alternateNames,
      additionalName: ["XH", "bossruji"],
      url: deploymentSite,
      description: profile.longBio,
      image: new URL(profile.avatar, deploymentSite).toString(),
      email: profile.email,
      knowsAbout: profile.knowsAbout,
      sameAs: [site.github, site.medium, site.linkedin],
    },
  }}
>
  <div class="min-h-screen bg-[#070809] font-sans text-zinc-100">
  <Header current="/about" />
  <main>
    <div class="mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-20 lg:px-10">
      <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">About</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl lg:text-5xl">
        {profile.title}
      </h1>
      <p class="mt-2 text-sm font-medium uppercase tracking-[0.22em] text-emerald-200">
        {profile.fullName} · XH / bossruji
      </p>

      <div class="mt-12 grid gap-12 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="space-y-8">
          <section>
            <h2 class="text-xl font-semibold text-white">Platform direction</h2>
            <p class="mt-3 leading-relaxed text-zinc-300">{profile.longBio}</p>
          </section>

          <section>
            <h2 class="text-xl font-semibold text-white">Architecture statement</h2>
            <blockquote class="mt-3 border-l-2 border-emerald-300/40 pl-4 text-zinc-300 italic">
              {profile.bio}
            </blockquote>
          </section>
        </div>

        <aside class="space-y-6 lg:self-start">
          <div class="border border-white/10 bg-white/[0.03] p-5 sm:p-6">
            <img
              src={profile.avatar}
              alt={profile.fullName}
              width="960"
              height="960"
              class="aspect-square w-24 rounded-full object-cover"
              loading="eager"
            />
            <h3 class="mt-4 text-lg font-semibold text-white">{profile.name}</h3>
            <p class="mt-1 text-sm text-zinc-400">{profile.title}</p>
            <p class="mt-3 text-sm leading-relaxed text-zinc-400">{profile.bio}</p>
          </div>

          <div class="border border-white/10 bg-white/[0.03] p-5 sm:p-6">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-500">Connect</h3>
            <div class="mt-3 flex flex-col gap-2 text-sm">
              <a href={site.github} target="_blank" rel="noreferrer" class="text-zinc-300 transition hover:text-white">GitHub ↗</a>
              <a href={site.linkedin} target="_blank" rel="noreferrer" class="text-zinc-300 transition hover:text-white">LinkedIn ↗</a>
              <a href={site.medium} target="_blank" rel="noreferrer" class="text-zinc-300 transition hover:text-white">Medium ↗</a>
              <a href={`mailto:${site.email}`} class="text-zinc-300 transition hover:text-white">{site.email}</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <Footer />
  </div>
</BaseLayout>
