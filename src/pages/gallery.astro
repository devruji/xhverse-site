---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { items } from "../data/gallery";
import { site } from "../data/site";

const deploymentSite = (Astro.site ?? site.siteUrl).toString();
---

<BaseLayout
  title="Gallery"
  description="Visual fragments, references, and collected frames from the XHVERSE archive."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "XHVERSE Gallery",
    url: new URL("/gallery", deploymentSite).toString(),
    description:
      "Visual fragments, references, and collected frames from the XHVERSE archive.",
  }}
>
  <div class="min-h-screen bg-[var(--bg-page)] font-sans text-[var(--text)]">
  <Header current="/gallery" />
  <main>
    <div class="mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-20 lg:px-10">
      <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Archive</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">Gallery</h1>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((item, index) => (
          <figure class="overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03]">
            <img
              src={item.src}
              alt={item.alt}
              width={item.width}
              height={item.height}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              class="w-full object-cover"
            />
            <figcaption class="px-4 py-3 text-sm text-zinc-400">{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </main>
  <Footer />
  </div>
</BaseLayout>
