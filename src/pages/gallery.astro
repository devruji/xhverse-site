---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { items } from "../data/gallery";
import { site } from "../data/site";

const deploymentSite = (Astro.site ?? site.siteUrl).toString();
---

<BaseLayout
  title="Gallery"
  description="Visual fragments, references, and collected frames from the XHVERSE archive."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "XHVERSE Gallery",
    url: new URL("/gallery", deploymentSite).toString(),
    description:
      "Visual fragments, references, and collected frames from the XHVERSE archive.",
  }}
>
  <div class="min-h-screen bg-[var(--bg-page)] font-sans text-[var(--text)]">
  <Header current="/gallery" />
  <main id="main-content">
    <div class="public-container public-section">
      <p class="public-kicker">Archive</p>
      <h1 class="public-heading mt-5">Gallery</h1>
      <p class="public-intro mt-5">A collection of images and references from the xhverse archive.</p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((item, index) => (
          <figure class="public-card overflow-hidden">
            <img
              src={item.src}
              alt={item.alt}
              width={item.width}
              height={item.height}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              class="w-full object-cover"
            />
            <figcaption class="px-5 py-4 text-base leading-7 text-[var(--muted)]">{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </main>
  <Footer />
  </div>
</BaseLayout>
