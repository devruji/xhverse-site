---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { posts as staticFallback } from "../../data/blog";
import { site } from "../../data/site";
import { profile } from "../../data/profile";
import { renderMarkdownToHtml } from "../../lib/render-markdown";
import {
  createSupabaseClientForBuild,
  loadPublishedPostsForBuild,
} from "../../lib/blog/load-posts";

export async function getStaticPaths() {
  const client = createSupabaseClientForBuild({
    SUPABASE_URL: import.meta.env.SUPABASE_URL,
    SUPABASE_SECRET_KEY: import.meta.env.SUPABASE_SECRET_KEY,
  });
  const allPosts = await loadPublishedPostsForBuild(client, staticFallback);
  return allPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const deploymentSite = (Astro.site ?? site.siteUrl).toString();
const canonicalUrl = new URL(`/blog/${post.slug}`, deploymentSite).toString();
const html = renderMarkdownToHtml(post.bodyMarkdown);

const articleStructuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": canonicalUrl,
  headline: post.title,
  description: post.excerpt,
  url: canonicalUrl,
  datePublished: post.date,
  dateModified: post.date,
  keywords: post.tags.join(", "),
  wordCount: post.bodyMarkdown.split(/\s+/).length,
  inLanguage: "en",
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  author: {
    "@type": "Person",
    "@id": `${deploymentSite}#person`,
    name: profile.fullName,
    url: deploymentSite,
  },
  publisher: {
    "@type": "Person",
    "@id": `${deploymentSite}#person`,
    name: profile.fullName,
    image: new URL(profile.avatar, deploymentSite).toString(),
  },
  image: new URL(site.ogImage, deploymentSite).toString(),
  ...(post.mediumUrl ? { sameAs: post.mediumUrl } : {}),
};
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  type="article"
  structuredData={articleStructuredData}
>
  <div class="min-h-screen bg-[var(--bg-page)] font-sans text-[var(--text)]">
  <div class="reading-progress"></div>
  <Header current="/blog" />
  <main>
    <div class="mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-20 lg:px-10">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-xs text-zinc-500 transition hover:text-white">
        ← Writing hub
      </a>

      <h1 class="mt-6 text-3xl font-semibold tracking-tight text-white sm:text-4xl lg:text-[2.75rem]">
        {post.title}
      </h1>

      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-zinc-500">
        <time>{post.date}</time>
        <span>·</span>
        <span>{post.readingTime}</span>
        {post.tags.length > 0 && (
          <>
            <span>·</span>
            <div class="flex gap-2">
              {post.tags.map((tag) => (
                <span class="rounded-full border border-white/10 px-2.5 py-0.5 text-[11px]">{tag}</span>
              ))}
            </div>
          </>
        )}
      </div>

      {post.mediumUrl && (
        <p class="mt-3">
          <a href={post.mediumUrl} target="_blank" rel="noreferrer" class="text-sm text-zinc-500 underline underline-offset-2 transition hover:text-white">
            Also on Medium ↗
          </a>
        </p>
      )}

      <article class="article-body" set:html={html} />
    </div>
  </main>
  <Footer />
  </div>
</BaseLayout>
