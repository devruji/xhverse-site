---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { posts as staticFallback } from "../../data/blog";
import { site } from "../../data/site";
import { profile } from "../../data/profile";
import {
  createSupabaseClientForBuild,
  loadPublishedPostsForBuild,
} from "../../lib/blog/load-posts";

const client = createSupabaseClientForBuild({
  SUPABASE_URL: import.meta.env.SUPABASE_URL,
  SUPABASE_SECRET_KEY: import.meta.env.SUPABASE_SECRET_KEY,
});
const sortedPosts = await loadPublishedPostsForBuild(client, staticFallback);
const deploymentSite = (Astro.site ?? site.siteUrl).toString();
---

<BaseLayout
  title="Writing Hub"
  description="Essays and notes published on xhverse.co, with optional links to Medium when a piece is syndicated."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "XHVERSE Writing Hub",
    url: new URL("/blog", deploymentSite).toString(),
    description:
      "Writing from XHVERSE: full articles on xhverse.co, with optional Medium links.",
    hasPart: sortedPosts.map((post) => ({
      "@type": "BlogPosting",
      headline: post.title,
      datePublished: post.date,
      url: new URL(`/blog/${post.slug}`, deploymentSite).toString(),
      keywords: post.tags.join(", "),
      description: post.excerpt,
      author: { "@type": "Person", "@id": `${deploymentSite}#person`, name: profile.fullName },
      image: new URL(site.ogImage, deploymentSite).toString(),
    })),
  }}
>
  <div class="min-h-screen bg-[var(--bg-page)] font-sans text-[var(--text)]">
  <Header current="/blog" />
  <main>
    <div class="mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-20 lg:px-10">
      <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Writing hub</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl lg:text-5xl">
        Notes, essays, and ongoing thoughts.
      </h1>
      <p class="mt-4 max-w-xl text-sm leading-7 text-zinc-400">
        Full articles are published here on xhverse.co. When a piece is also on
        <a href={site.medium} target="_blank" rel="noreferrer" class="text-link external-link">Medium</a>, a
        second link is shown for readers who prefer that surface.
      </p>

      <div class="stagger-children animate-on-scroll mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {sortedPosts.map((post) => (
          <article class="relative">
            <a
              href={`/blog/${post.slug}`}
              aria-label={`Read article: ${post.title}`}
              class="interactive-card group flex min-h-full flex-col overflow-hidden rounded-2xl p-0"
            >
              {post.coverImageUrl ? (
                <img
                  src={post.coverImageUrl}
                  alt={post.coverImageAlt ?? ""}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/9] w-full border-b border-white/10 object-cover"
                />
              ) : null}
              <div class="flex flex-1 flex-col p-5 sm:p-6">
                <div class="mb-3 flex items-center gap-2 text-xs text-zinc-500">
                  <time>{post.date}</time>
                  <span>·</span>
                  <span>{post.readingTime}</span>
                </div>
                <h2 class="text-lg font-semibold leading-snug text-white">
                  {post.title}
                </h2>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-400">{post.excerpt}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {post.tags.map((tag) => (
                    <span class="rounded-full border border-white/10 px-2.5 py-0.5 text-[11px] text-zinc-500">{tag}</span>
                  ))}
                </div>
                <div class="mt-4 flex items-center gap-3 pr-24 text-sm">
                  <span class="link-cue font-medium">Read article →</span>
                </div>
              </div>
            </a>
            {post.mediumUrl ? (
              <a
                href={post.mediumUrl}
                target="_blank"
                rel="noreferrer"
                class="text-link external-link absolute bottom-5 left-[8.5rem] z-10 text-sm text-zinc-500 sm:bottom-6"
              >
                Medium
              </a>
            ) : null}
          </article>
        ))}
      </div>
    </div>
  </main>
  <Footer />
  </div>
</BaseLayout>
