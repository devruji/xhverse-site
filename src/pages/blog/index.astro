---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { posts as staticFallback } from "../../data/blog";
import { site } from "../../data/site";
import { profile } from "../../data/profile";
import {
  createSupabaseClientForBuild,
  loadPublishedPostsForBuild,
} from "../../lib/blog/load-posts";
import {
  buildCollectionPageJsonLd,
  getPersonId,
} from "../../lib/seo/structured-data";

const client = createSupabaseClientForBuild({
  SUPABASE_URL: import.meta.env.SUPABASE_URL,
  SUPABASE_SECRET_KEY: import.meta.env.SUPABASE_SECRET_KEY,
  PUBLIC_SUPABASE_PUBLISHABLE_KEY:
    import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY,
});
const sortedPosts = await loadPublishedPostsForBuild(client, staticFallback);
const deploymentSite = (Astro.site ?? site.siteUrl).toString();
const blogDescription =
  "Essays from Rujikorn Ngoensaard, also known as XH and bossruji, on data platform architecture, governance, lakehouse operations, and analytics delivery.";
const blogStructuredData = buildCollectionPageJsonLd({
  baseUrl: deploymentSite,
  path: "/blog",
  name: `XHVERSE writing by ${profile.fullName}`,
  alternateName: ["xhverse writing", "bossruji writing", "XH data architecture notes"],
  description: blogDescription,
  hasPart: sortedPosts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.title,
    datePublished: post.date,
    url: new URL(`/blog/${post.slug}`, deploymentSite).toString(),
    keywords: post.tags.join(", "),
    description: post.excerpt,
    author: { "@id": getPersonId(deploymentSite) },
    image: new URL(site.ogImage, deploymentSite).toString(),
  })),
});
---

<BaseLayout title={`Writing by ${profile.fullName}`} description={blogDescription} structuredData={blogStructuredData}>
  <Header current="/blog" />
  <main id="main-content" class="public-container public-section">
    <header class="writing-intro">
      <p class="public-kicker">Rujikorn Ngoensaard / XH · bossruji</p>
      <h1 class="public-heading">Writing</h1>
      <p class="public-intro">Practical notes from XH / bossruji on data platform architecture, governance, lakehouse operations, and analytics delivery.</p>
    </header>
    <div class="post-grid">
      {sortedPosts.map((post, index) => (
        <article class="post-card">
          <a href={`/blog/${post.slug}`} aria-label={`Read article: ${post.title}`} class="post-link">
            {post.coverImageUrl ? <img src={post.coverImageUrl} alt={post.coverImageAlt ?? ""} width="960" height="540" loading={index === 0 ? "eager" : "lazy"} decoding="async" /> : null}
            <div class="post-content">
              <div class="article-meta"><time datetime={post.date}>{post.date}</time><span>{post.readingTime}</span><span class="hidden" data-blog-view-wrapper><span>· </span><span data-blog-view-count={post.slug} aria-live="polite" aria-atomic="true" aria-busy="true">-- views</span></span></div>
              <h2>{post.title}</h2>
              <p class="excerpt">{post.excerpt}</p>
              <ul class="tags" aria-label="Topics">{post.tags.map((tag) => <li>{tag}</li>)}</ul>
              <span class="article-cue">Read article <span aria-hidden="true">↗</span></span>
            </div>
          </a>
          {post.mediumUrl ? <a href={post.mediumUrl} target="_blank" rel="noopener noreferrer" class="text-link external-link medium-link">Also on Medium</a> : null}
        </article>
      ))}
    </div>
  </main>
  <Footer />
  <script>import "../../scripts/blog-view-counts";</script>
</BaseLayout>
<style>
  .writing-intro { max-width: 780px; }
  h1 { margin-top: 24px; }
  .public-intro { margin-top: 24px; }
  .post-grid { display: grid; gap: 48px 32px; margin-top: 56px; }
  .post-card { min-width: 0; display: flex; flex-direction: column; }
  .post-link { display: flex; flex-direction: column; flex: 1; border-radius: 8px; }
  .post-link img { width: 100%; height: auto; aspect-ratio: 16/9; object-fit: contain; background: var(--bg-elevated); border-radius: 8px; }
  .post-content { display: flex; flex-direction: column; flex: 1; }
  .article-meta { display: flex; flex-wrap: wrap; gap: 12px; margin: 20px 0 14px; font: 12px var(--font-mono, monospace); color: var(--muted); }
  h2 { font-size: 24px; font-weight: 550; letter-spacing: -.025em; line-height: 1.35; color: var(--text-heading); }
  .excerpt { color: var(--muted); margin-top: 14px; line-height: 1.8; font-size: 16px; flex: 1; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px 16px; list-style: none; margin-top: 20px; padding: 0; color: var(--muted); font-size: 12px; }
  .article-cue { display: flex; justify-content: space-between; margin-top: 20px; color: var(--accent); text-decoration: underline; text-underline-offset: 5px; }
  .medium-link { align-self: flex-start; margin-top: 16px; font-size: 14px; }
  .post-link:hover h2 { color: var(--accent); }
  .post-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
  @media (min-width: 700px) { .post-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .post-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
