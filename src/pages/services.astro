---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../data/profile";
import { site } from "../data/site";
import { engagementTypes, processSteps, fitSignals, antiSignals } from "../data/services";
import { buildAdvisoryServiceJsonLd } from "../lib/seo/structured-data";
const deploymentSite = (Astro.site ?? site.siteUrl).toString();
---
<BaseLayout title="Advisory Services | XHVERSE" description="Data platform architecture advisory — architecture reviews, governance design, and platform strategy for enterprise teams working with Azure, Databricks, and Microsoft Fabric." structuredData={buildAdvisoryServiceJsonLd(deploymentSite)}>
  <Header current="/services" />
  <main id="main-content" class="public-container">
    <section class="public-section advisory-intro">
      <p class="public-kicker">Advisory</p>
      <h1>Data platform advisory.</h1>
      <p class="public-intro">I help enterprise teams review architecture, design governance, and make platform decisions across Azure, Databricks, and Microsoft Fabric.</p>
      <p class="availability">Available alongside my full-time enterprise work.</p>
      <a href="#contact" class="cta-primary">Discuss an engagement →</a>
    </section>
    <section id="engagements" class="public-section section-rule">
      <div class="section-heading"><p class="public-kicker">01 / Engagements</p><div><h2 class="public-heading">Choose the scope you need.</h2><p class="section-summary">Each engagement has a defined scope, working documents, and practical recommendations.</p></div></div>
      <div class="engagement-grid">{engagementTypes.map((engagement) => (
        <article class="public-card engagement-card"><p class="public-kicker">{engagement.duration}</p><h3>{engagement.title}</h3><p>{engagement.description}</p><div class="deliverables"><h4>Deliverables</h4><ul>{engagement.deliverables.map((deliverable) => <li>{deliverable}</li>)}</ul></div><p class="engagement-stack">{engagement.stack}</p></article>
      ))}</div>
    </section>
    <section id="process" class="public-section section-rule">
      <div class="section-heading"><p class="public-kicker">02 / Process</p><h2 class="public-heading">Scope, deliver, hand over.</h2></div>
      <div class="process-list">{processSteps.map((step) => <article><span class="step-number">{step.label}</span><h3>{step.title}</h3><p>{step.description}</p></article>)}</div>
    </section>
    <section id="fit" class="public-section section-rule fit-grid">
      <div><p class="public-kicker">Good fit</p><h2 class="fit-heading">When I can help.</h2><ul>{fitSignals.map((signal) => <li>{signal}</li>)}</ul></div>
      <div><p class="public-kicker">Boundaries</p><h2 class="fit-heading">When to look elsewhere.</h2><ul>{antiSignals.map((signal) => <li>{signal}</li>)}</ul></div>
    </section>
    <section id="contact" class="public-section section-rule contact-layout">
      <div><p class="public-kicker">Start here</p><h2 class="public-heading">Tell me about the decision.</h2><p class="section-summary">Send your platform context, the problem you need to solve, and the constraints. We can then discuss fit and scope.</p></div>
      <div class="contact-links"><a href={`mailto:${profile.email}?subject=Advisory%20Inquiry`} class="text-link">{profile.email}</a><a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="text-link external-link">Message me on LinkedIn</a></div>
    </section>
  </main>
  <Footer />
</BaseLayout>
<style>
  h1 { max-width: 14ch; margin: 24px 0; font-size: clamp(2.5rem, 6vw, 4.75rem); font-weight: 550; letter-spacing: -.05em; line-height: 1.06; color: var(--text-heading); }
  .advisory-intro .public-intro { max-width: 65ch; }
  .availability { margin: 24px 0; color: var(--muted); font-size: 14px; }
  .section-rule { border-top: 1px solid var(--border-subtle); }
  .section-heading { display: grid; gap: 20px; margin-bottom: 36px; }
  .section-summary { color: var(--muted); margin-top: 20px; max-width: 60ch; line-height: 1.8; }
  .engagement-grid { display: grid; gap: 20px; }
  .engagement-card { padding: 24px; display: flex; flex-direction: column; }
  h3 { margin: 16px 0; font-size: 24px; font-weight: 550; color: var(--text-heading); }
  .engagement-card p:not(.public-kicker), .process-list p { color: var(--muted); font-size: 16px; line-height: 1.8; }
  .deliverables { padding-top: 32px; margin-top: auto; }
  h4 { font-size: 14px; font-weight: 600; color: var(--text-heading); }
  ul { margin: 16px 0 0; padding-left: 20px; list-style: disc; }
  li { margin-top: 12px; color: var(--muted); line-height: 1.75; padding-left: 4px; }
  li::marker { color: var(--accent); }
  .engagement-stack { margin-top: 28px; font-size: 12px !important; }
  .process-list article { display: grid; gap: 12px; padding: 28px 0; border-top: 1px solid var(--border-subtle); }
  .process-list h3 { margin: 0; }
  .step-number { color: var(--muted); font: 12px var(--font-mono, monospace); }
  .fit-grid, .contact-layout { display: grid; gap: 40px; }
  .fit-heading { margin-top: 20px; font-size: 28px; letter-spacing: -.025em; color: var(--text-heading); }
  .contact-links { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; overflow-wrap: anywhere; }
  @media (min-width: 900px) { .section-heading { grid-template-columns: minmax(0, .45fr) minmax(0, 1fr); } .engagement-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .process-list article { grid-template-columns: 40px minmax(0, .5fr) minmax(0, 1fr); gap: 28px; } .fit-grid, .contact-layout { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px; } }
</style>
