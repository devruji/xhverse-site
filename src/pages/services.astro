---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../data/profile";
import { site } from "../data/site";
import {
  engagementTypes,
  processSteps,
  fitSignals,
  antiSignals,
} from "../data/services";

const deploymentSite = (Astro.site ?? site.siteUrl).toString();

const servicesStructuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Data Platform Advisory",
  description:
    "Architecture review, governance design, and platform strategy advisory for enterprise data teams working with Azure, Databricks, and Microsoft Fabric.",
  provider: {
    "@type": "Person",
    "@id": `${deploymentSite}#person`,
    name: profile.fullName,
    url: deploymentSite,
  },
  serviceType: "Consulting",
  areaServed: "Worldwide",
  url: `${deploymentSite}/services`,
};
---
<BaseLayout
  title="Advisory Services | XHVERSE"
  description="Data platform architecture advisory — architecture reviews, governance design, and platform strategy for enterprise teams working with Azure, Databricks, and Microsoft Fabric."
  structuredData={servicesStructuredData}
>
  <div class="min-h-screen bg-[var(--bg-page)] font-sans text-[var(--text)]">
    <Header
      current="/services"
      links={[
        { href: "#engagements", label: "Engagements" },
        { href: "#process", label: "Process" },
        { href: "#fit", label: "Fit" },
        { href: "#contact", label: "Start" },
      ]}
    />
    <main class="mx-auto max-w-7xl px-5 py-6 sm:px-8 sm:py-8 lg:px-10">

      <section class="hero-spotlight py-8 sm:py-12 lg:py-16">
        <div class="max-w-3xl">
          <div class="hero-entrance mb-4 flex flex-wrap gap-1.5">
            <span class="border border-emerald-300/25 bg-emerald-300/8 px-2.5 py-0.5 text-[10px] uppercase tracking-[0.22em] text-emerald-200">
              Advisory
            </span>
            <span class="border border-white/10 px-2.5 py-0.5 text-[10px] uppercase tracking-[0.22em] text-zinc-400">
              Architecture · Governance · Strategy
            </span>
          </div>
          <h1 class="hero-entrance-delayed text-[2.2rem] font-semibold leading-[1.05] tracking-tight text-white sm:text-[3.5rem]">
            Data Platform Advisory
          </h1>
          <p class="hero-entrance-delayed-2 mt-4 max-w-xl text-sm leading-relaxed text-zinc-300">
            Focused engagements for enterprise data teams navigating platform architecture,
            governance, and strategy decisions. Independent perspective — not a vendor pitch.
          </p>
          <p class="hero-entrance-delayed-2 mt-3 max-w-xl border-l border-emerald-300/35 pl-3 text-xs leading-6 text-zinc-400">
            Helping teams build platforms they can operate, evolve, and defend to stakeholders.
          </p>
          <p class="mt-3 text-xs text-zinc-500">Available for advisory engagements alongside full-time enterprise delivery.</p>
          <div class="hero-entrance-delayed-2 mt-6">
            <a href="#contact" class="cta-primary">
              Start a conversation
            </a>
          </div>
        </div>
      </section>

      <section id="engagements" class="animate-on-scroll border-t border-white/10 py-14 sm:py-20">
        <div class="mb-8 max-w-3xl">
          <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Engagement types</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            Structured advisory for complex platform decisions.
          </h2>
          <p class="mt-4 text-sm leading-7 text-zinc-400">
            Each engagement is scoped to a clear outcome. You get working documents and practical
            recommendations — not theoretical frameworks that collect dust.
          </p>
        </div>
        <div class="stagger-children animate-on-scroll grid gap-4 lg:grid-cols-3">
          {engagementTypes.map((engagement) => (
            <article class="static-card flex min-h-[28rem] flex-col p-5 sm:p-6">
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-xl font-semibold tracking-tight text-white">{engagement.title}</h3>
                <span class="shrink-0 text-right text-[11px] uppercase tracking-[0.16em] text-zinc-500">
                  {engagement.duration}
                </span>
              </div>
              <p class="mt-4 text-sm leading-7 text-zinc-400">{engagement.description}</p>
              <div class="mt-auto pt-6">
                <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Deliverables</p>
                <ul class="mt-3 space-y-2">
                  {engagement.deliverables.map((d) => (
                    <li class="border-l border-emerald-300/40 pl-3 text-sm leading-6 text-zinc-300">
                      {d}
                    </li>
                  ))}
                </ul>
              </div>
              <p class="mt-5 text-[11px] uppercase tracking-[0.16em] text-zinc-500">{engagement.stack}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="process" class="animate-on-scroll border-t border-white/10 py-14 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">How it works</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Clear scope. Focused delivery. Clean handover.
            </h2>
            <p class="mt-4 text-sm leading-7 text-zinc-400">
              Every engagement follows the same three-phase pattern — designed so your team
              can own and operate the outputs from day one.
            </p>
          </div>
          <div class="divide-y divide-white/10 border-y border-white/10">
            {processSteps.map((step) => (
              <div class="grid gap-4 py-5 sm:grid-cols-[4rem_1fr] sm:items-start">
                <span class="text-sm font-medium text-emerald-200">{step.label}</span>
                <div>
                  <h3 class="text-xl font-semibold tracking-tight text-white">{step.title}</h3>
                  <p class="mt-2 text-sm leading-7 text-zinc-400">{step.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="fit" class="animate-on-scroll border-t border-white/10 py-14 sm:py-20">
        <div class="grid gap-10 lg:grid-cols-2">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Good fit</p>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-3xl">
              This works well when…
            </h2>
            <ul class="mt-6 space-y-3">
              {fitSignals.map((signal) => (
                <li class="border-l border-emerald-300/40 pl-3 text-sm leading-7 text-zinc-300">
                  {signal}
                </li>
              ))}
            </ul>
          </div>
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Not the right fit</p>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-3xl">
              Probably not right if…
            </h2>
            <ul class="mt-6 space-y-3">
              {antiSignals.map((signal) => (
                <li class="border-l border-white/10 pl-3 text-sm leading-7 text-zinc-400">
                  {signal}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section id="contact" class="animate-on-scroll border-t border-white/10 py-14 sm:py-20">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Start</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Start with a conversation.
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-zinc-400">
              No forms, no sales process. Send a message describing your platform context and
              what you're trying to solve. If there's a good fit, we'll scope something together.
            </p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <a href={`mailto:${profile.email}?subject=Advisory%20Inquiry`} class="interactive-card group flex items-start gap-4 p-5">
              <img src="/images/icon_email.svg" alt="" width="28" height="28" class="mt-0.5 brightness-[0.4] invert transition group-hover:brightness-[0.6] group-hover:invert" />
              <div>
                <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Email</p>
                <p class="mt-2 break-all text-sm font-semibold text-white">{profile.email}</p>
                <p class="mt-1 text-xs text-zinc-500">Describe your platform context</p>
              </div>
            </a>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="interactive-card group flex items-start gap-4 p-5">
              <img src="/images/icon_linkedin.svg" alt="" width="28" height="28" class="mt-0.5 brightness-[0.4] invert transition group-hover:brightness-[0.6] group-hover:invert" />
              <div>
                <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">LinkedIn</p>
                <p class="mt-2 break-all text-sm font-semibold text-white">linkedin.com/in/rujikorn</p>
                <p class="mt-1 text-xs text-zinc-500">Connect and message directly</p>
              </div>
            </a>
          </div>
        </div>
      </section>

    </main>
    <Footer />
  </div>
</BaseLayout>
