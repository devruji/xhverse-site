---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Edit Post" activePage="blog">
  <div class="max-w-7xl">
    <a href="/admin/blog/" class="text-xs text-zinc-500 transition hover:text-white">Back to Blog Writer</a>
    <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Editor</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white">Edit post</h1>
      </div>
      <p id="post-save-state" class="text-sm text-zinc-500" aria-live="polite">Loading...</p>
    </div>

    <div id="post-form-error" class="mt-6 hidden border border-red-300/25 bg-red-300/8 p-4 text-sm text-red-200"></div>

    <form id="post-form" class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px]" novalidate>
      <section class="space-y-5">
        <label class="block"><span class="block text-[11px] uppercase tracking-[0.22em] text-zinc-500">Title</span><input id="post-title" required class="mt-2 min-h-11 w-full border border-white/15 bg-black/30 px-4 text-sm text-white outline-none transition focus:border-emerald-300/70" /></label>
        <label class="block"><span class="block text-[11px] uppercase tracking-[0.22em] text-zinc-500">Slug</span><input id="post-slug" required class="mt-2 min-h-11 w-full border border-white/15 bg-black/30 px-4 text-sm text-white outline-none transition focus:border-emerald-300/70" /></label>
        <label class="block"><span class="block text-[11px] uppercase tracking-[0.22em] text-zinc-500">Excerpt</span><textarea id="post-excerpt" rows="3" required class="mt-2 w-full border border-white/15 bg-black/30 px-4 py-3 text-sm leading-6 text-white outline-none transition focus:border-emerald-300/70"></textarea></label>
        <label class="block"><span class="block text-[11px] uppercase tracking-[0.22em] text-zinc-500">Body markdown</span><textarea id="post-body" rows="22" required class="mt-2 w-full border border-white/15 bg-black/30 px-4 py-3 font-mono text-sm leading-6 text-white outline-none transition focus:border-emerald-300/70"></textarea></label>
      </section>

      <aside class="space-y-5">
        <div class="border border-white/10 bg-white/[0.03] p-4">
          <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Publishing</p>
          <label class="mt-4 block"><span class="block text-xs text-zinc-400">Status</span><select id="post-status" class="mt-2 min-h-11 w-full border border-white/15 bg-black/30 px-3 text-sm text-white outline-none focus:border-emerald-300/70"><option value="draft">Draft</option><option value="published">Published</option></select></label>
          <label class="mt-4 block"><span class="block text-xs text-zinc-400">Publish date</span><input id="post-published-at" type="datetime-local" class="mt-2 min-h-11 w-full border border-white/15 bg-black/30 px-3 text-sm text-white outline-none focus:border-emerald-300/70" /></label>
          <div class="mt-5 grid gap-2">
            <button id="save-draft" type="button" class="min-h-11 border border-white/15 px-4 text-xs uppercase tracking-[0.18em] text-zinc-300 transition hover:border-white/30 hover:text-white">Save draft</button>
            <button id="publish-post" type="button" class="min-h-11 bg-white px-4 text-xs font-semibold uppercase tracking-[0.18em] text-black transition hover:bg-emerald-100">Publish</button>
            <button id="unpublish-post" type="button" class="min-h-11 border border-amber-300/30 px-4 text-xs uppercase tracking-[0.18em] text-amber-200 transition hover:bg-amber-300/10">Unpublish</button>
            <button id="delete-post" type="button" class="min-h-11 border border-red-300/30 px-4 text-xs uppercase tracking-[0.18em] text-red-200 transition hover:bg-red-300/10">Delete</button>
          </div>
        </div>

        <div class="border border-white/10 bg-white/[0.03] p-4">
          <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Metadata</p>
          <label class="mt-4 block"><span class="block text-xs text-zinc-400">Tags</span><input id="post-tags" class="mt-2 min-h-11 w-full border border-white/15 bg-black/30 px-3 text-sm text-white outline-none focus:border-emerald-300/70" /></label>
          <label class="mt-4 block"><span class="block text-xs text-zinc-400">Reading time</span><input id="post-reading-time" class="mt-2 min-h-11 w-full border border-white/15 bg-black/30 px-3 text-sm text-white outline-none focus:border-emerald-300/70" /></label>
          <label class="mt-4 flex items-center gap-2 text-sm text-zinc-400"><input id="post-reading-manual" type="checkbox" class="accent-emerald-300" /> Lock reading time</label>
          <label class="mt-4 block"><span class="block text-xs text-zinc-400">Medium URL</span><input id="post-medium-url" class="mt-2 min-h-11 w-full border border-white/15 bg-black/30 px-3 text-sm text-white outline-none focus:border-emerald-300/70" /></label>
          <div class="mt-4">
            <label class="block">
              <span class="block text-xs text-zinc-400">Cover image</span>
              <input id="post-cover-file" type="file" accept="image/avif,image/webp,image/jpeg,image/png" class="mt-2 w-full border border-white/15 bg-black/30 px-3 py-3 text-sm text-zinc-300 outline-none file:mr-3 file:border-0 file:bg-white file:px-3 file:py-2 file:text-xs file:font-semibold file:uppercase file:tracking-[0.16em] file:text-black focus:border-emerald-300/70" />
            </label>
            <img id="post-cover-preview" alt="" class="mt-3 hidden aspect-[16/9] w-full border border-white/10 object-cover" />
            <p id="post-cover-name" class="mt-2 text-xs text-zinc-500"></p>
            <button id="remove-cover" type="button" class="mt-3 hidden min-h-10 border border-red-300/25 px-3 text-xs uppercase tracking-[0.16em] text-red-200 transition hover:bg-red-300/10">Remove cover</button>
          </div>
          <label class="mt-4 block"><span class="block text-xs text-zinc-400">Cover image alt</span><input id="post-cover-alt" class="mt-2 min-h-11 w-full border border-white/15 bg-black/30 px-3 text-sm text-white outline-none focus:border-emerald-300/70" /></label>
          <label class="mt-4 block"><span class="block text-xs text-zinc-400">SEO title</span><input id="post-seo-title" class="mt-2 min-h-11 w-full border border-white/15 bg-black/30 px-3 text-sm text-white outline-none focus:border-emerald-300/70" /></label>
          <label class="mt-4 block"><span class="block text-xs text-zinc-400">SEO description</span><textarea id="post-seo-description" rows="3" class="mt-2 w-full border border-white/15 bg-black/30 px-3 py-2 text-sm leading-6 text-white outline-none focus:border-emerald-300/70"></textarea></label>
          <label class="mt-4 block"><span class="block text-xs text-zinc-400">Related tool CTAs</span><textarea id="post-related-tools" rows="3" class="mt-2 w-full border border-white/15 bg-black/30 px-3 py-2 font-mono text-xs leading-5 text-white outline-none focus:border-emerald-300/70" placeholder="lakehouse-cost-calculator:primary"></textarea></label>
        </div>
      </aside>
    </form>

    <section class="mt-8 border-t border-white/10 pt-8">
      <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Preview</p>
      <article id="post-preview" class="article-body"></article>
    </section>
  </div>

  <script>
    import { createAdminClient } from "../../../lib/admin/supabase";
    import {
      buildPostUpsertPayload,
      buildCoverImageObjectPath,
      estimateReadingTime,
      formValuesFromAdminPost,
      hasValidationErrors,
      isAllowedCoverImageMimeType,
      mapSupabasePostError,
      resolveCoverPathForSave,
      shouldDeleteCoverAfterSave,
      validateCoverFile,
      validatePostForm,
      type AdminPostRow,
      type PostFormValues,
      type PostSaveIntent,
      type PostStatus,
    } from "../../../lib/blog/admin-posts";
    import {
      BLOG_COVERS_BUCKET,
      blogCoverPublicUrl,
    } from "../../../data/supabase-config";
    import { renderMarkdownToHtml } from "../../../lib/render-markdown";

    const client = createAdminClient(import.meta.env);
    const postId = new URLSearchParams(window.location.search).get("id");
    const title = document.querySelector<HTMLInputElement>("#post-title");
    const slug = document.querySelector<HTMLInputElement>("#post-slug");
    const excerpt = document.querySelector<HTMLTextAreaElement>("#post-excerpt");
    const body = document.querySelector<HTMLTextAreaElement>("#post-body");
    const status = document.querySelector<HTMLSelectElement>("#post-status");
    const publishedAt = document.querySelector<HTMLInputElement>("#post-published-at");
    const tags = document.querySelector<HTMLInputElement>("#post-tags");
    const readingTime = document.querySelector<HTMLInputElement>("#post-reading-time");
    const readingManual = document.querySelector<HTMLInputElement>("#post-reading-manual");
    const mediumUrl = document.querySelector<HTMLInputElement>("#post-medium-url");
    const coverFile = document.querySelector<HTMLInputElement>("#post-cover-file");
    const coverPreview = document.querySelector<HTMLImageElement>("#post-cover-preview");
    const coverName = document.querySelector<HTMLElement>("#post-cover-name");
    const removeCover = document.querySelector<HTMLButtonElement>("#remove-cover");
    const coverAlt = document.querySelector<HTMLInputElement>("#post-cover-alt");
    const seoTitle = document.querySelector<HTMLInputElement>("#post-seo-title");
    const seoDescription = document.querySelector<HTMLTextAreaElement>("#post-seo-description");
    const relatedTools = document.querySelector<HTMLTextAreaElement>("#post-related-tools");
    const saveState = document.querySelector<HTMLElement>("#post-save-state");
    const errorBox = document.querySelector<HTMLElement>("#post-form-error");
    const preview = document.querySelector<HTMLElement>("#post-preview");
    let existingCoverPath = "";
    let existingPostStatus: PostStatus = "draft";
    let existingPublishedAt: string | null = null;
    let coverRemoved = false;
    let stagedCoverFile: File | null = null;
    let stagedPreviewUrl: string | null = null;

    function setState(message: string): void { if (saveState) saveState.textContent = message; }
    function showError(message: string): void { if (errorBox) { errorBox.textContent = message; errorBox.classList.remove("hidden"); } }
    function clearError(): void { if (errorBox) { errorBox.textContent = ""; errorBox.classList.add("hidden"); } }

    function setValues(values: PostFormValues): void {
      if (title) title.value = values.title;
      if (slug) slug.value = values.slug;
      if (excerpt) excerpt.value = values.excerpt;
      if (body) body.value = values.bodyMarkdown;
      if (status) status.value = values.status;
      if (publishedAt) publishedAt.value = values.publishedAt;
      if (tags) tags.value = values.tagsInput;
      if (readingTime) readingTime.value = values.readingTime;
      if (readingManual) readingManual.checked = values.readingTimeManual;
      if (mediumUrl) mediumUrl.value = values.mediumUrl;
      existingCoverPath = values.coverImagePath;
      coverRemoved = false;
      if (coverFile) coverFile.value = "";
      setCoverPreview(null);
      renderExistingCover();
      if (coverAlt) coverAlt.value = values.coverImageAlt;
      if (seoTitle) seoTitle.value = values.seoTitle;
      if (seoDescription) seoDescription.value = values.seoDescription;
      if (relatedTools) relatedTools.value = values.relatedToolCtasInput;
    }

    function values(): PostFormValues {
      return {
        title: title?.value ?? "",
        slug: slug?.value ?? "",
        excerpt: excerpt?.value ?? "",
        tagsInput: tags?.value ?? "",
        bodyMarkdown: body?.value ?? "",
        readingTime: readingTime?.value ?? "",
        readingTimeManual: Boolean(readingManual?.checked),
        mediumUrl: mediumUrl?.value ?? "",
        coverImagePath: resolveCoverPathForSave({
          existingPath: existingCoverPath,
          uploadedPath: null,
          coverRemoved,
        }),
        coverImageAlt: coverAlt?.value ?? "",
        coverRemoved,
        hasStagedCoverImage: Boolean(stagedCoverFile),
        seoTitle: seoTitle?.value ?? "",
        seoDescription: seoDescription?.value ?? "",
        relatedToolCtasInput: relatedTools?.value ?? "",
        status: (status?.value === "published" ? "published" : "draft") as PostStatus,
        publishedAt: publishedAt?.value ?? "",
      };
    }

    function updateRemoveCoverButton(): void {
      if (!removeCover) return;
      const hasCover = Boolean(existingCoverPath || stagedCoverFile);
      removeCover.classList.toggle("hidden", !hasCover);
    }

    function renderExistingCover(): void {
      if (!coverPreview || !coverName) return;
      if (!existingCoverPath || coverRemoved || stagedCoverFile) {
        if (!stagedCoverFile) {
          coverPreview.removeAttribute("src");
          coverPreview.classList.add("hidden");
          coverName.textContent = "";
        }
        updateRemoveCoverButton();
        return;
      }
      coverPreview.src = blogCoverPublicUrl(existingCoverPath, import.meta.env);
      coverPreview.classList.remove("hidden");
      coverName.textContent = existingCoverPath;
      updateRemoveCoverButton();
    }

    function setCoverPreview(file: File | null): void {
      if (stagedPreviewUrl) URL.revokeObjectURL(stagedPreviewUrl);
      stagedPreviewUrl = null;
      stagedCoverFile = file;
      if (!coverPreview || !coverName) return;
      if (!file) {
        renderExistingCover();
        return;
      }
      stagedPreviewUrl = URL.createObjectURL(file);
      coverPreview.src = stagedPreviewUrl;
      coverPreview.classList.remove("hidden");
      coverName.textContent = `${file.name} · ${Math.ceil(file.size / 1024)} KB`;
      coverRemoved = false;
      updateRemoveCoverButton();
    }

    async function removeStorageObjects(paths: string[]): Promise<void> {
      if (!client || paths.length === 0) return;
      await client.storage.from(BLOG_COVERS_BUCKET).remove(paths);
    }

    async function uploadStagedCover(slugValue: string): Promise<string | null> {
      if (!client || !stagedCoverFile) return null;
      if (!isAllowedCoverImageMimeType(stagedCoverFile.type)) {
        throw new Error("Cover image must be AVIF, WebP, JPEG, or PNG.");
      }
      const objectPath = buildCoverImageObjectPath(slugValue, stagedCoverFile.type);
      const { error } = await client.storage
        .from(BLOG_COVERS_BUCKET)
        .upload(objectPath, stagedCoverFile, {
          cacheControl: "31536000",
          contentType: stagedCoverFile.type,
          upsert: false,
        });
      if (error) throw new Error(error.message);
      return objectPath;
    }

    async function triggerRebuild(reason: string): Promise<string> {
      const response = await fetch("/admin/api/blog/rebuild", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ reason }),
      });
      const payload = (await response.json().catch(() => null)) as { message?: string } | null;
      return payload?.message ?? (response.ok ? "Cloudflare rebuild queued." : "Cloudflare rebuild unavailable.");
    }

    function isPublicPost(statusValue: PostStatus, publishedAtValue: string | null): boolean {
      if (statusValue !== "published" || !publishedAtValue) return false;
      const publishedAtTime = new Date(publishedAtValue).getTime();
      return Number.isFinite(publishedAtTime) && publishedAtTime <= Date.now();
    }

    async function rebuildMessageForMutation(options: {
      previousStatus: PostStatus;
      previousPublishedAt: string | null;
      nextStatus: PostStatus | null;
      nextPublishedAt: string | null;
      reason: string;
    }): Promise<string> {
      const wasPublic = isPublicPost(
        options.previousStatus,
        options.previousPublishedAt,
      );
      const isPublic = options.nextStatus
        ? isPublicPost(options.nextStatus, options.nextPublishedAt)
        : false;
      if (!wasPublic && !isPublic) return "Draft-only change saved without rebuild.";
      return triggerRebuild(options.reason);
    }

    function refreshComputedFields(): void {
      if (readingTime && body && !readingManual?.checked) readingTime.value = estimateReadingTime(body.value);
      if (preview && body) preview.innerHTML = renderMarkdownToHtml(body.value || "No body content yet.");
    }

    async function loadPost(): Promise<void> {
      if (!client) { showError("Supabase is not configured."); return; }
      if (!postId) { showError("Missing post id."); return; }
      const { data, error } = await client.from("posts").select("*").eq("id", postId).single();
      if (error) { showError(mapSupabasePostError(error)); return; }
      const post = data as AdminPostRow;
      existingPostStatus = post.status;
      existingPublishedAt = post.published_at;
      setValues(formValuesFromAdminPost(post));
      refreshComputedFields();
      setState("Loaded");
    }

    async function savePost(intent: PostSaveIntent): Promise<void> {
      clearError();
      if (!client || !postId) {
        showError("Missing editor context.");
        return;
      }
      const current = values();
      const validationValues = {
        ...current,
        status: intent === "publish" ? "published" : current.status,
        publishedAt:
          intent === "publish"
            ? current.publishedAt || new Date().toISOString()
            : current.publishedAt,
      };
      const errors = validatePostForm(validationValues);
      if (hasValidationErrors(errors)) {
        showError(Object.values(errors)[0] ?? "Please review the form.");
        return;
      }
      setState("Saving...");
      if (stagedCoverFile && intent !== "publish") {
        showError("Cover images are uploaded only when publishing, so draft covers do not become public.");
        setState("Save failed");
        return;
      }
      let uploadedCoverPath: string | null = null;
      try {
        uploadedCoverPath = await uploadStagedCover(current.slug.trim());
      } catch (error) {
        showError(error instanceof Error ? error.message : "Cover upload failed.");
        setState("Save failed");
        return;
      }
      const nextCoverPath = resolveCoverPathForSave({
        existingPath: existingCoverPath,
        uploadedPath: uploadedCoverPath,
        coverRemoved,
      });
      const payload = buildPostUpsertPayload(
        { ...current, coverImagePath: nextCoverPath },
        intent,
      );
      const previousStatus = existingPostStatus;
      const previousPublishedAt = existingPublishedAt;
      const { error } = await client.from("posts").update(payload).eq("id", postId);
      if (error) {
        if (uploadedCoverPath) await removeStorageObjects([uploadedCoverPath]);
        showError(mapSupabasePostError(error));
        setState("Save failed");
        return;
      }
      if (
        shouldDeleteCoverAfterSave({
          previousPath: existingCoverPath,
          nextPath: payload.cover_image_path ?? "",
        })
      ) {
        await removeStorageObjects([existingCoverPath]);
      }
      existingCoverPath = payload.cover_image_path ?? "";
      coverRemoved = false;
      stagedCoverFile = null;
      stagedPreviewUrl = null;
      if (coverFile) coverFile.value = "";
      renderExistingCover();
      if (status) status.value = payload.status;
      if (publishedAt) publishedAt.value = payload.published_at?.slice(0, 16) ?? "";
      existingPostStatus = payload.status;
      existingPublishedAt = payload.published_at;
      const rebuildMessage = await rebuildMessageForMutation({
        previousStatus,
        previousPublishedAt,
        nextStatus: payload.status,
        nextPublishedAt: payload.published_at,
        reason: `blog-${intent}`,
      });
      setState(`Saved. ${rebuildMessage}`);
    }

    async function deletePost(): Promise<void> {
      clearError();
      if (!client || !postId) {
        showError("Missing editor context.");
        return;
      }
      const confirmed = window.confirm("Delete this blog post from Supabase?");
      if (!confirmed) return;
      setState("Deleting...");
      const { error } = await client.from("posts").delete().eq("id", postId);
      if (error) {
        showError(mapSupabasePostError(error));
        setState("Delete failed");
        return;
      }
      if (existingCoverPath) await removeStorageObjects([existingCoverPath]);
      const rebuildMessage = await rebuildMessageForMutation({
        previousStatus: existingPostStatus,
        previousPublishedAt: existingPublishedAt,
        nextStatus: null,
        nextPublishedAt: null,
        reason: "blog-delete",
      });
      setState(`Deleted. ${rebuildMessage}`);
      window.location.href = "/admin/blog/";
    }

    body?.addEventListener("input", refreshComputedFields);
    readingManual?.addEventListener("change", refreshComputedFields);
    coverFile?.addEventListener("change", () => {
      clearError();
      const file = coverFile.files?.[0] ?? null;
      if (!file) {
        setCoverPreview(null);
        return;
      }
      const validationError = validateCoverFile(file);
      if (validationError) {
        coverFile.value = "";
        setCoverPreview(null);
        showError(validationError);
        return;
      }
      setCoverPreview(file);
    });
    removeCover?.addEventListener("click", () => {
      coverRemoved = true;
      if (coverFile) coverFile.value = "";
      setCoverPreview(null);
      if (coverPreview) {
        coverPreview.removeAttribute("src");
        coverPreview.classList.add("hidden");
      }
      if (coverName) coverName.textContent = "Cover will be removed on save.";
      updateRemoveCoverButton();
    });
    document.querySelector("#save-draft")?.addEventListener("click", () => { savePost("draft"); });
    document.querySelector("#publish-post")?.addEventListener("click", () => { savePost("publish"); });
    document.querySelector("#unpublish-post")?.addEventListener("click", () => { savePost("unpublish"); });
    document.querySelector("#delete-post")?.addEventListener("click", () => { deletePost(); });
    document.querySelector<HTMLFormElement>("#post-form")?.addEventListener("submit", (event) => event.preventDefault());
    window.addEventListener("admin:authenticated", () => { loadPost(); });
  </script>
</AdminLayout>
