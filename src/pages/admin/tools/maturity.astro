---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Maturity Checker" activePage="maturity">
  <div class="flex items-center justify-between">
    <div>
      <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Tools</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white">Maturity Submissions</h1>
    </div>
    <button id="maturity-refresh" type="button" class="border border-white/15 px-4 py-2 text-xs uppercase tracking-[0.18em] text-zinc-300 transition hover:border-emerald-300/70 hover:text-white">Refresh</button>
  </div>

  <div class="mt-6 grid gap-3 sm:grid-cols-4">
    <div class="border border-white/10 bg-white/[0.03] p-4">
      <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Total</p>
      <p id="mstat-total" class="mt-2 text-2xl font-semibold text-white">0</p>
    </div>
    <div class="border border-white/10 bg-white/[0.03] p-4">
      <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Avg Score</p>
      <p id="mstat-avg" class="mt-2 text-2xl font-semibold text-emerald-200">-</p>
    </div>
    <div class="border border-white/10 bg-white/[0.03] p-4">
      <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">With Email</p>
      <p id="mstat-emails" class="mt-2 text-2xl font-semibold text-white">0</p>
    </div>
    <div class="border border-white/10 bg-white/[0.03] p-4">
      <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Top Tier</p>
      <p id="mstat-tier" class="mt-2 text-2xl font-semibold text-white">-</p>
    </div>
  </div>

  <div class="mt-8 overflow-x-auto">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr class="border-b border-white/10 text-left text-[11px] uppercase tracking-[0.22em] text-zinc-500">
          <th class="px-3 py-3">Email</th>
          <th class="px-3 py-3">Score</th>
          <th class="px-3 py-3">Tier</th>
          <th class="px-3 py-3">Arch</th>
          <th class="px-3 py-3">Gov</th>
          <th class="px-3 py-3">Analytics</th>
          <th class="px-3 py-3">Ops</th>
          <th class="px-3 py-3">Docs</th>
          <th class="px-3 py-3">Date</th>
        </tr>
      </thead>
      <tbody id="maturity-table-body"></tbody>
    </table>
    <p id="maturity-empty" class="hidden py-12 text-center text-sm text-zinc-500">No submissions yet.</p>
    <p id="maturity-loading" class="py-12 text-center text-sm text-zinc-500">Loading...</p>
  </div>

  <script>
    import { createAdminClient } from "../../../lib/admin/supabase";

    type MaturityRow = { id: string; contact_email: string | null; overall_score: number; tier: string; category_scores: Record<string, number>; created_at: string };

    const client = createAdminClient(import.meta.env);
    const refreshBtn = document.querySelector<HTMLButtonElement>("#maturity-refresh");
    const tableBody = document.querySelector<HTMLElement>("#maturity-table-body");
    const emptyMsg = document.querySelector<HTMLElement>("#maturity-empty");
    const loadingMsg = document.querySelector<HTMLElement>("#maturity-loading");

    async function loadSubmissions(): Promise<void> {
      if (!client) return;
      if (loadingMsg) loadingMsg.classList.remove("hidden");
      if (emptyMsg) emptyMsg.classList.add("hidden");

      const { data, error } = await client.from("data_platform_maturity_submissions").select("id, contact_email, overall_score, tier, category_scores, created_at").order("created_at", { ascending: false });
      if (loadingMsg) loadingMsg.classList.add("hidden");

      if (error) { if (emptyMsg) { emptyMsg.textContent = `Error: ${error.message}`; emptyMsg.classList.remove("hidden"); } return; }

      const rows = (data ?? []) as MaturityRow[];
      updateStats(rows);
      renderTable(rows);
    }

    function updateStats(rows: MaturityRow[]): void {
      const total = document.querySelector("#mstat-total");
      const avg = document.querySelector("#mstat-avg");
      const emails = document.querySelector("#mstat-emails");
      const tier = document.querySelector("#mstat-tier");
      if (total) total.textContent = String(rows.length);
      if (avg) { avg.textContent = rows.length > 0 ? String(Math.round(rows.reduce((s, r) => s + r.overall_score, 0) / rows.length)) : "-"; }
      if (emails) emails.textContent = String(rows.filter((r) => r.contact_email).length);
      if (tier) {
        const tierCounts: Record<string, number> = {};
        for (const r of rows) { tierCounts[r.tier] = (tierCounts[r.tier] ?? 0) + 1; }
        const topTier = Object.entries(tierCounts).sort((a, b) => b[1] - a[1])[0];
        tier.textContent = topTier ? topTier[0] : "-";
      }
    }

    function renderTable(rows: MaturityRow[]): void {
      if (!tableBody) return;
      if (rows.length === 0) { tableBody.innerHTML = ""; if (emptyMsg) emptyMsg.classList.remove("hidden"); return; }
      if (emptyMsg) emptyMsg.classList.add("hidden");
      tableBody.innerHTML = rows.map((row) => `
        <tr class="border-b border-white/5 hover:bg-white/[0.02]">
          <td class="px-3 py-3 text-zinc-300">${row.contact_email ? escapeHtml(row.contact_email) : '<span class="text-zinc-600">—</span>'}</td>
          <td class="px-3 py-3 font-medium text-white">${row.overall_score}</td>
          <td class="px-3 py-3">${tierBadge(row.tier)}</td>
          <td class="px-3 py-3 text-zinc-400">${row.category_scores?.platform_architecture ?? "-"}</td>
          <td class="px-3 py-3 text-zinc-400">${row.category_scores?.governance ?? "-"}</td>
          <td class="px-3 py-3 text-zinc-400">${row.category_scores?.analytics_delivery ?? "-"}</td>
          <td class="px-3 py-3 text-zinc-400">${row.category_scores?.operations ?? "-"}</td>
          <td class="px-3 py-3 text-zinc-400">${row.category_scores?.documentation ?? "-"}</td>
          <td class="px-3 py-3 text-zinc-500">${formatDate(row.created_at)}</td>
        </tr>
      `).join("");
    }

    function tierBadge(tier: string): string {
      const colors: Record<string, string> = { Foundational: "border-zinc-300/25 bg-zinc-300/8 text-zinc-300", Developing: "border-amber-300/25 bg-amber-300/8 text-amber-200", Operational: "border-emerald-300/25 bg-emerald-300/8 text-emerald-200", Advanced: "border-sky-300/25 bg-sky-300/8 text-sky-200" };
      return `<span class="inline-block border px-2 py-0.5 text-[10px] uppercase tracking-[0.15em] ${colors[tier] ?? ""}">${escapeHtml(tier)}</span>`;
    }

    function formatDate(iso: string): string { return new Date(iso).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }); }
    function escapeHtml(text: string): string { const div = document.createElement("div"); div.textContent = text; return div.innerHTML; }

    refreshBtn?.addEventListener("click", () => { loadSubmissions(); });
    window.addEventListener("admin:authenticated", () => { loadSubmissions(); });
  </script>
</AdminLayout>
