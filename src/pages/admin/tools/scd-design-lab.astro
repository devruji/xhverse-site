---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="SCD Design Lab" activePage="scd-lab">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Tools</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white">SCD Design Lab Progress</h1>
    </div>
    <button id="scd-refresh" type="button" class="border border-white/15 px-4 py-2 text-xs uppercase tracking-[0.18em] text-zinc-300 transition hover:border-emerald-300/70 hover:text-white">Refresh</button>
  </div>

  <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
    <div class="border border-white/10 bg-white/[0.03] p-4">
      <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Sessions</p>
      <p id="scd-stat-sessions" class="mt-2 text-2xl font-semibold text-white">0</p>
    </div>
    <div class="border border-white/10 bg-white/[0.03] p-4">
      <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Completed</p>
      <p id="scd-stat-completed" class="mt-2 text-2xl font-semibold text-emerald-200">0</p>
    </div>
    <div class="border border-white/10 bg-white/[0.03] p-4">
      <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Joined</p>
      <p id="scd-stat-joined" class="mt-2 text-2xl font-semibold text-white">0</p>
    </div>
    <div class="border border-white/10 bg-white/[0.03] p-4">
      <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Join Rate</p>
      <p id="scd-stat-join-rate" class="mt-2 text-2xl font-semibold text-white">0%</p>
    </div>
    <div class="border border-white/10 bg-white/[0.03] p-4">
      <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Avg Progress</p>
      <p id="scd-stat-progress" class="mt-2 text-2xl font-semibold text-white">0%</p>
    </div>
  </div>

  <div class="mt-6 flex flex-wrap gap-2" id="scd-filters" aria-label="SCD Lab progress filters">
    {["all", "joined", "completed", "in_progress", "abandoned"].map((filter) => (
      <button
        type="button"
        data-filter={filter}
        class:list={[
          "border px-3 py-2 text-xs uppercase tracking-[0.16em] transition",
          filter === "all"
            ? "border-emerald-300/70 bg-emerald-300/10 text-emerald-100"
            : "border-white/10 bg-black/20 text-zinc-400 hover:border-emerald-300/50 hover:text-white",
        ]}
      >
        {filter.replace("_", " ")}
      </button>
    ))}
  </div>

  <div class="mt-8 overflow-x-auto">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr class="border-b border-white/10 text-left text-[11px] uppercase tracking-[0.22em] text-zinc-500">
          <th class="px-3 py-3">Visitor</th>
          <th class="px-3 py-3">Status</th>
          <th class="px-3 py-3">Progress</th>
          <th class="px-3 py-3">Latest Step</th>
          <th class="px-3 py-3">Result</th>
          <th class="px-3 py-3">Strategy</th>
          <th class="px-3 py-3">Score</th>
          <th class="px-3 py-3">Events</th>
          <th class="px-3 py-3">Last Seen</th>
        </tr>
      </thead>
      <tbody id="scd-table-body"></tbody>
    </table>
    <p id="scd-empty" class="hidden py-12 text-center text-sm text-zinc-500">No SCD Lab sessions yet.</p>
    <p id="scd-loading" class="py-12 text-center text-sm text-zinc-500">Loading...</p>
  </div>

  <script>
    import { createAdminClient } from "../../../lib/admin/supabase";

    type ProgressStatus = "joined" | "completed" | "in_progress" | "abandoned";
    type ScdProgressRow = {
      session_id: string;
      email: string | null;
      name: string | null;
      company: string | null;
      selected_strategy: string | null;
      score: number | null;
      status: string | null;
      progress_percent: number;
      completed: boolean;
      latest_step_id: string | null;
      latest_result_key: string | null;
      latest_event_type: string;
      event_count: number;
      first_seen_at: string;
      last_seen_at: string;
      joined_at: string | null;
      progress_status: ProgressStatus;
    };

    const client = createAdminClient(import.meta.env);
    const refreshBtn = document.querySelector<HTMLButtonElement>("#scd-refresh");
    const tableBody = document.querySelector<HTMLElement>("#scd-table-body");
    const emptyMsg = document.querySelector<HTMLElement>("#scd-empty");
    const loadingMsg = document.querySelector<HTMLElement>("#scd-loading");
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    let rows: ScdProgressRow[] = [];
    let activeFilter = "all";

    async function loadProgress(): Promise<void> {
      if (!client) return;
      if (loadingMsg) loadingMsg.classList.remove("hidden");
      if (emptyMsg) emptyMsg.classList.add("hidden");

      const { data, error } = await client
        .from("scd_design_lab_progress")
        .select("*")
        .order("last_seen_at", { ascending: false });

      if (loadingMsg) loadingMsg.classList.add("hidden");
      if (error) {
        if (emptyMsg) {
          emptyMsg.textContent = `Error: ${error.message}`;
          emptyMsg.classList.remove("hidden");
        }
        return;
      }

      rows = (data ?? []) as ScdProgressRow[];
      updateStats(rows);
      renderTable();
    }

    function updateStats(items: ScdProgressRow[]): void {
      const sessions = items.length;
      const completed = items.filter((row) => row.completed).length;
      const joined = items.filter((row) => row.email).length;
      const avgProgress = sessions > 0
        ? Math.round(items.reduce((sum, row) => sum + row.progress_percent, 0) / sessions)
        : 0;

      setText("#scd-stat-sessions", String(sessions));
      setText("#scd-stat-completed", String(completed));
      setText("#scd-stat-joined", String(joined));
      setText("#scd-stat-join-rate", sessions > 0 ? `${Math.round((joined / sessions) * 100)}%` : "0%");
      setText("#scd-stat-progress", `${avgProgress}%`);
    }

    function renderTable(): void {
      if (!tableBody) return;
      const filtered = activeFilter === "all"
        ? rows
        : rows.filter((row) => row.progress_status === activeFilter);

      if (filtered.length === 0) {
        tableBody.innerHTML = "";
        if (emptyMsg) {
          emptyMsg.textContent = rows.length === 0 ? "No SCD Lab sessions yet." : "No sessions match this filter.";
          emptyMsg.classList.remove("hidden");
        }
        return;
      }

      if (emptyMsg) emptyMsg.classList.add("hidden");
      tableBody.innerHTML = filtered.map((row) => `
        <tr class="border-b border-white/5 hover:bg-white/[0.02]">
          <td class="px-3 py-3">
            <p class="text-zinc-300">${row.email ? escapeHtml(row.email) : '<span class="text-zinc-600">Anonymous</span>'}</p>
            <p class="mt-1 text-xs text-zinc-500">${escapeHtml(row.name ?? row.company ?? row.session_id.slice(0, 8))}</p>
          </td>
          <td class="px-3 py-3">${statusBadge(row.progress_status)}</td>
          <td class="px-3 py-3 font-mono text-zinc-300">${row.progress_percent}%</td>
          <td class="px-3 py-3 text-zinc-400">${escapeHtml(row.latest_step_id ?? row.latest_event_type)}</td>
          <td class="px-3 py-3 text-zinc-400">${escapeHtml(row.latest_result_key ?? "-")}</td>
          <td class="px-3 py-3 text-zinc-400">${escapeHtml(row.selected_strategy ?? "-")}</td>
          <td class="px-3 py-3 font-mono text-zinc-300">${row.score ?? "-"}</td>
          <td class="px-3 py-3 font-mono text-zinc-500">${row.event_count}</td>
          <td class="px-3 py-3 text-zinc-500">${formatDate(row.last_seen_at)}</td>
        </tr>
      `).join("");
    }

    function statusBadge(status: ProgressStatus): string {
      const colors: Record<ProgressStatus, string> = {
        joined: "border-emerald-300/30 bg-emerald-300/10 text-emerald-100",
        completed: "border-cyan-300/30 bg-cyan-300/10 text-cyan-100",
        in_progress: "border-amber-300/30 bg-amber-300/10 text-amber-100",
        abandoned: "border-zinc-300/20 bg-zinc-300/8 text-zinc-400",
      };
      return `<span class="inline-block border px-2 py-0.5 text-[10px] uppercase tracking-[0.15em] ${colors[status]}">${status.replace("_", " ")}</span>`;
    }

    function setText(selector: string, value: string): void {
      const element = document.querySelector(selector);
      if (element) element.textContent = value;
    }

    function formatDate(iso: string): string {
      return new Date(iso).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
    }

    function escapeHtml(text: string): string {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeFilter = button.dataset.filter ?? "all";
        filterButtons.forEach((item) => {
          const active = item === button;
          item.className = active
            ? "border border-emerald-300/70 bg-emerald-300/10 px-3 py-2 text-xs uppercase tracking-[0.16em] text-emerald-100 transition"
            : "border border-white/10 bg-black/20 px-3 py-2 text-xs uppercase tracking-[0.16em] text-zinc-400 transition hover:border-emerald-300/50 hover:text-white";
        });
        renderTable();
      });
    });

    refreshBtn?.addEventListener("click", () => { loadProgress(); });
    window.addEventListener("admin:authenticated", () => { loadProgress(); });
  </script>
</AdminLayout>
