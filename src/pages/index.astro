---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
import { site } from "../data/site";

const platformStack = [
  "Azure",
  "Databricks",
  "Microsoft Fabric",
  "Delta Lake",
  "Unity Catalog",
  "Power BI",
];

const profilePlatformStack = [
  {
    name: "Azure",
    src: "/images/platform-stack/azure.png",
  },
  {
    name: "Databricks",
    src: "/images/platform-stack/databricks.png",
  },
  {
    name: "Microsoft Fabric",
    src: "/images/platform-stack/fabric.png",
  },
  {
    name: "Apache Spark",
    src: "/images/platform-stack/spark.png",
  },
  {
    name: "Apache Airflow",
    src: "/images/platform-stack/airflow.png",
  },
  {
    name: "Terraform",
    src: "/images/platform-stack/terraform.png",
  },
  {
    name: "AWS",
    src: "/images/platform-stack/aws.png",
  },
  {
    name: "Google Cloud",
    src: "/images/platform-stack/google-cloud.png",
  },
];

const capabilityGroups = [
  {
    title: "Platform architecture",
    items: ["Lakehouse foundations", "Workspace models", "Data product paths"],
  },
  {
    title: "Governance systems",
    items: ["Access design", "Ownership patterns", "Audit-ready standards"],
  },
  {
    title: "Analytics delivery",
    items: ["Semantic layers", "Reporting foundations", "Operational handover"],
  },
];

const tools = [
  {
    label: "Benchmark tool",
    title: "Data Platform Maturity Checker",
    description:
      "A lightweight, anonymous maturity signal for platform architecture, governance, analytics delivery, operations, and documentation.",
    href: "/tools/data-platform-maturity-checker",
  },
];

const focusAreas = [
  {
    title: "Data platform architecture",
    description:
      "Designing clearer platform foundations across lakehouse, warehouse, semantic, and operational layers.",
  },
  {
    title: "Governance and standardization",
    description:
      "Turning fragmented access, naming, ownership, and operating models into maintainable platform rules.",
  },
  {
    title: "Analytics engineering",
    description:
      "Building durable data products, transformation patterns, and reporting foundations that teams can trust.",
  },
  {
    title: "Architecture communication",
    description:
      "Translating technical platform decisions into practical narratives for delivery teams and stakeholders.",
  },
];

const workThemes = [
  {
    label: "01",
    title: "Lakehouse governance realignment",
    stack: "Azure · Databricks · Unity Catalog",
    description:
      "Clarifying workspace access, catalog permissions, policy boundaries, and operating rules so teams can use the platform without growing permission sprawl.",
    outcomes: ["Cleaner access paths", "Stronger ownership model", "Audit-friendly documentation"],
  },
  {
    label: "02",
    title: "Fabric operating model design",
    stack: "Microsoft Fabric · Power BI · Automation",
    description:
      "Turning workspace administration, semantic model movement, and role assignment flows into repeatable practices that are easier to verify and maintain.",
    outcomes: ["Safer admin workflows", "Clearer release checks", "Reusable operator runbooks"],
  },
  {
    label: "03",
    title: "Enterprise analytics foundation",
    stack: "Data engineering · Architecture narratives · Governance",
    description:
      "Connecting delivery teams, stakeholders, and platform owners through practical architecture decisions, clearer standards, and decision-ready communication.",
    outcomes: ["Shared platform language", "Reduced ambiguity", "Better long-term maintainability"],
  },
];

const operatingPrinciples = [
  "Clear contracts before clever systems",
  "Governance that operators can actually run",
  "Architecture decisions tied to business context",
  "Platforms designed for maintenance, not only launch",
];

const writingThemes = [
  {
    label: "Platform Notes",
    title: "Modern data platforms in practice",
    description:
      "Notes on Azure, Databricks, Fabric, lakehouse patterns, and the trade-offs behind platform design.",
  },
  {
    label: "Governance",
    title: "From access sprawl to operating clarity",
    description:
      "Practical thinking on permissions, ownership, standardization, and the controls that make data usable.",
  },
  {
    label: "Architecture",
    title: "Decision-ready technical narratives",
    description:
      "How to make complex platform topics easier to understand, compare, and move through delivery.",
  },
];

const proofLinks = [
  {
    label: "LinkedIn",
    title: "Professional profile",
    description:
      "Career context, platform experience, and professional background for deeper validation.",
    href: site.linkedin,
    display: "linkedin.com/in/rujikorn",
  },
  {
    label: "Medium",
    title: "Architecture writing",
    description:
      "Long-form notes and public thinking from xhverse around platforms, systems, and data work.",
    href: site.medium,
    display: "medium.xhverse.co",
  },
];

const deploymentSite = (Astro.site ?? site.siteUrl).toString();

const homeStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${deploymentSite}#website`,
      name: "XHVERSE",
      alternateName: ["xhverse", "xhverse.co", "XHVERSE by bossruji"],
      url: deploymentSite,
      inLanguage: "en",
      publisher: { "@id": `${deploymentSite}#person` },
    },
    {
      "@type": "Person",
      "@id": `${deploymentSite}#person`,
      name: profile.fullName,
      alternateName: profile.alternateNames,
      additionalName: ["XH", "bossruji"],
      url: deploymentSite,
      mainEntityOfPage: deploymentSite,
      jobTitle: profile.title,
      description: profile.longBio,
      image: new URL(profile.avatar, deploymentSite).toString(),
      email: profile.email,
      knowsAbout: profile.knowsAbout,
      sameAs: [site.github, site.medium, site.linkedin],
    },
    {
      "@type": "ProfilePage",
      "@id": `${deploymentSite}#profile-page`,
      name: `${profile.fullName} - XHVERSE`,
      alternateName: ["xhverse", "xhverse.co", "bossruji", "XH"],
      url: deploymentSite,
      description: site.description,
      about: { "@id": `${deploymentSite}#person` },
      mainEntity: { "@id": `${deploymentSite}#person` },
      isPartOf: { "@id": `${deploymentSite}#website` },
      inLanguage: "en",
    },
  ],
};
---
<BaseLayout
  title={`${profile.fullName} | XHVERSE`}
  description={`Official xhverse.co profile of ${profile.fullName}, also known as XH and bossruji, focused on data platform architecture, governance, analytics architecture, and practical data strategy.`}
  structuredData={homeStructuredData}
  image={profile.avatar}
  lcpImage={profile.avatar}
>
  <div class="min-h-screen bg-[#070809] font-sans text-zinc-100 selection:bg-emerald-300/30 selection:text-white">
    <main class="mx-auto max-w-7xl px-5 py-6 sm:px-8 sm:py-8 lg:px-10">
      <header class="flex items-start justify-between gap-5 border-b border-white/10 pb-5 sm:items-center">
        <a href="/" class="group">
          <p class="text-[11px] uppercase tracking-[0.35em] text-zinc-500">xhverse.co</p>
          <span class="mt-1 block text-[1.35rem] font-semibold tracking-tight text-white sm:text-[1.55rem]">
            XHVERSE
          </span>
        </a>
        <nav class="hidden items-center gap-6 text-sm text-zinc-400 md:flex" aria-label="Primary navigation">
          <a href="#profile" class="transition hover:text-white">Profile</a>
          <a href="#work" class="transition hover:text-white">Work</a>
          <a href="#proof" class="transition hover:text-white">Proof</a>
          <a href="#writing" class="transition hover:text-white">Writing</a>
          <a href="/cv" class="transition hover:text-white">CV</a>
          <a href="#contact" class="transition hover:text-white">Contact</a>
        </nav>
        <a
          href="#contact"
          class="border border-white/15 px-3 py-1.5 text-xs uppercase tracking-[0.18em] text-zinc-300 transition hover:border-emerald-300/70 hover:text-white md:hidden"
        >
          Contact
        </a>
      </header>

      <section id="profile" class="relative min-h-[85vh] overflow-hidden py-16 sm:py-20 lg:py-24">
        <!-- Atmospheric background -->
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <div class="hero-orb hero-orb--1"></div>
          <div class="hero-orb hero-orb--2"></div>
          <div class="hero-noise"></div>
        </div>

        <div class="relative grid items-end gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-0">
          <!-- Left: Typography & Identity -->
          <div class="hero-stagger">
            <p class="hero-stagger-item text-[11px] font-medium uppercase tracking-[0.4em] text-emerald-300/80">
              {profile.title}
            </p>
            <h1 class="hero-stagger-item mt-5 text-[3.5rem] font-bold leading-[0.88] tracking-[-0.04em] sm:text-[5.8rem] lg:text-[7.5rem]">
              <span class="text-gradient">{profile.fullName.split(' ')[0]}</span>
              <br />
              <span class="text-white/90">{profile.fullName.split(' ')[1]}</span>
            </h1>
            <p class="hero-stagger-item mt-8 max-w-md text-[1.05rem] leading-[1.8] text-zinc-400">
              Architecting governed data platforms that enterprise teams can actually operate — across Azure, Databricks, and Fabric.
            </p>
            <div class="hero-stagger-item mt-10 flex items-center gap-5">
              <a href="#work" class="group relative inline-flex items-center gap-2.5 overflow-hidden bg-white px-7 py-3.5 text-sm font-semibold text-black transition-all hover:shadow-[0_0_30px_rgba(255,255,255,0.15)]">
                <span>Explore work</span>
                <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-y-0.5" fill="none" viewBox="0 0 14 14" stroke="currentColor" stroke-width="2">
                  <path d="M7 1v12M1 7l6 6 6-6" />
                </svg>
              </a>
              <a href="/cv" class="text-[13px] text-zinc-500 transition hover:text-white">
                Download CV &rarr;
              </a>
            </div>

            <!-- Platform stack as subtle signature -->
            <div class="hero-stagger-item mt-14 flex items-center gap-4 border-t border-white/6 pt-6">
              {profilePlatformStack.slice(0, 6).map((item) => (
                <img
                  src={item.src}
                  alt={item.name}
                  width="96"
                  height="96"
                  loading="lazy"
                  decoding="async"
                  title={item.name}
                  class="h-5 w-5 object-contain opacity-40 grayscale transition hover:opacity-100 hover:grayscale-0"
                />
              ))}
            </div>
          </div>

          <!-- Right: Dramatic photo treatment -->
          <div class="hero-stagger-item relative hidden lg:flex lg:justify-end">
            <div class="hero-photo-wrapper">
              <img
                src={profile.avatar}
                alt={`Portrait of ${profile.fullName}`}
                width="960"
                height="960"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="hero-photo"
              />
              <div class="hero-photo-overlay"></div>
            </div>
            <div class="absolute -bottom-4 right-8 flex items-center gap-3 text-[10px] uppercase tracking-[0.3em] text-zinc-600">
              <span class="h-px w-8 bg-zinc-700"></span>
              <span>XH / bossruji</span>
            </div>
          </div>
        </div>
      </section>

      <section id="work" data-animate class="border-t border-white/10 py-14 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Work focus</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Clearer data ecosystems for real enterprise teams.
            </h3>
            <p class="mt-4 text-sm leading-7 text-zinc-400">
              The work is technical, but the goal is operational clarity: platforms that teams can govern, extend,
              monitor, and explain with confidence.
            </p>
          </div>
          <div data-stagger class="grid gap-px overflow-hidden border border-white/10 bg-white/10 sm:grid-cols-2">
            {focusAreas.map((item) => (
              <article class="bg-[#070809] p-5 sm:p-6">
                <h4 class="text-lg font-semibold tracking-tight text-white">{item.title}</h4>
                <p class="mt-3 text-sm leading-7 text-zinc-400">{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="grid gap-8 border-t border-white/10 py-14 sm:py-20 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Capability system</p>
          <h3 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            Built around the platform, governance, and delivery work that makes analytics durable.
          </h3>
          <div class="mt-6 flex flex-wrap gap-2">
            {platformStack.map((item) => (
              <span class="border border-white/10 bg-white/[0.03] px-3 py-2 text-sm text-zinc-300">
                {item}
              </span>
            ))}
          </div>
        </div>
        <div class="grid gap-3">
          {capabilityGroups.map((group) => (
            <article class="border border-white/10 bg-white/[0.03] p-5">
              <h4 class="text-base font-semibold tracking-tight text-white">{group.title}</h4>
              <div class="mt-4 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="border border-white/10 bg-black/20 px-3 py-1.5 text-xs text-zinc-400">
                    {item}
                  </span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="border-t border-white/10 py-14 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Tools</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Practical checks for data platform clarity.
            </h3>
          </div>
          <div class="grid gap-3">
            {tools.map((item) => (
              <a href={item.href} class="border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50">
                <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">{item.label}</p>
                <h4 class="mt-4 text-xl font-semibold tracking-tight text-white">{item.title}</h4>
                <p class="mt-3 text-sm leading-7 text-zinc-400">{item.description}</p>
                <p class="mt-5 text-sm font-medium text-emerald-200">Open checker</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="border-t border-white/10 py-14 sm:py-20">
        <div class="mb-8 max-w-3xl">
          <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Selected work themes</p>
          <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            Practical architecture patterns for complex data platform environments.
          </h3>
          <p class="mt-4 text-sm leading-7 text-zinc-400">
            A focused view of the platform problems, engineering decisions, and operating outcomes that shape the work.
          </p>
        </div>
        <div data-stagger class="grid gap-4 lg:grid-cols-3">
          {workThemes.map((item) => (
            <article class="flex min-h-[26rem] flex-col border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50 sm:p-6">
              <div class="flex items-start justify-between gap-4">
                <span class="text-sm font-medium text-emerald-200">{item.label}</span>
                <span class="text-right text-[11px] uppercase tracking-[0.16em] text-zinc-500">{item.stack}</span>
              </div>
              <h4 class="mt-8 text-2xl font-semibold tracking-tight text-white">{item.title}</h4>
              <p class="mt-4 text-sm leading-7 text-zinc-400">{item.description}</p>
              <div class="mt-auto pt-6">
                <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Visible outcomes</p>
                <ul class="mt-3 space-y-2">
                  {item.outcomes.map((outcome) => (
                    <li class="border-l border-emerald-300/40 pl-3 text-sm leading-6 text-zinc-300">
                      {outcome}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="proof" data-animate class="border-t border-white/10 py-14 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Public proof</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Public context for writing, experience, and professional background.
            </h3>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {proofLinks.map((item) => (
              <a href={item.href} target="_blank" rel="noopener noreferrer" class="border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50">
                <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">{item.label}</p>
                <h4 class="mt-4 text-xl font-semibold tracking-tight text-white">{item.title}</h4>
                <p class="mt-3 text-sm leading-7 text-zinc-400">{item.description}</p>
                <p class="mt-5 break-all text-sm font-medium text-emerald-200">{item.display}</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="border-t border-white/10 py-14 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Operating principles</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Architecture should make delivery easier to run.
            </h3>
          </div>
          <div class="divide-y divide-white/10 border-y border-white/10">
            {operatingPrinciples.map((item, index) => (
              <div class="grid gap-4 py-5 sm:grid-cols-[4rem_1fr] sm:items-center">
                <span class="text-sm text-emerald-200">0{index + 1}</span>
                <p class="text-xl font-medium tracking-tight text-white">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="writing" class="border-t border-white/10 py-14 sm:py-20">
        <div class="mb-8 grid gap-4 md:grid-cols-[1fr_auto] md:items-end">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Writing</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Notes on platforms, governance, and analytics architecture.
            </h3>
          </div>
          <a href="/blog" class="text-sm font-medium text-emerald-200 transition hover:text-white">
            Open writing hub
          </a>
        </div>
        <div data-stagger class="grid gap-4 md:grid-cols-3">
          {writingThemes.map((item) => (
            <article class="border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50">
              <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">{item.label}</p>
              <h4 class="mt-4 text-xl font-semibold tracking-tight text-white">{item.title}</h4>
              <p class="mt-3 text-sm leading-7 text-zinc-400">{item.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="contact" class="border-t border-white/10 py-14 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Contact</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Data platform architecture, governance, and thoughtful technical direction.
            </h3>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <a href={`mailto:${profile.email}`} class="border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50">
              <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Email</p>
              <p class="mt-3 break-all text-lg font-semibold text-white">{profile.email}</p>
            </a>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50">
              <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">LinkedIn</p>
              <p class="mt-3 break-all text-lg font-semibold text-white">linkedin.com/in/rujikorn</p>
            </a>
            <a href={site.github} target="_blank" rel="noopener noreferrer" class="border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50">
              <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">GitHub</p>
              <p class="mt-3 break-all text-lg font-semibold text-white">github.com/devruji</p>
            </a>
            <a href={site.medium} target="_blank" rel="noopener noreferrer" class="border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50">
              <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Medium</p>
              <p class="mt-3 break-all text-lg font-semibold text-white">medium.xhverse.co</p>
            </a>
          </div>
        </div>
      </section>

      <footer class="flex flex-col gap-4 border-t border-white/10 py-6 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between">
        <p>xhverse.co · Data architecture journal by XH</p>
        <p>Azure · Databricks · Microsoft Fabric</p>
      </footer>
    </main>
  </div>
</BaseLayout>
