---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../data/profile";
import { site } from "../data/site";

const platformStack = [
  "Azure",
  "Databricks",
  "Microsoft Fabric",
  "Delta Lake",
  "Unity Catalog",
  "Power BI",
];

const profilePlatformStack = [
  {
    name: "Azure",
    src: "/images/platform-stack/azure.png",
  },
  {
    name: "Databricks",
    src: "/images/platform-stack/databricks.png",
  },
  {
    name: "Microsoft Fabric",
    src: "/images/platform-stack/fabric.png",
  },
  {
    name: "Apache Spark",
    src: "/images/platform-stack/spark.png",
  },
  {
    name: "Apache Airflow",
    src: "/images/platform-stack/airflow.png",
  },
  {
    name: "Terraform",
    src: "/images/platform-stack/terraform.png",
  },
  {
    name: "AWS",
    src: "/images/platform-stack/aws.png",
    lightSrc: "/images/platform-stack/aws-light.png",
  },
  {
    name: "Google Cloud",
    src: "/images/platform-stack/google-cloud.png",
  },
];

const aiStack = [
  { name: "OpenAI", src: "/images/ai-stack/openai.png", darkSrc: "/images/ai-stack/openai-dark.png" },
  { name: "Claude", src: "/images/ai-stack/claude.png", darkSrc: "/images/ai-stack/claude-dark.png" },
  { name: "Gemini", src: "/images/ai-stack/gemini.png", darkSrc: "/images/ai-stack/gemini-dark.png" },
  { name: "MS Foundry", src: "/images/ai-stack/ms-foundry.png" },
  { name: "Claude Code", src: "/images/ai-stack/claude-code.png" },
  { name: "Codex", src: "/images/ai-stack/codex.png" },
  { name: "Gemini CLI", src: "/images/ai-stack/gemini-cli.png" },
  { name: "GitHub Copilot", src: "/images/ai-stack/github-copilot.png", darkSrc: "/images/ai-stack/github-copilot-dark.png" },
  { name: "Cursor", src: "/images/ai-stack/cursor.png", darkSrc: "/images/ai-stack/cursor-dark.png" },
];

const capabilityGroups = [
  {
    title: "Platform architecture",
    items: ["Lakehouse foundations", "Workspace models", "Data product paths"],
  },
  {
    title: "Governance systems",
    items: ["Access design", "Ownership patterns", "Audit-ready standards"],
  },
  {
    title: "Analytics delivery",
    items: ["Semantic layers", "Reporting foundations", "Operational handover"],
  },
];

const tools = [
  {
    label: "Benchmark tool",
    title: "Data Platform Maturity Checker",
    description:
      "A lightweight, anonymous maturity signal for platform architecture, governance, analytics delivery, operations, and documentation.",
    href: "/tools/data-platform-maturity-checker",
  },
];

const focusAreas = [
  {
    title: "Data platform architecture",
    description:
      "Designing clearer platform foundations across lakehouse, warehouse, semantic, and operational layers.",
  },
  {
    title: "Governance and standardization",
    description:
      "Turning fragmented access, naming, ownership, and operating models into maintainable platform rules.",
  },
  {
    title: "Analytics engineering",
    description:
      "Building durable data products, transformation patterns, and reporting foundations that teams can trust.",
  },
  {
    title: "Architecture communication",
    description:
      "Translating technical platform decisions into practical narratives for delivery teams and stakeholders.",
  },
];

const workThemes = [
  {
    label: "01",
    title: "Lakehouse governance realignment",
    stack: "Azure · Databricks · Unity Catalog",
    description:
      "Clarifying workspace access, catalog permissions, policy boundaries, and operating rules so teams can use the platform without growing permission sprawl.",
    outcomes: ["Cleaner access paths", "Stronger ownership model", "Audit-friendly documentation"],
  },
  {
    label: "02",
    title: "Fabric operating model design",
    stack: "Microsoft Fabric · Power BI · Automation",
    description:
      "Turning workspace administration, semantic model movement, and role assignment flows into repeatable practices that are easier to verify and maintain.",
    outcomes: ["Safer admin workflows", "Clearer release checks", "Reusable operator runbooks"],
  },
  {
    label: "03",
    title: "Enterprise analytics foundation",
    stack: "Data engineering · Architecture narratives · Governance",
    description:
      "Connecting delivery teams, stakeholders, and platform owners through practical architecture decisions, clearer standards, and decision-ready communication.",
    outcomes: ["Shared platform language", "Reduced ambiguity", "Better long-term maintainability"],
  },
];

const operatingPrinciples = [
  "Clear contracts before clever systems",
  "Governance that operators can actually run",
  "Architecture decisions tied to business context",
  "Platforms designed for maintenance, not only launch",
];

const writingThemes = [
  {
    label: "Platform Notes",
    title: "Modern data platforms in practice",
    description:
      "Notes on Azure, Databricks, Fabric, lakehouse patterns, and the trade-offs behind platform design.",
  },
  {
    label: "Governance",
    title: "From access sprawl to operating clarity",
    description:
      "Practical thinking on permissions, ownership, standardization, and the controls that make data usable.",
  },
  {
    label: "Architecture",
    title: "Decision-ready technical narratives",
    description:
      "How to make complex platform topics easier to understand, compare, and move through delivery.",
  },
];

const proofLinks = [
  {
    label: "LinkedIn",
    title: "Professional profile",
    description:
      "Career context, platform experience, and professional background for deeper validation.",
    href: site.linkedin,
    display: "linkedin.com/in/rujikorn",
  },
  {
    label: "Medium",
    title: "Architecture writing",
    description:
      "Long-form notes and public thinking from xhverse around platforms, systems, and data work.",
    href: site.medium,
    display: "medium.xhverse.co",
  },
];

const deploymentSite = (Astro.site ?? site.siteUrl).toString();

const homeStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${deploymentSite}#website`,
      name: "XHVERSE",
      alternateName: ["xhverse", "xhverse.co", "XHVERSE by bossruji"],
      url: deploymentSite,
      inLanguage: "en",
      publisher: { "@id": `${deploymentSite}#person` },
    },
    {
      "@type": "Person",
      "@id": `${deploymentSite}#person`,
      name: profile.fullName,
      alternateName: profile.alternateNames,
      additionalName: ["XH", "bossruji"],
      url: deploymentSite,
      mainEntityOfPage: deploymentSite,
      jobTitle: profile.title,
      description: profile.longBio,
      image: new URL(profile.avatar, deploymentSite).toString(),
      email: profile.email,
      knowsAbout: profile.knowsAbout,
      sameAs: [site.github, site.medium, site.linkedin],
    },
    {
      "@type": "ProfilePage",
      "@id": `${deploymentSite}#profile-page`,
      name: "Rujikorn Ngoensaard - XHVERSE",
      alternateName: ["xhverse", "xhverse.co", "bossruji", "XH"],
      url: deploymentSite,
      description:
        "XHVERSE is the data architecture journal and portfolio of Rujikorn Ngoensaard, also known as XH or bossruji.",
      about: { "@id": `${deploymentSite}#person` },
      mainEntity: { "@id": `${deploymentSite}#person` },
      isPartOf: { "@id": `${deploymentSite}#website` },
      inLanguage: "en",
    },
  ],
};
---
<BaseLayout
  title="Rujikorn Ngoensaard | XHVERSE"
  description="Official xhverse.co profile of Rujikorn Ngoensaard, also known as XH and bossruji, focused on data platform architecture, governance, analytics architecture, and practical data strategy."
  structuredData={homeStructuredData}
  image={site.ogImage}
  lcpImage={profile.avatar}
>
  <div class="min-h-screen bg-[var(--bg-page)] font-sans text-[var(--text)]">
    <Header
      current="/"
      links={[
        { href: "#profile", label: "Profile" },
        { href: "#work", label: "Work" },
        { href: "#proof", label: "Proof" },
        { href: "#writing", label: "Writing" },
        { href: "/services", label: "Advisory" },
        { href: "/cv", label: "CV" },
        { href: "#contact", label: "Contact" },
      ]}
    />
    <main class="mx-auto max-w-7xl px-5 py-6 sm:px-8 sm:py-8 lg:px-10">

      <section id="profile" class="hero-spotlight grid items-start gap-8 py-8 sm:py-10 lg:grid-cols-[1.05fr_0.95fr] lg:py-12">
        <div>
          <div class="hero-entrance mb-4 flex flex-wrap gap-1.5">
            <span class="border border-emerald-300/25 bg-emerald-300/8 px-2.5 py-0.5 text-[10px] uppercase tracking-[0.22em] text-emerald-200">
              Data Engineer / Data Architect
            </span>
            <span class="border border-cyan-300/20 bg-cyan-300/8 px-2.5 py-0.5 text-[10px] uppercase tracking-[0.22em] text-cyan-100">
              Data Platform Craftsman
            </span>
            <span class="border border-white/10 px-2.5 py-0.5 text-[10px] uppercase tracking-[0.22em] text-zinc-400">
              Azure · Databricks · Fabric
            </span>
          </div>
          <h1 class="hero-entrance-delayed max-w-4xl text-[2.2rem] font-semibold leading-[1.05] tracking-tight text-white sm:text-[3.5rem] lg:text-[4.5rem]">
            Rujikorn Ngoensaard
          </h1>
          <p class="hero-entrance-delayed-2 mt-2 text-xs font-medium uppercase tracking-[0.22em] text-emerald-200">
            XH / bossruji · xhverse.co
          </p>
          <p class="hero-entrance-delayed-2 mt-4 max-w-xl text-sm leading-relaxed text-zinc-300">
            XHVERSE is my data architecture journal and portfolio, focused on Azure, Databricks, Microsoft Fabric,
            enterprise analytics, and better-governed data platforms.
          </p>
          <p class="hero-entrance-delayed-2 mt-3 max-w-xl border-l border-cyan-300/35 pl-3 text-xs leading-6 text-zinc-400">
            {profile.craftLine}
          </p>
          <div class="hero-entrance-delayed-2 mt-6 grid grid-cols-2 gap-2.5 sm:flex sm:flex-wrap sm:gap-3">
            <a href="#work" class="col-span-2 inline-flex items-center justify-center bg-white px-5 py-2.5 text-xs font-semibold text-black transition hover:bg-emerald-100 sm:col-span-1 sm:text-sm">
              View focus areas
            </a>
            <a href="/blog" class="inline-flex items-center justify-center border border-white/15 px-4 py-2.5 text-xs font-medium text-white transition hover:border-emerald-300/70 sm:px-5 sm:text-sm">
              Architecture notes
            </a>
            <a href="/cv" class="inline-flex items-center justify-center border border-white/15 px-4 py-2.5 text-xs font-medium text-white transition hover:border-cyan-300/70 sm:px-5 sm:text-sm">
              View CV
            </a>
          </div>
        </div>

        <aside class="hero-entrance-delayed border border-white/10 bg-white/[0.025] p-5 sm:p-6 lg:self-start">
          <div class="flex flex-row items-start gap-4 sm:gap-5">
            <img
              src="/images/xh-profile-256.png"
              alt="Portrait of XH"
              width="256"
              height="256"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              class="mt-0.5 aspect-square w-14 shrink-0 rounded-full object-cover sm:w-20 xl:w-24"
            />
            <div class="min-w-0">
              <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">{profile.name}</h2>
              <p class="mt-2 text-sm text-zinc-500">
                {profile.fullName} · @{profile.handle}
              </p>
              <p class="mt-4 text-sm leading-7 text-zinc-300">{profile.bio}</p>
            </div>
          </div>
          <div class="mt-6 border-t border-white/10 pt-5">
            <p class="text-[11px] uppercase tracking-[0.28em] text-zinc-500">Platform stack</p>
            <div class="mt-3 grid grid-cols-4 gap-2 sm:grid-cols-7 lg:grid-cols-4 xl:grid-cols-7">
              {profilePlatformStack.map((item) => (
                <div
                  class="group flex h-14 w-14 items-center justify-center border border-white/10 bg-black/20 p-2.5 transition hover:border-emerald-300/40 hover:bg-white/[0.04]"
                  title={item.name}
                  aria-label={item.name}
                >
                  {item.lightSrc ? (
                    <>
                      <img src={item.src} alt={`${item.name} logo`} width="512" height="512" loading="lazy" decoding="async" class="theme-dark-only h-8 w-8 object-contain" />
                      <img src={item.lightSrc} alt={`${item.name} logo`} width="512" height="512" loading="lazy" decoding="async" class="theme-light-only h-8 w-8 object-contain" />
                    </>
                  ) : (
                    <img
                      src={item.src}
                      alt={`${item.name} logo`}
                      width="512"
                      height="512"
                      loading="lazy"
                      decoding="async"
                      class="h-8 w-8 object-contain"
                    />
                  )}
                </div>
              ))}
            </div>
          </div>
          <div class="mt-5 border-t border-white/10 pt-5">
            <p class="text-[11px] uppercase tracking-[0.28em] text-zinc-500">AI stack</p>
            <div class="mt-3 grid grid-cols-4 gap-2 sm:grid-cols-6 lg:grid-cols-4 xl:grid-cols-6">
              {aiStack.map((item) => (
                <div
                  class="group flex h-14 w-14 items-center justify-center border border-white/10 bg-black/20 p-2.5 transition hover:border-emerald-300/40 hover:bg-white/[0.04]"
                  title={item.name}
                  aria-label={item.name}
                >
                  {item.darkSrc ? (
                    <>
                      <img src={item.darkSrc} alt={`${item.name} logo`} width="512" height="512" loading="lazy" decoding="async" class="theme-dark-only h-8 w-8 object-contain" />
                      <img src={item.src} alt={`${item.name} logo`} width="512" height="512" loading="lazy" decoding="async" class="theme-light-only h-8 w-8 object-contain" />
                    </>
                  ) : (
                    <img
                      src={item.src}
                      alt={`${item.name} logo`}
                      width="512"
                      height="512"
                      loading="lazy"
                      decoding="async"
                      class="h-8 w-8 object-contain"
                    />
                  )}
                </div>
              ))}
            </div>
          </div>
        </aside>
      </section>

      <section id="work" class="animate-on-scroll border-t border-white/10 py-14 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Work focus</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Clearer data ecosystems for real enterprise teams.
            </h3>
            <p class="mt-4 text-sm leading-7 text-zinc-400">
              The work is technical, but the goal is operational clarity: platforms that teams can govern, extend,
              monitor, and explain with confidence.
            </p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {focusAreas.map((item) => (
              <article class="border border-white/10 bg-white/[0.03] p-5 sm:p-6">
                <h4 class="text-lg font-semibold tracking-tight text-white">{item.title}</h4>
                <p class="mt-3 text-sm leading-7 text-zinc-400">{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="animate-on-scroll grid gap-8 border-t border-white/10 py-14 sm:py-20 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Capability system</p>
          <h3 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            Built around the platform, governance, and delivery work that makes analytics durable.
          </h3>
          <div class="mt-6 flex flex-wrap gap-2">
            {platformStack.map((item) => (
              <span class="border border-white/10 bg-white/[0.03] px-3 py-2 text-sm text-zinc-300">
                {item}
              </span>
            ))}
          </div>
        </div>
        <div class="grid gap-3">
          {capabilityGroups.map((group) => (
            <article class="border border-white/10 bg-white/[0.03] p-5">
              <h4 class="text-base font-semibold tracking-tight text-white">{group.title}</h4>
              <div class="mt-4 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="border border-white/10 bg-black/20 px-3 py-1.5 text-xs text-zinc-400">
                    {item}
                  </span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="animate-on-scroll border-t border-white/10 py-14 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Tools</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Practical checks for data platform clarity.
            </h3>
          </div>
          <div class="grid gap-3">
            {tools.map((item) => (
              <a href={item.href} class="border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50">
                <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">{item.label}</p>
                <h4 class="mt-4 text-xl font-semibold tracking-tight text-white">{item.title}</h4>
                <p class="mt-3 text-sm leading-7 text-zinc-400">{item.description}</p>
                <p class="mt-5 text-sm font-medium text-emerald-200">Open checker</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="animate-on-scroll border-t border-white/10 py-14 sm:py-20">
        <div class="mb-8 max-w-3xl">
          <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Selected work themes</p>
          <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            Practical architecture patterns for complex data platform environments.
          </h3>
          <p class="mt-4 text-sm leading-7 text-zinc-400">
            A focused view of the platform problems, engineering decisions, and operating outcomes that shape the work.
          </p>
        </div>
        <div class="stagger-children animate-on-scroll grid gap-4 lg:grid-cols-3">
          {workThemes.map((item) => (
            <article class="flex min-h-[26rem] flex-col border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50 sm:p-6">
              <div class="flex items-start justify-between gap-4">
                <span class="text-sm font-medium text-emerald-200">{item.label}</span>
                <span class="text-right text-[11px] uppercase tracking-[0.16em] text-zinc-500">{item.stack}</span>
              </div>
              <h4 class="mt-8 text-2xl font-semibold tracking-tight text-white">{item.title}</h4>
              <p class="mt-4 text-sm leading-7 text-zinc-400">{item.description}</p>
              <div class="mt-auto pt-6">
                <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Visible outcomes</p>
                <ul class="mt-3 space-y-2">
                  {item.outcomes.map((outcome) => (
                    <li class="border-l border-emerald-300/40 pl-3 text-sm leading-6 text-zinc-300">
                      {outcome}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="proof" class="animate-on-scroll border-t border-white/10 py-14 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Public proof</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Public context for writing, experience, and professional background.
            </h3>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {proofLinks.map((item) => (
              <a href={item.href} target="_blank" rel="noopener noreferrer" class="border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50">
                <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">{item.label}</p>
                <h4 class="mt-4 text-xl font-semibold tracking-tight text-white">{item.title}</h4>
                <p class="mt-3 text-sm leading-7 text-zinc-400">{item.description}</p>
                <p class="mt-5 break-all text-sm font-medium text-emerald-200">{item.display}</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="animate-on-scroll border-t border-white/10 py-14 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Operating principles</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Architecture should make delivery easier to run.
            </h3>
          </div>
          <div class="divide-y divide-white/10 border-y border-white/10">
            {operatingPrinciples.map((item, index) => (
              <div class="grid gap-4 py-5 sm:grid-cols-[4rem_1fr] sm:items-center">
                <span class="text-sm text-emerald-200">0{index + 1}</span>
                <p class="text-xl font-medium tracking-tight text-white">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="writing" class="animate-on-scroll border-t border-white/10 py-14 sm:py-20">
        <div class="mb-8 grid gap-4 md:grid-cols-[1fr_auto] md:items-end">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Writing</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Notes on platforms, governance, and analytics architecture.
            </h3>
          </div>
          <a href="/blog" class="text-sm font-medium text-emerald-200 transition hover:text-white">
            Open writing hub
          </a>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {writingThemes.map((item) => (
            <article class="border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50">
              <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">{item.label}</p>
              <h4 class="mt-4 text-xl font-semibold tracking-tight text-white">{item.title}</h4>
              <p class="mt-3 text-sm leading-7 text-zinc-400">{item.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="contact" class="animate-on-scroll border-t border-white/10 py-14 sm:py-20">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Contact</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Data platform architecture, governance, and thoughtful technical direction.
            </h3>
            <p class="mt-4 text-sm leading-relaxed text-zinc-400">
              Open to architecture consulting, platform advisory, and data governance conversations.
            </p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <a href={`mailto:${profile.email}`} class="group flex items-start gap-4 border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50 hover:bg-white/[0.05]">
              <img src="/images/icon_email.svg" alt="" width="28" height="28" class="mt-0.5 brightness-[0.4] invert transition group-hover:brightness-[0.6] group-hover:invert" />
              <div>
                <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Email</p>
