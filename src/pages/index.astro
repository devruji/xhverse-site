---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { posts as staticFallback } from "../data/blog";
import { createPublicationSnapshot } from "../data/publication";
import PublicationHome from "../components/PublicationHome.astro";
import { createSupabaseClientForBuild, loadPublishedPostsForBuild } from "../lib/blog/load-posts";
import { buildHomeIdentityGraph } from "../lib/seo/structured-data";

const deploymentSite = (Astro.site ?? site.siteUrl).toString();
const blogClient = createSupabaseClientForBuild({
  SUPABASE_URL: import.meta.env.SUPABASE_URL,
  SUPABASE_SECRET_KEY: import.meta.env.SUPABASE_SECRET_KEY,
  PUBLIC_SUPABASE_PUBLISHABLE_KEY: import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY,
});
const publishedPosts = await loadPublishedPostsForBuild(blogClient, staticFallback);
const snapshot = createPublicationSnapshot(publishedPosts);
---
<BaseLayout
  title="Rujikorn Ngoensaard | XHVERSE"
  description="Official xhverse.co portfolio of Rujikorn Ngoensaard, also known as XH and bossruji. Data platform architecture, governance, modeling, operations, writing, and practical tools."
  structuredData={buildHomeIdentityGraph(deploymentSite)} image={site.ogImage}
  lcpImage={snapshot.portrait}
>
  <Header current="/" />
  <PublicationHome snapshot={snapshot} />
  <Footer />
</BaseLayout>
