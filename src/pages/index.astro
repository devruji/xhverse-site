---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
import { site } from "../data/site";

const platformStack = [
  "Azure",
  "Databricks",
  "Microsoft Fabric",
  "Delta Lake",
  "Unity Catalog",
  "Power BI",
];

const focusAreas = [
  {
    title: "Data platform architecture",
    description:
      "Designing clearer platform foundations across lakehouse, warehouse, semantic, and operational layers.",
  },
  {
    title: "Governance and standardization",
    description:
      "Turning fragmented access, naming, ownership, and operating models into maintainable platform rules.",
  },
  {
    title: "Analytics engineering",
    description:
      "Building durable data products, transformation patterns, and reporting foundations that teams can trust.",
  },
  {
    title: "Architecture communication",
    description:
      "Translating technical platform decisions into practical narratives for delivery teams and stakeholders.",
  },
];

const operatingPrinciples = [
  "Clear contracts before clever systems",
  "Governance that operators can actually run",
  "Architecture decisions tied to business context",
  "Platforms designed for maintenance, not only launch",
];

const writingThemes = [
  {
    label: "Platform Notes",
    title: "Modern data platforms in practice",
    description:
      "Notes on Azure, Databricks, Fabric, lakehouse patterns, and the trade-offs behind platform design.",
  },
  {
    label: "Governance",
    title: "From access sprawl to operating clarity",
    description:
      "Practical thinking on permissions, ownership, standardization, and the controls that make data usable.",
  },
  {
    label: "Architecture",
    title: "Decision-ready technical narratives",
    description:
      "How to make complex platform topics easier to understand, compare, and move through delivery.",
  },
];

const metrics = [
  { value: "Azure", label: "Cloud platform" },
  { value: "Databricks", label: "Lakehouse and governance" },
  { value: "Fabric", label: "Analytics ecosystem" },
];

const deploymentSite = (Astro.site ?? site.siteUrl).toString();

const homeStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: "XHVERSE",
  url: deploymentSite,
  description:
    "XHVERSE is a data architecture journal and portfolio by XH, focused on data platforms, governance, analytics architecture, and practical data strategy.",
  mainEntity: {
    "@type": "Person",
    name: profile.name,
    jobTitle: profile.title,
    description: profile.longBio,
    image: new URL(profile.avatar, deploymentSite).toString(),
    email: profile.email,
    sameAs: [site.github, site.medium],
  },
};
---
<BaseLayout
  title="Home"
  description="XHVERSE is a data architecture journal and portfolio focused on modern data platforms, governance, analytics architecture, and practical data strategy."
  structuredData={homeStructuredData}
  lcpImage="/images/xh-profile-960.jpg"
>
  <div class="min-h-screen bg-[#070809] font-[Inter] text-zinc-100 selection:bg-emerald-300/30 selection:text-white">
    <main class="mx-auto max-w-7xl px-5 py-6 sm:px-8 sm:py-8 lg:px-10">
      <header class="flex items-start justify-between gap-5 border-b border-white/10 pb-5 sm:items-center">
        <a href="/" class="group">
          <p class="text-[11px] uppercase tracking-[0.35em] text-zinc-500">xhverse.co</p>
          <h1 class="mt-1 text-[1.35rem] font-semibold tracking-tight text-white sm:text-[1.55rem]">
            XHVERSE
          </h1>
        </a>
        <nav class="hidden items-center gap-6 text-sm text-zinc-400 md:flex" aria-label="Primary navigation">
          <a href="#profile" class="transition hover:text-white">Profile</a>
          <a href="#work" class="transition hover:text-white">Work</a>
          <a href="#writing" class="transition hover:text-white">Writing</a>
          <a href="#contact" class="transition hover:text-white">Contact</a>
        </nav>
        <a
          href="#contact"
          class="border border-white/15 px-3 py-1.5 text-xs uppercase tracking-[0.18em] text-zinc-300 transition hover:border-emerald-300/70 hover:text-white md:hidden"
        >
          Contact
        </a>
      </header>

      <section id="profile" class="grid min-h-[calc(100vh-5rem)] items-center gap-10 py-12 lg:grid-cols-[1.05fr_0.95fr] lg:py-14">
        <div>
          <div class="mb-5 flex flex-wrap gap-2">
            <span class="border border-emerald-300/25 bg-emerald-300/8 px-3 py-1 text-[11px] uppercase tracking-[0.22em] text-emerald-200">
              Data Engineer / Data Architect
            </span>
            <span class="border border-white/10 px-3 py-1 text-[11px] uppercase tracking-[0.22em] text-zinc-400">
              Azure · Databricks · Fabric
            </span>
          </div>
          <h2 class="max-w-4xl text-[2.75rem] font-semibold leading-[0.96] tracking-tight text-white sm:text-[4.6rem] lg:text-[5.4rem]">
            Data platforms, architecture, and practical systems thinking.
          </h2>
          <p class="mt-6 max-w-2xl text-base leading-8 text-zinc-300 sm:text-lg">
            I work across Azure, Databricks, Microsoft Fabric, and enterprise analytics environments to design clearer,
            more scalable, and better-governed data platforms.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#work" class="inline-flex items-center justify-center bg-white px-5 py-3 text-sm font-semibold text-black transition hover:bg-emerald-100">
              View focus areas
            </a>
            <a href="/blog" class="inline-flex items-center justify-center border border-white/15 px-5 py-3 text-sm font-medium text-white transition hover:border-emerald-300/70">
              Read architecture notes
            </a>
          </div>
        </div>

        <aside class="border border-white/10 bg-white/[0.03] p-5 sm:p-6">
          <div class="grid gap-5 sm:grid-cols-[10rem_1fr] sm:items-center lg:grid-cols-1 xl:grid-cols-[10rem_1fr]">
            <img
              src="/images/xh-profile-960.jpg"
              alt="Portrait of XH"
              width="960"
              height="960"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              class="aspect-square w-full max-w-[10rem] object-cover grayscale"
            />
            <div>
              <p class="text-[11px] uppercase tracking-[0.24em] text-zinc-500">Profile</p>
              <h3 class="mt-2 text-2xl font-semibold tracking-tight text-white">{profile.name}</h3>
              <p class="mt-2 text-sm leading-6 text-zinc-300">{profile.bio}</p>
            </div>
          </div>
          <div class="mt-6 grid gap-3 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
            {metrics.map((item) => (
              <div class="border border-white/10 bg-black/20 p-4">
                <p class="text-sm font-semibold text-white">{item.value}</p>
                <p class="mt-1 text-xs leading-5 text-zinc-500">{item.label}</p>
              </div>
            ))}
          </div>
        </aside>
      </section>

      <section id="work" class="border-t border-white/10 py-14 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Work focus</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Clearer data ecosystems for real enterprise teams.
            </h3>
            <p class="mt-4 text-sm leading-7 text-zinc-400">
              The work is technical, but the goal is operational clarity: platforms that teams can govern, extend,
              monitor, and explain with confidence.
            </p>
          </div>
          <div class="grid gap-px overflow-hidden border border-white/10 bg-white/10 sm:grid-cols-2">
            {focusAreas.map((item) => (
              <article class="bg-[#070809] p-5 sm:p-6">
                <h4 class="text-lg font-semibold tracking-tight text-white">{item.title}</h4>
                <p class="mt-3 text-sm leading-7 text-zinc-400">{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="grid gap-8 border-t border-white/10 py-14 sm:py-20 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Platform stack</p>
          <h3 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            Built around the tools that shape modern analytics delivery.
          </h3>
        </div>
        <div class="flex flex-wrap gap-2 self-end">
          {platformStack.map((item) => (
            <span class="border border-white/10 bg-white/[0.03] px-3 py-2 text-sm text-zinc-300">
              {item}
            </span>
          ))}
        </div>
      </section>

      <section class="border-t border-white/10 py-14 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Operating principles</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Architecture should make delivery easier to run.
            </h3>
          </div>
          <div class="divide-y divide-white/10 border-y border-white/10">
            {operatingPrinciples.map((item, index) => (
              <div class="grid gap-4 py-5 sm:grid-cols-[4rem_1fr] sm:items-center">
                <span class="text-sm text-emerald-200">0{index + 1}</span>
                <p class="text-xl font-medium tracking-tight text-white">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="writing" class="border-t border-white/10 py-14 sm:py-20">
        <div class="mb-8 grid gap-4 md:grid-cols-[1fr_auto] md:items-end">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Writing</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Notes on platforms, governance, and analytics architecture.
            </h3>
          </div>
          <a href="/blog" class="text-sm font-medium text-emerald-200 transition hover:text-white">
            Open writing hub
          </a>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {writingThemes.map((item) => (
            <article class="border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50">
              <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">{item.label}</p>
              <h4 class="mt-4 text-xl font-semibold tracking-tight text-white">{item.title}</h4>
              <p class="mt-3 text-sm leading-7 text-zinc-400">{item.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="contact" class="border-t border-white/10 py-14 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div>
            <p class="text-[12px] uppercase tracking-[0.32em] text-zinc-500">Contact</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Data platform architecture, governance, and thoughtful technical direction.
            </h3>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <a href={`mailto:${profile.email}`} class="border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50">
              <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Email</p>
              <p class="mt-3 break-all text-lg font-semibold text-white">{profile.email}</p>
            </a>
            <a href="https://www.linkedin.com/in/rujikorn/" target="_blank" rel="noopener noreferrer" class="border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50">
              <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">LinkedIn</p>
              <p class="mt-3 break-all text-lg font-semibold text-white">linkedin.com/in/rujikorn</p>
            </a>
            <a href={site.github} target="_blank" rel="noopener noreferrer" class="border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50">
              <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">GitHub</p>
              <p class="mt-3 break-all text-lg font-semibold text-white">github.com/devruji</p>
            </a>
            <a href={site.medium} target="_blank" rel="noopener noreferrer" class="border border-white/10 bg-white/[0.03] p-5 transition hover:border-emerald-300/50">
              <p class="text-[11px] uppercase tracking-[0.22em] text-zinc-500">Medium</p>
              <p class="mt-3 break-all text-lg font-semibold text-white">medium.xhverse.co</p>
            </a>
          </div>
        </div>
      </section>

      <footer class="flex flex-col gap-4 border-t border-white/10 py-6 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between">
        <p>xhverse.co · Data architecture journal by XH</p>
        <p>Azure · Databricks · Microsoft Fabric</p>
      </footer>
    </main>
  </div>
</BaseLayout>
