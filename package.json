{
  "name": "xhverse",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "bun run scripts/generate-headers.ts && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "bun run build && bun run test:e2e:built",
    "test:e2e:built": "playwright test",
    "test:delivery": "bun test scripts/ci/*.test.ts",
    "validate:surfaces": "bun scripts/ci/validate-surfaces.ts",
    "check": "bun run typecheck && bun run build && bun run coverage && bun run test:delivery && bun run test:e2e:built"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.4.1",
    "marked": "^18.1.1",
    "sanitize-html": "2.18.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "5.0.5",
    "supabase": "2.121.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "devalue": "5.9.4",
    "esbuild": "^0.28.1",
    "fast-uri": "3.1.8",
    "http-cache-semantics": "4.3.0",
    "picomatch": "^4.0.7",
    "postcss": "8.5.29",
    "smol-toml": "1.9.0",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.19",
    "source-map-js": "1.2.2",
    "svgo": "4.1.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.1"
  }
}
