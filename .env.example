# Optional: load published posts from Supabase at build time (see supabase/migrations/).
# If unset, the site uses static data from src/data/blog.ts.
# Use the project URL and secret (service role) key from Supabase Dashboard → API.
# Never expose the secret key in client-side code; these are read only during `astro build`.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: public CV PDF URL from Supabase Storage.
# Expected format:
# https://<project-ref>.supabase.co/storage/v1/object/public/documents/cv/rujikorn-ngoensaard-cv.pdf
# If unset, /cv uses the local PDF in public/documents/.
PUBLIC_CV_PDF_URL=
