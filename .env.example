# Supabase project URL (used for CSP headers and default storage URLs).
# If unset, defaults to the production xhverse Supabase project.
PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key for client-side access (maturity tool).
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase credentials for build-time blog post fetching (service role, never client-side).
# If unset, the site uses static data from src/data/blog.ts.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: override the public CV PDF URL.
# If unset, /cv constructs the URL from PUBLIC_SUPABASE_URL + the storage path.
PUBLIC_CV_PDF_URL=
